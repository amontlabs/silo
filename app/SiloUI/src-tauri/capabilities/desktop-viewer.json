{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-viewer",
  "description": "Only the local desktop shell can manage its assigned desktop. Guest child webviews receive no capabilities.",
  "windows": [],
  "webviews": [
    "desktop-shell-*"
  ],
  "permissions": [
    "allow-read-desktop-state",
    "allow-desktop-action",
    "allow-desktop-viewer-attach",
    "allow-desktop-viewer-detach",
    "allow-desktop-viewer-sound-support",
    "allow-desktop-viewer-set-audio",
    "allow-desktop-viewer-reset-screen",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:resources:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-fullscreen"
  ]
}
