{
  "deployment_profile": "single_tenant",
  "env": [
    {
      "key": "PATH",
      "value": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    },
    {
      "key": "GH_TOKEN",
      "value": "$MSB_SILO_GITHUB"
    }
  ],
  "external_mount_policy": "strict",
  "image": {
    "Oci": {
      "reference": "ghcr.io/0xpolarzero/silo-guest:ubuntu-24.04-v3-arm64",
      "root_disk": {
        "kind": "managed",
        "size_mib": 4096
      }
    }
  },
  "init": null,
  "labels": {
    "org.opencontainers.image.description": "Ubuntu 24.04 with Silo's Git integration and offline working-account tools. No credentials.",
    "org.opencontainers.image.revision": "a9827c263df3daee28959b2c2073d85c6f980e9d",
    "org.opencontainers.image.source": "https://github.com/0xpolarzero/silo",
    "org.opencontainers.image.title": "Silo Ubuntu guest",
    "org.opencontainers.image.version": "ubuntu-24.04-v3",
    "silo.github-protocol": "1",
    "silo.machine-id": "e2e-new-silo",
    "silo.managed": "true",
    "silo.runtime-storage-gib": "4",
    "silo.workspace-storage-gib": "1"
  },
  "lifecycle": {
    "ephemeral": false,
    "idle_timeout_secs": null,
    "max_duration_secs": null
  },
  "manifest_digest": "sha256:f7b74b5918448144abb495cbb54f6ff38070785259c1b37a1f75b95f5acbd84e",
  "mounts": [
    {
      "guest": "/workspace",
      "host_permissions": "private",
      "options": {
        "nodev": false,
        "noexec": false,
        "nosuid": false,
        "readonly": false
      },
      "stat_virtualization": "strict",
      "storage": {
        "capacity_mib": 1024,
        "kind": "disk"
      },
      "type": "Owned"
    }
  ],
  "name": "e2e-new-silo",
  "network": {
    "dns": {
      "nameservers": [],
      "query_timeout_ms": 5000,
      "rebind_protection": true
    },
    "enabled": true,
    "interface": {},
    "max_connections": null,
    "policy": {
      "default_egress": "deny",
      "default_ingress": "allow",
      "rules": [
        {
          "action": "allow",
          "destination": {
            "group": "host"
          },
          "direction": "egress",
          "ports": [
            {
              "end": 53,
              "start": 53
            }
          ],
          "protocols": [
            "udp",
            "tcp"
          ]
        },
        {
          "action": "allow",
          "destination": {
            "group": "public"
          },
          "direction": "egress",
          "ports": [],
          "protocols": []
        }
      ]
    },
    "ports": [],
    "secrets": {
      "secrets": [
        {
          "allowed_hosts": [
            {
              "exact": "github.com"
            },
            {
              "exact": "api.github.com"
            },
            {
              "exact": "uploads.github.com"
            }
          ],
          "env_var": "SILO_GITHUB",
          "passthrough_hosts": [
            "any"
          ],
          "placeholder": "$MSB_SILO_GITHUB",
          "require_tls_identity": true,
          "source": {
            "kind": "env",
            "var": "SILO_GITHUB"
          },
          "substitution": {
            "body": false,
            "headers": true,
            "query": false
          },
          "value": ""
        }
      ],
      "violation_action": "block-and-log"
    },
    "strict": true,
    "tls": {
      "block_quic_on_intercept": true,
      "bypass": [],
      "cache": {
        "capacity": 1000,
        "validity_hours": 24
      },
      "enabled": true,
      "intercept_ca": {
        "cert_path": null,
        "key_path": null
      },
      "intercepted_ports": [
        443
      ],
      "scoped_upstream_ca_cert": [],
      "scoped_verify_upstream": [],
      "upstream_ca_cert": [],
      "verify_upstream": true
    },
    "trust_host_cas": false
  },
  "patches": [],
  "pull_policy": "Never",
  "resources": {
    "cpus": 1,
    "max_cpus": 1,
    "max_memory_mib": 1024,
    "memory_mib": 1024
  },
  "rlimits": [],
  "runtime": {
    "cmd": [
      "/bin/bash"
    ],
    "disable_metrics_sample": false,
    "entrypoint": null,
    "hostname": null,
    "log_level": null,
    "metrics_sample_interval_ms": 1000,
    "scripts": {},
    "shell": "/bin/sh",
    "user": null,
    "workdir": null
  },
  "security_profile": "default"
}
