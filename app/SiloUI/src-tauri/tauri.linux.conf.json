{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "resources": {
      "runtime/git/ssl/": "git-support/ssl/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.34)",
          "libcurl4 | libcurl4t64",
          "libcap-ng0",
          "zlib1g",
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-base",
          "openssh-client"
        ]
      },
      "rpm": {
        "depends": [
          "glibc",
          "libcurl",
          "libcap-ng",
          "zlib",
          "gstreamer1-plugins-base",
          "openssh-clients"
        ]
      }
    }
  }
}
