{
  "name": "silo-ui",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "version": "0.13.0",
  "description": "Desktop app for local and remote Linux guest computers on macOS.",
  "license": "MIT",
  "homepage": "https://silo.amontlabs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amontlabs/silo.git",
    "directory": "app/SiloUI"
  },
  "bugs": {
    "url": "https://github.com/amontlabs/silo/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preflight": "node scripts/preflight.mjs",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run runtime:prepare && npm run build",
    "runtime:prepare": "node scripts/prepare-microsandbox-runtime.mjs",
    "runtime:verify:git": "node scripts/verify-git-runtime.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "python3 scripts/build_desktop.py",
    "desktop:build:debug": "python3 scripts/build_desktop.py --debug --bundles app",
    "desktop:build:dev-release": "python3 scripts/build_desktop.py --dev-release --bundles app",
    "guest:image:build": "node scripts/build-guest-image.mjs",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "node scripts/sync-release.mjs version",
    "release:sync": "node scripts/sync-release.mjs",
    "release:draft": "node scripts/release.mjs draft",
    "release:publish": "node scripts/release.mjs publish",
    "test:release": "node --test \"scripts/**/*.test.mjs\"",
    "dev:import-production-settings": "node scripts/import-production-settings.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
