#!/usr/bin/python3 -I
"""Root-owned pkexec target. Only upgrade the installed Silo package via signed APT."""
import fcntl
import json
import os
from pathlib import Path
import re
import select
import stat
import subprocess
import sys
import time

SOURCE = Path('/etc/apt/sources.list.d/silo.sources')
DIRECTORY = Path('/run/silo')
MARKER = DIRECTORY / 'system-update.json'
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C', 'DEBIAN_FRONTEND': 'noninteractive'}
# Silo stops its computers after 'ready'; stopping many can take a while.
CONFIRM_TIMEOUT = 30 * 60


def version(value):
    if len(value) > 64 or not re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', value):
        raise ValueError('Invalid Silo update version.')
    return value


def start_time(pid):
    # The comm field can contain spaces and parentheses; field 22 follows it.
    return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19]


def parent_pid(pid):
    # Field 4 follows the comm field, which can contain spaces and parentheses.
    return int(Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[1])


def requested_by(pid, helper=None, parent=parent_pid, executable=os.readlink):
    """Whether pkexec, this helper's parent, was started by the process named by pid."""
    helper = os.getpid() if helper is None else helper
    pkexec = parent(helper)
    return executable(f'/proc/{pkexec}/exe') == '/usr/bin/pkexec' and parent(pkexec) == pid


def root_private_file(path):
    info = path.lstat()
    return stat.S_ISREG(info.st_mode) and info.st_uid == 0 and info.st_mode & 0o077 == 0


def allows_running(pid):
    try:
        if not root_private_file(MARKER):
            return False
        permit = json.loads(MARKER.read_text())
        return (permit['app'] == [pid, start_time(pid)]
                and permit['helper'][1] == start_time(permit['helper'][0]))
    except (OSError, ValueError, KeyError, TypeError, IndexError):
        return False


def run(args):
    # Root execution never inherits PATH, APT_CONFIG, Python imports, or a shell.
    result = subprocess.run(args, env=ENV, stdin=subprocess.DEVNULL, stdout=sys.stderr, stderr=sys.stderr)
    if result.returncode:
        raise RuntimeError('The system package manager could not finish. Check the details for a network, package lock, or package repair error, then retry.')


def stage(name):
    print(name, flush=True)


def confirm(stream=None, timeout=CONFIRM_TIMEOUT):
    """Wait for Silo's go-ahead. It stops computers only once everything before installation succeeded."""
    stream = sys.stdin if stream is None else stream
    deadline = time.monotonic() + timeout
    line = b''
    while len(line) <= 64:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        readable, _, _ = select.select([stream], [], [], remaining)
        if not readable:
            break
        chunk = os.read(stream.fileno(), 65 - len(line))
        line += chunk
        if b'\n' in line or not chunk:
            if line.split(b'\n', 1)[0].strip() == b'install' and time.monotonic() <= deadline:
                return
            break
    raise RuntimeError('Silo cancelled the update before installation. Nothing was installed.')


def upgrade(selected, run=run, stage=stage, confirm=confirm):
    version(selected)
    if not SOURCE.is_file() or re.search(r'^Enabled:\s*no\s*$', SOURCE.read_text(), re.M | re.I):
        raise RuntimeError('Enable Silo’s software source in Software & Updates, then retry.')
    stage('refreshing')
    run(['/usr/bin/apt-get', '-o', f'Dir::Etc::sourcelist={SOURCE}', '-o', 'Dir::Etc::sourceparts=-',
         '-o', 'APT::Get::List-Cleanup=0', '-o', 'APT::Update::Error-Mode=any',
         '-o', 'Acquire::Retries=2', '-o', 'Acquire::http::Timeout=30', '-o', 'Acquire::https::Timeout=30', 'update'])
    common = ['/usr/bin/apt-get', '-y', '--only-upgrade', '--no-remove',
              '-o', 'DPkg::Lock::Timeout=60', '-o', 'Dpkg::Options::=--force-confdef',
              '-o', 'Dpkg::Options::=--force-confold', '-o', 'Acquire::Retries=2',
              '-o', 'Acquire::http::Timeout=30', '-o', 'Acquire::https::Timeout=30']
    stage('downloading')
    run([*common, '--download-only', 'install', f'silo={selected}'])
    stage('ready')
    confirm()
    stage('installing')
    run([*common, '--no-download', 'install', f'silo={selected}'])


def main():
    if os.geteuid() != 0:
        raise RuntimeError('Administrator authentication is required.')
    if len(sys.argv) == 3 and sys.argv[1] == '--allows-running':
        return 0 if allows_running(int(sys.argv[2])) else 1
    if len(sys.argv) != 3:
        raise ValueError('Expected the Silo process and update version.')
    pid, selected = int(sys.argv[1]), version(sys.argv[2])
    uid = int(os.environ.get('PKEXEC_UID', '-1'))
    process = Path(f'/proc/{pid}')
    if uid <= 0 or process.stat().st_uid != uid or os.readlink(process / 'exe') not in ('/usr/bin/silo-ui', '/usr/bin/silo-ui (deleted)'):
        raise RuntimeError('The update must be requested by the installed Silo application.')
    if not requested_by(pid):
        raise RuntimeError('The update must be requested by the installed Silo application.')
    identity = [pid, start_time(pid)]
    DIRECTORY.mkdir(mode=0o755, exist_ok=True)
    info = DIRECTORY.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('The system update directory has unsafe permissions.')
    descriptor = os.open(DIRECTORY / 'system-update.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Another Silo update is already running.')
        current = subprocess.check_output(['/usr/bin/dpkg-query', '-W', '-f=${Status}\n${Version}', 'silo'], env=ENV, text=True).splitlines()
        if len(current) != 2 or current[0] != 'install ok installed':
            raise RuntimeError('Silo’s package needs repair in the system package manager before updating.')
        if current[1] == selected:
            # Package already updated; the old running app only needs to stop its
            # computers (so they resume on the new runtime) and restart.
            stage('ready')
            confirm()
            return 0
        if subprocess.run(['/usr/bin/dpkg', '--compare-versions', selected, 'gt', current[1]], env=ENV).returncode:
            raise RuntimeError('Refusing to downgrade Silo. Check for updates again.')
        MARKER.unlink(missing_ok=True)
        descriptor = os.open(MARKER, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(descriptor, 'w') as output:
                json.dump({'app': identity, 'helper': [os.getpid(), start_time(os.getpid())]}, output)
            upgrade(selected)
            installed = subprocess.check_output(['/usr/bin/dpkg-query', '-W', '-f=${Status}\n${Version}', 'silo'], env=ENV, text=True)
            if installed != f'install ok installed\n{selected}':
                raise RuntimeError('The selected Silo version was not installed. Check for updates and retry.')
        finally:
            MARKER.unlink(missing_ok=True)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
