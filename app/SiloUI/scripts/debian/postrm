#!/bin/sh
set -eu
case "$1" in remove|purge)
    rm -f /var/lib/silo/apt-source-configured
    # Our exact source is recognizable even after package-owned files are gone.
    # Earlier releases shipped the same file with the previous repository URI.
    if [ -f /etc/apt/sources.list.d/silo.sources ] && {
       cmp -s /etc/apt/sources.list.d/silo.sources - <<'SILO_SOURCE'
# Managed by the Silo installer
Types: deb
URIs: https://apt.silo.amontlabs.com/apt
Suites: stable
Components: main
Architectures: amd64 arm64
Signed-By: /usr/share/keyrings/silo-archive-keyring.gpg
SILO_SOURCE
       } || {
       cmp -s /etc/apt/sources.list.d/silo.sources - <<'SILO_PREVIOUS_SOURCE'
# Managed by the Silo installer
Types: deb
URIs: https://0xpolarzero.github.io/silo/apt
Suites: stable
Components: main
Architectures: amd64 arm64
Signed-By: /usr/share/keyrings/silo-archive-keyring.gpg
SILO_PREVIOUS_SOURCE
       }
    then
        rm -f /etc/apt/sources.list.d/silo.sources
    fi
    ;;
esac
case "$1" in remove|purge|abort-install|abort-upgrade|disappear)
    rm -f /var/lib/silo/package-update-in-progress
    ;;
esac
if [ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
    db_purge
fi
