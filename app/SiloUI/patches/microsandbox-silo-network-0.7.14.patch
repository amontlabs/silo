+#[cfg(test)]
+mod resolver_tests {
+    use super::*;
+    #[derive(Default)]
+    struct MockApi {
+        calls: std::sync::Mutex<Vec<(String, String, serde_json::Value)>>,
+        fail: bool,
+    }
+    impl RoutingApi for MockApi {
+        fn query<'a>(
+            &'a self,
+            token: &'a str,
+            query: &'a str,
+            variables: serde_json::Value,
+        ) -> ProbeFuture<'a> {
+            Box::pin(async move {
+                self.calls
+                    .lock()
+                    .unwrap()
+                    .push((token.into(), query.into(), variables.clone()));
+                if self.fail {
+                    return Err(ViolationAction::Block);
+                }
+                if query.contains("__type") {
+                    assert_eq!(variables["name"], "AddCommentInput");
+                    return Ok(
+                        serde_json::json!({"data":{"__type":{"kind":"INPUT_OBJECT","name":"AddCommentInput","inputFields":[{"name":"subjectId","type":{"kind":"NON_NULL","ofType":{"kind":"SCALAR","name":"ID"}}},{"name":"body","type":{"kind":"SCALAR","name":"String"}}]}}}),
+                    );
+                }
+                assert!(query.starts_with("query SiloRoutingNodes"));
+                assert_eq!(variables["ids"], serde_json::json!(["issue_b"]));
+                Ok(if token == "read_b" {
+                    serde_json::json!({"data":{"nodes":[{"id":"issue_b","repository":{"owner":{"login":"bob"}}}]}})
+                } else {
+                    serde_json::json!({"data":{"nodes":[null]},"errors":[{"type":"NOT_FOUND"}]})
+                })
+            })
+        }
+    }
+    fn profile() -> String {
+        serde_json::json!({"version":1,"owners":[{"login":"alice","readToken":"read_a","writeToken":"write_a","expiresAt":4102444800u64},{"login":"bob","readToken":"read_b","writeToken":"write_b","expiresAt":4102444800u64}]}).to_string()
+    }
+    const BODY:&[u8]=br#"{"query":"mutation Add($input:AddCommentInput!){addComment(input:$input){clientMutationId}}","variables":{"input":{"subjectId":"issue_b","body":"This is ordinary text, not an ID"}}}"#;
+    #[tokio::test]
+    async fn node_only_mutation_routes_by_schema_ids_using_read_tokens_only() {
+        let api = MockApi::default();
+        assert_eq!(
+            resolve_owner_with(&api, &profile(), BODY).await.unwrap(),
+            "bob"
+        );
+        let calls = api.calls.lock().unwrap();
+        assert_eq!(calls.len(), 3);
+        assert!(
+            calls
+                .iter()
+                .all(|(token, query, _)| token.starts_with("read_") && query.starts_with("query "))
+        );
+        assert!(
+            calls
+                .iter()
+                .all(|(_, query, _)| !query.contains("addComment"))
+        );
+        assert_eq!(
+            select_with_owner(
+                &profile(),
+                "api.github.com",
+                "POST /graphql HTTP/1.1\r\n",
+                BODY,
+                Some("bob")
+            )
+            .unwrap(),
+            "write_b"
+        );
+    }
+    #[tokio::test]
+    async fn failed_lookup_never_selects_or_replays_a_mutation() {
+        let api = MockApi {
+            fail: true,
+            ..Default::default()
+        };
+        assert!(resolve_owner_with(&api, &profile(), BODY).await.is_err());
+        let calls = api.calls.lock().unwrap();
+        assert_eq!(calls.len(), 1);
+        assert!(calls[0].1.starts_with("query "));
+    }
+    #[tokio::test]
+    async fn missing_operation_is_rejected_without_network() {
+        let api = MockApi::default();
+        let body = br#"{"query":"query A{viewer{login}}","operationName":"Missing"}"#;
+        assert!(resolve_owner_with(&api, &profile(), body).await.is_err());
+        assert!(api.calls.lock().unwrap().is_empty());
+    }
+    struct AdversarialApi {
+        mode: &'static str,
+    }
+    impl RoutingApi for AdversarialApi {
+        fn query<'a>(
+            &'a self,
+            token: &'a str,
+            query: &'a str,
+            variables: serde_json::Value,
+        ) -> ProbeFuture<'a> {
+            Box::pin(async move {
+                assert!(query.starts_with("query SiloRoutingNodes"));
+                assert_eq!(variables, serde_json::json!({"ids":["issue_b"]}));
+                Ok(match (self.mode, token) {
+                    ("ambiguous", "read_a") => {
+                        serde_json::json!({"data":{"nodes":[{"id":"issue_b","repository":{"owner":{"login":"alice"}}}]}})
+                    }
+                    ("ambiguous", "read_b") => {
+                        serde_json::json!({"data":{"nodes":[{"id":"issue_b","repository":{"owner":{"login":"bob"}}}]}})
+                    }
+                    ("error", "read_a") => {
+                        serde_json::json!({"data":{"nodes":[{"id":"issue_b","repository":{"owner":{"login":"alice"}}}]},"errors":[{"message":"partial"}]})
+                    }
+                    ("malformed", "read_a") => {
+                        serde_json::json!({"data":{"nodes":{"id":"issue_b"}}})
+                    }
+                    (_, _) => {
+                        serde_json::json!({"data":{"nodes":[null]},"errors":[{"type":"NOT_FOUND"}]})
+                    }
+                })
+            })
+        }
+    }
+    #[tokio::test]
+    async fn ambiguous_malformed_and_partial_error_responses_fail_closed() {
+        let body = br#"{"query":"mutation M($id: ID!) { deleteIssue(input: $id) { clientMutationId } }","variables":{"id":"issue_b"}}"#;
+        for mode in ["ambiguous", "malformed", "error"] {
+            let api = AdversarialApi { mode };
+            assert!(
+                resolve_owner_with(&api, &profile(), body).await.is_err(),
+                "{mode}"
+            );
+        }
+    }
+}
