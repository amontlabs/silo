new file mode 100644
index 0000000000000000000000000000000000000000..1f05bf366dacdb0650745245b253ded25db553a5
--- /dev/null
+++ b/crates/network/lib/engine/secrets/github.rs
@@ -0,0 +1,1046 @@
+//! Credential selection only. GitHub-issued tokens enforce repository authority.
+//! Never split, replay, or authorize GraphQL fields here.
+use crate::secrets::config::SecretViolationAction as ViolationAction;
+use graphql_parser::query::{Definition, OperationDefinition, parse_query};
+use serde::Deserialize;
+use zeroize::Zeroize;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Profile {
+    version: u8,
+    owners: Vec<Owner>,
+    #[serde(default)]
+    personal_token: Option<String>,
+}
+impl Drop for Profile {
+    fn drop(&mut self) {
+        self.personal_token.zeroize();
+    }
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Owner {
+    login: String,
+    #[serde(default)]
+    repository_ids: Vec<u64>,
+    read_token: String,
+    write_token: Option<String>,
+    expires_at: u64,
+}
+
+impl Drop for Owner {
+    fn drop(&mut self) {
+        self.read_token.zeroize();
+        self.write_token.zeroize();
+    }
+}
+
+fn valid_profile(profile: &Profile) -> bool {
+    let mut owners = std::collections::HashSet::new();
+    profile.version == 1
+        && !profile.owners.is_empty()
+        && profile.owners.len() <= 100
+        && profile.owners.iter().all(|owner| {
+            owner.repository_ids.len() <= 50_000
+                && !owner.login.is_empty()
+                && owner.login.len() <= 100
+                && owner
+                    .login
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+                && owners.insert(owner.login.to_ascii_lowercase())
+        })
+}
+
+pub(super) fn needs_body(headers: &str) -> bool {
+    let path = headers
+        .lines()
+        .next()
+        .and_then(|l| l.split_whitespace().nth(1))
+        .unwrap_or("");
+    path.split('?').next() == Some("/graphql") || path.ends_with("/info/lfs/objects/batch")
+}
+
+#[cfg(test)]
+pub(super) fn select(
+    profile: &str,
+    sni: &str,
+    headers: &str,
+    body: &[u8],
+) -> Result<String, ViolationAction> {
+    select_with_owner(profile, sni, headers, body, None)
+}
+pub(super) fn select_with_owner(
+    profile: &str,
+    sni: &str,
+    headers: &str,
+    body: &[u8],
+    owner_override: Option<&str>,
+) -> Result<String, ViolationAction> {
+    let deny = || ViolationAction::Block;
+    let profile: Profile = serde_json::from_str(profile).map_err(|_| deny())?;
+    if profile.version == 2 {
+        if !profile.owners.is_empty()
+            || !matches!(sni, "github.com" | "api.github.com" | "uploads.github.com")
+        {
+            return Err(deny());
+        }
+        let token = profile.personal_token.as_ref().ok_or_else(deny)?;
+        if token.is_empty()
+            || token.len() > 4096
+            || !token
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_')
+        {
+            return Err(deny());
+        }
+        return Ok(token.clone());
+    }
+    if profile.personal_token.is_some() {
+        return Err(deny());
+    }
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|_| deny())?
+        .as_secs();
+    if !valid_profile(&profile) {
+        return Err(deny());
+    }
+    let mut request = headers.lines().next().ok_or_else(deny)?.split_whitespace();
+    let method = request.next().ok_or_else(deny)?;
+    let target = request.next().ok_or_else(deny)?;
+    if !target.starts_with('/') || target.starts_with("//") {
+        return Err(deny());
+    }
+    let path = target.split('?').next().ok_or_else(deny)?;
+    let segments: Vec<_> = path.split('/').filter(|v| !v.is_empty()).collect();
+    let mut owner_name = None;
+    let mut write = !matches!(method, "GET" | "HEAD" | "OPTIONS");
+    match sni {
+        "api.github.com" | "uploads.github.com" => {
+            if segments.first() == Some(&"repos") || segments.first() == Some(&"orgs") {
+                owner_name = segments.get(1).copied();
+            } else if segments.first() == Some(&"repositories") && segments.len() > 1 {
+                let id = segments[1].parse::<u64>().map_err(|_| deny())?;
+                let matching: Vec<_> = profile
+                    .owners
+                    .iter()
+                    .filter(|owner| owner.repository_ids.contains(&id))
+                    .collect();
+                if matching.len() != 1 {
+                    return Err(deny());
+                }
+                owner_name = Some(&matching[0].login);
+            }
+        }
+        "github.com" => {
+            owner_name = segments.first().copied();
+            if target.ends_with("?service=git-receive-pack") {
+                write = true;
+            }
+            if path.ends_with("/git-upload-pack") || target.ends_with("?service=git-upload-pack") {
+                write = false;
+            }
+        }
+        _ => return Err(deny()),
+    }
+    let json = if needs_body(headers) {
+        Some(serde_json::from_slice::<serde_json::Value>(body).map_err(|_| deny())?)
+    } else {
+        None
+    };
+    if path == "/graphql" {
+        if sni != "api.github.com" || method != "POST" {
+            return Err(deny());
+        }
+        let json = json.as_ref().ok_or_else(deny)?;
+        let query = json
+            .get("query")
+            .and_then(|v| v.as_str())
+            .ok_or_else(deny)?;
+        let document = parse_query::<String>(query).map_err(|_| deny())?;
+        let selected_name = json.get("operationName").and_then(|v| v.as_str());
+        let operations: Vec<_> = document
+            .definitions
+            .iter()
+            .filter_map(|definition| {
+                let Definition::Operation(op) = definition else {
+                    return None;
+                };
+                let name = match op {
+                    OperationDefinition::SelectionSet(_) => None,
+                    OperationDefinition::Query(q) => q.name.as_deref(),
+                    OperationDefinition::Mutation(m) => m.name.as_deref(),
+                    OperationDefinition::Subscription(s) => s.name.as_deref(),
+                };
+                if selected_name.is_none() || name == selected_name {
+                    Some(op)
+                } else {
+                    None
+                }
+            })
+            .collect();
+        if operations.len() != 1 {
+            return Err(deny());
+        }
+        write = match operations[0] {
+            OperationDefinition::Mutation(_) => true,
+            OperationDefinition::SelectionSet(_) | OperationDefinition::Query(_) => false,
+            OperationDefinition::Subscription(_) => return Err(deny()),
+        };
+        owner_name = json
+            .pointer("/variables/owner")
+            .and_then(|v| v.as_str())
+            .or(owner_override);
+    } else if path.ends_with("/info/lfs/objects/batch") {
+        write = match json
+            .as_ref()
+            .and_then(|v| v.get("operation"))
+            .and_then(|v| v.as_str())
+        {
+            Some("download") => false,
+            Some("upload") => true,
+            _ => return Err(deny()),
+        };
+    }
+    let owner = if let Some(name) = owner_name {
+        let matches: Vec<_> = profile
+            .owners
+            .iter()
+            .filter(|o| o.login.eq_ignore_ascii_case(name))
+            .collect();
+        if matches.len() != 1 {
+            return Err(deny());
+        }
+        matches[0]
+    } else if profile.owners.len() == 1 {
+        &profile.owners[0]
+    } else if !write {
+        profile
+            .owners
+            .iter()
+            .min_by_key(|owner| owner.login.to_ascii_lowercase())
+            .ok_or_else(deny)?
+    } else {
+        return Err(deny());
+    };
+    if owner.expires_at <= now + 5 {
+        return Err(deny());
+    }
+    let token = if write {
+        owner.write_token.as_ref().ok_or_else(deny)?
+    } else {
+        &owner.read_token
+    };
+    if token.is_empty()
+        || token.len() > 4096
+        || !token
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'_')
+    {
+        return Err(deny());
+    }
+    Ok(token.clone())
+}
+
+const MAX_ROUTING_IDS: usize = 64;
+const MAX_TYPE_LOOKUPS: usize = 32;
+const MAX_ROUTING_RESPONSE: usize = 2 * 1024 * 1024;
+
+type ProbeFuture<'a> = std::pin::Pin<
+    Box<dyn std::future::Future<Output = Result<serde_json::Value, ViolationAction>> + Send + 'a>,
+>;
+trait RoutingApi {
+    fn query<'a>(
+        &'a self,
+        token: &'a str,
+        query: &'a str,
+        variables: serde_json::Value,
+    ) -> ProbeFuture<'a>;
+}
+impl RoutingApi for reqwest::Client {
+    fn query<'a>(
+        &'a self,
+        token: &'a str,
+        query: &'a str,
+        variables: serde_json::Value,
+    ) -> ProbeFuture<'a> {
+        Box::pin(read_probe(self, token, query, variables))
+    }
+}
+
+async fn read_probe(
+    client: &reqwest::Client,
+    token: &str,
+    query: &str,
+    variables: serde_json::Value,
+) -> Result<serde_json::Value, ViolationAction> {
+    let mut response = client
+        .post("https://api.github.com/graphql")
+        .bearer_auth(token)
+        .json(&serde_json::json!({"query":query,"variables":variables}))
+        .send()
+        .await
+        .map_err(|_| ViolationAction::Block)?;
+    if !response.status().is_success() {
+        return Err(ViolationAction::Block);
+    }
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| ViolationAction::Block)? {
+        if bytes.len() + chunk.len() > MAX_ROUTING_RESPONSE {
+            return Err(ViolationAction::Block);
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    serde_json::from_slice(&bytes).map_err(|_| ViolationAction::Block)
+}
+
+fn input_value(
+    value: &graphql_parser::query::Value<'_, String>,
+    variables: &serde_json::Value,
+) -> Result<serde_json::Value, ViolationAction> {
+    use graphql_parser::query::Value as V;
+    Ok(match value {
+        V::Variable(name) => variables.get(name).cloned().ok_or(ViolationAction::Block)?,
+        V::String(s) | V::Enum(s) => serde_json::json!(s),
+        V::Int(n) => serde_json::json!(n.as_i64()),
+        V::Float(n) => serde_json::json!(n),
+        V::Boolean(b) => serde_json::json!(b),
+        V::Null => serde_json::Value::Null,
+        V::List(values) => serde_json::Value::Array(
+            values
+                .iter()
+                .map(|v| input_value(v, variables))
+                .collect::<Result<_, _>>()?,
+        ),
+        V::Object(values) => serde_json::Value::Object(
+            values
+                .iter()
+                .map(|(k, v)| Ok((k.clone(), input_value(v, variables)?)))
+                .collect::<Result<_, ViolationAction>>()?,
+        ),
+    })
+}
+fn variable_type(value: &graphql_parser::query::Type<'_, String>) -> serde_json::Value {
+    use graphql_parser::query::Type as T;
+    match value {
+        T::NamedType(name) => serde_json::json!({"kind":"NAMED","name":name}),
+        T::NonNullType(inner) => {
+            serde_json::json!({"kind":"NON_NULL","ofType":variable_type(inner)})
+        }
+        T::ListType(inner) => serde_json::json!({"kind":"LIST","ofType":variable_type(inner)}),
+    }
+}
+
+async fn schema_type(
+    client: &impl RoutingApi,
+    token: &str,
+    name: &str,
+    cache: &mut std::collections::HashMap<String, serde_json::Value>,
+    root: bool,
+) -> Result<serde_json::Value, ViolationAction> {
+    if let Some(value) = cache.get(name) {
+        return Ok(value.clone());
+    }
+    if cache.len() >= MAX_TYPE_LOOKUPS {
+        return Err(ViolationAction::Block);
+    }
+    // Introspection identifies actual ID inputs, not guessed field/command names.
+    let mut reference = "kind name".to_string();
+    for _ in 0..8 {
+        reference = format!("kind name ofType {{ {reference} }}")
+    }
+    let fields = if root {
+        format!("fields {{ name args {{ name type {{ {reference} }} }} }}")
+    } else {
+        format!("inputFields {{ name type {{ {reference} }} }}")
+    };
+    let query = format!(
+        "query SiloRoutingType($name:String!) {{ __type(name:$name) {{ kind name {fields} }} }}"
+    );
+    let response = client
+        .query(token, &query, serde_json::json!({"name":name}))
+        .await?;
+    if response.get("errors").is_some() {
+        return Err(ViolationAction::Block);
+    }
+    let value = response
+        .pointer("/data/__type")
+        .filter(|v| v.is_object())
+        .ok_or(ViolationAction::Block)?
+        .clone();
+    cache.insert(name.into(), value.clone());
+    Ok(value)
+}
