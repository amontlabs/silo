+/// Fixed, read-only GitHub probes. The caller forwards the original request once after resolution.
+pub(super) async fn resolve_owner(profile: &str, body: &[u8]) -> Result<String, ViolationAction> {
+    tokio::time::timeout(
+        std::time::Duration::from_secs(20),
+        resolve_owner_inner(profile, body),
+    )
+    .await
+    .map_err(|_| ViolationAction::Block)?
+}
+async fn resolve_owner_inner(profile: &str, body: &[u8]) -> Result<String, ViolationAction> {
+    let client = reqwest::Client::builder()
+        .timeout(std::time::Duration::from_secs(10))
+        .redirect(reqwest::redirect::Policy::none())
+        .user_agent("Silo GitHub routing")
+        .build()
+        .map_err(|_| ViolationAction::Block)?;
+    resolve_owner_with(&client, profile, body).await
+}
+async fn resolve_owner_with(
+    client: &impl RoutingApi,
+    profile: &str,
+    body: &[u8],
+) -> Result<String, ViolationAction> {
+    use graphql_parser::query::{OperationDefinition as O, Selection};
+    let profile: Profile = serde_json::from_str(profile).map_err(|_| ViolationAction::Block)?;
+    if !valid_profile(&profile) {
+        return Err(ViolationAction::Block);
+    }
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|_| ViolationAction::Block)?
+        .as_secs();
+    if profile
+        .owners
+        .iter()
+        .any(|o| o.expires_at <= now + 25 || o.read_token.is_empty())
+    {
+        return Err(ViolationAction::Block);
+    }
+    let request: serde_json::Value =
+        serde_json::from_slice(body).map_err(|_| ViolationAction::Block)?;
+    let query = request["query"].as_str().ok_or(ViolationAction::Block)?;
+    let document = parse_query::<String>(query).map_err(|_| ViolationAction::Block)?;
+    let selected = request["operationName"].as_str();
+    let operations: Vec<_> = document
+        .definitions
+        .iter()
+        .filter_map(|d| match d {
+            Definition::Operation(op) => {
+                let name = match op {
+                    O::Query(q) => q.name.as_deref(),
+                    O::Mutation(m) => m.name.as_deref(),
+                    O::Subscription(s) => s.name.as_deref(),
+                    O::SelectionSet(_) => None,
+                };
+                if selected.is_none() || selected == name {
+                    Some(op)
+                } else {
+                    None
+                }
+            }
+            _ => None,
+        })
+        .collect();
+    if operations.len() != 1 {
+        return Err(ViolationAction::Block);
+    }
+    let (root, definitions, selection) = match operations[0] {
+        O::Query(q) => ("Query", q.variable_definitions.as_slice(), &q.selection_set),
+        O::Mutation(m) => (
+            "Mutation",
+            m.variable_definitions.as_slice(),
+            &m.selection_set,
+        ),
+        O::SelectionSet(s) => ("Query", &[][..], s),
+        O::Subscription(_) => return Err(ViolationAction::Block),
+    };
+    let mut variables = request
+        .get("variables")
+        .filter(|v| v.is_object())
+        .cloned()
+        .unwrap_or_else(|| serde_json::json!({}));
+    let mut work = Vec::new();
+    for definition in definitions {
+        if variables.get(&definition.name).is_none()
+            && let Some(default) = &definition.default_value
+        {
+            variables[&definition.name] = input_value(default, &variables)?;
+        }
+        if let Some(value) = variables.get(&definition.name) {
+            work.push((variable_type(&definition.var_type), value.clone(), 0usize));
+        }
+    }
+
+    let token = &profile.owners[0].read_token;
+    let mut cache = std::collections::HashMap::new();
+    let mut hints = std::collections::BTreeSet::new();
+    let mut selections = vec![selection];
+    let mut fragments = std::collections::HashSet::new();
+    while let Some(selection) = selections.pop() {
+        for item in &selection.items {
+            match item {
+                Selection::Field(field) => {
+                    for (name, value) in &field.arguments {
+                        if name == "owner"
+                            && let Ok(serde_json::Value::String(owner)) =
+                                input_value(value, &variables)
+                        {
+                            hints.insert(owner.to_ascii_lowercase());
+                        }
+                        if matches!(value, graphql_parser::query::Value::Variable(_)) {
+                            continue;
+                        }
+                        let schema = schema_type(client, token, root, &mut cache, true).await?;
+                        let arg = schema["fields"]
+                            .as_array()
+                            .and_then(|fields| {
+                                fields
+                                    .iter()
+                                    .find(|f| f["name"].as_str() == Some(&field.name))
+                            })
+                            .and_then(|f| f["args"].as_array())
+                            .and_then(|args| args.iter().find(|a| a["name"].as_str() == Some(name)))
+                            .ok_or(ViolationAction::Block)?;
+                        work.push((arg["type"].clone(), input_value(value, &variables)?, 0));
+                    }
+                }
+                Selection::InlineFragment(fragment) => selections.push(&fragment.selection_set),
+                Selection::FragmentSpread(spread) => {
+                    if !fragments.insert(spread.fragment_name.clone()) {
+                        continue;
+                    }
+                    let found = document
+                        .definitions
+                        .iter()
+                        .find_map(|d| match d {
+                            Definition::Fragment(f) if f.name == spread.fragment_name => {
+                                Some(&f.selection_set)
+                            }
+                            _ => None,
+                        })
+                        .ok_or(ViolationAction::Block)?;
+                    selections.push(found);
+                }
+            }
+        }
+    }
+    let mut ids = std::collections::BTreeSet::new();
+    let mut visited = 0usize;
+    while let Some((kind, value, depth)) = work.pop() {
+        visited += 1;
+        if depth > 16 || visited > 2048 {
+            return Err(ViolationAction::Block);
+        }
+        if value.is_null() {
+            continue;
+        }
+        match kind["kind"].as_str().ok_or(ViolationAction::Block)? {
+            "NON_NULL" => work.push((kind["ofType"].clone(), value, depth + 1)),
+            "LIST" => {
+                let values = match value {
+                    serde_json::Value::Array(values) => values,
+                    other => vec![other],
+                };
+                for value in values {
+                    work.push((kind["ofType"].clone(), value, depth + 1));
+                }
+            }
+            "NAMED" | "SCALAR" | "ENUM" | "INPUT_OBJECT" => {
+                let name = kind["name"].as_str().ok_or(ViolationAction::Block)?;
+                if name == "ID" {
+                    let id = match value {
+                        serde_json::Value::String(s) => s,
+                        serde_json::Value::Number(n) => n.to_string(),
+                        _ => return Err(ViolationAction::Block),
+                    };
+                    if id.len() > 4096 {
+                        return Err(ViolationAction::Block);
+                    };
+                    ids.insert(id);
+                    if ids.len() > MAX_ROUTING_IDS {
+                        return Err(ViolationAction::Block);
+                    };
+                    continue;
+                }
+                if matches!(name, "String" | "Int" | "Float" | "Boolean") {
+                    continue;
+                }
+                let schema = schema_type(client, token, name, &mut cache, false).await?;
+                if schema["kind"] == "INPUT_OBJECT" {
+                    let object = value.as_object().ok_or(ViolationAction::Block)?;
+                    for (field, value) in object {
+                        let declared = schema["inputFields"]
+                            .as_array()
+                            .and_then(|fields| {
+                                fields.iter().find(|f| f["name"].as_str() == Some(field))
+                            })
+                            .ok_or(ViolationAction::Block)?;
+                        work.push((declared["type"].clone(), value.clone(), depth + 1));
+                    }
+                }
+            }
+            _ => return Err(ViolationAction::Block),
+        }
+    }
+    let ids: Vec<_> = ids.into_iter().collect();
+    let mut found = std::collections::HashSet::new();
+    if !ids.is_empty() {
+        const LOOKUP: &str = "query SiloRoutingNodes($ids:[ID!]!){nodes(ids:$ids){id ... on Repository {owner{login}} ... on RepositoryNode {repository{owner{login}}}}}";
+        for owner in &profile.owners {
+            let response = client
+                .query(&owner.read_token, LOOKUP, serde_json::json!({"ids":ids}))
+                .await?;
+            let nodes = response
+                .pointer("/data/nodes")
+                .and_then(|v| v.as_array())
+                .ok_or(ViolationAction::Block)?;
+            if response.get("errors").is_some() && nodes.iter().any(|node| !node.is_null()) {
+                return Err(ViolationAction::Block);
+            }
+            if nodes.len() != ids.len() {
+                return Err(ViolationAction::Block);
+            }
+            for node in nodes {
+                if let Some(id) = node["id"].as_str() {
+                    found.insert(id.to_string());
+                }
+                if let Some(login) = node
+                    .pointer("/owner/login")
+                    .or_else(|| node.pointer("/repository/owner/login"))
+                    .and_then(|v| v.as_str())
+                {
+                    hints.insert(login.to_ascii_lowercase());
+                }
+            }
+        }
+        if ids.iter().any(|id| !found.contains(id)) {
+            return Err(ViolationAction::Block);
+        }
+    }
+    if hints.is_empty() && root == "Query" {
+        return profile
+            .owners
+            .iter()
+            .min_by_key(|owner| owner.login.to_ascii_lowercase())
+            .map(|owner| owner.login.clone())
+            .ok_or(ViolationAction::Block);
+    }
+    if hints.len() != 1 {
+        return Err(ViolationAction::Block);
+    }
+    let owner = hints.into_iter().next().ok_or(ViolationAction::Block)?;
+    if profile
+        .owners
+        .iter()
+        .filter(|p| p.login.eq_ignore_ascii_case(&owner))
+        .count()
+        != 1
+    {
+        return Err(ViolationAction::Block);
+    }
+    Ok(owner)
+}
