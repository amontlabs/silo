+            );
+        }
+        let mut p: serde_json::Value = serde_json::from_str(&profile()).unwrap();
+        p["owners"][0]["expiresAt"] = serde_json::json!(0);
+        assert!(
+            select(
+                &p.to_string(),
+                "api.github.com",
+                "GET /repos/alice/a HTTP/1.1\r\n",
+                b""
+            )
+            .is_err()
+        );
+        p["owners"][0]["expiresAt"] = serde_json::json!(4102444800u64);
+        p["owners"][0]["writeToken"] = serde_json::Value::Null;
+        assert!(
+            select(
+                &p.to_string(),
+                "api.github.com",
+                "POST /repos/alice/a/issues HTTP/1.1\r\n",
+                b""
+            )
+            .is_err()
+        );
+        assert_eq!(
+            select(
+                &p.to_string(),
+                "api.github.com",
+                "GET /repos/alice/a HTTP/1.1\r\n",
+                b""
+            )
+            .unwrap(),
+            "read"
+        );
+    }
+    #[test]
+    fn multi_owner_node_only_request_requires_async_owner_resolution() {
+        let mut p: serde_json::Value = serde_json::from_str(&profile()).unwrap();
+        let mut second = p["owners"][0].clone();
+        second["login"] = serde_json::json!("bob");
+        p["owners"].as_array_mut().unwrap().push(second);
+        let body=br#"{"query":"mutation($id:ID!){addComment(input:{subjectId:$id,body:\"test\"}){clientMutationId}}","variables":{"id":"opaque_node_id"}}"#;
+        assert!(
+            select(
+                &p.to_string(),
+                "api.github.com",
+                "POST /graphql HTTP/1.1\r\n",
+                body
+            )
+            .is_err()
+        );
+        // Explicit owner routes without interpreting or replaying the mutation.
+        let mut request: serde_json::Value = serde_json::from_slice(body).unwrap();
+        request["variables"]["owner"] = serde_json::json!("bob");
+        assert_eq!(
+            select(
+                &p.to_string(),
+                "api.github.com",
+                "POST /graphql HTTP/1.1\r\n",
+                &serde_json::to_vec(&request).unwrap()
+            )
+            .unwrap(),
+            "write"
+        );
+    }
+    #[test]
+    fn duplicate_owner_or_unknown_operation_is_not_guessed() {
+        let mut p: serde_json::Value = serde_json::from_str(&profile()).unwrap();
+        let duplicate = p["owners"][0].clone();
+        p["owners"].as_array_mut().unwrap().push(duplicate);
+        assert!(
+            select(
+                &p.to_string(),
+                "api.github.com",
+                "GET /repos/alice/a HTTP/1.1\r\n",
+                b""
+            )
+            .is_err()
+        );
+        let body = br#"{"query":"query A { viewer { login } }","operationName":"Missing"}"#;
+        assert!(
+            select(
+                &profile(),
+                "api.github.com",
+                "POST /graphql HTTP/1.1\r\n",
+                body
+            )
+            .is_err()
+        );
+    }
+}
+
+/// Routing hints do not grant authority. GitHub still checks the selected scoped token.
+pub(super) fn needs_owner_lookup(profile: &str, sni: &str, headers: &str, body: &[u8]) -> bool {
+    if sni != "api.github.com"
+        || headers
+            .lines()
+            .next()
+            .and_then(|l| l.split_whitespace().nth(1))
+            .and_then(|p| p.split('?').next())
+            != Some("/graphql")
+    {
+        return false;
+    }
+    let Ok(profile) = serde_json::from_str::<Profile>(profile) else {
+        return false;
+    };
+    let Ok(request) = serde_json::from_slice::<serde_json::Value>(body) else {
+        return false;
+    };
+    profile.version == 1
+        && profile.owners.len() > 1
+        && request
+            .pointer("/variables/owner")
+            .and_then(|v| v.as_str())
+            .is_none()
+}
