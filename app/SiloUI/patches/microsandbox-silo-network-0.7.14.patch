+async fn until_policy_change(
+    mut changes: tokio::sync::watch::Receiver<()>,
+    relay: impl std::future::Future<Output = io::Result<()>>,
+) -> io::Result<()> {
+    tokio::select! {
+        biased;
+        _ = changes.changed() => Err(io::Error::new(io::ErrorKind::PermissionDenied,
+            "secret policy changed; connection closed")),
+        result = relay => result,
+    }
+}
