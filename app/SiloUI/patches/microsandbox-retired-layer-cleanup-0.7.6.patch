+    /// A root journal whose raw base and `overlays` qcow2 layers sit in a sandbox directory.
+    fn sandbox_chain(overlays: usize) -> (tempfile::TempDir, std::path::PathBuf, Vec<super::RootDiskLayer>) {
+        use super::*;
+        let sandbox = tempfile::tempdir().unwrap();
+        let root = sandbox.path().join("runtime");
+        std::fs::create_dir(&root).unwrap();
+        let base = sandbox.path().join("upper.ext4");
+        std::fs::write(&base, vec![71u8; 131072]).unwrap();
+        let rt = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let mut layers = vec![RootDiskLayer {
+            layer_id: new_id("layer"),
+            path: base,
+            format: RootDiskFormat::Raw,
+            integrity_root: None,
+        }];
+        for i in 0..overlays {
+            let path = sandbox.path().join(format!("upper-{i}.qcow2"));
+            let prior = layers.last().unwrap();
+            rt.block_on(microsandbox_image::checkpoint::create_qcow2_overlay(
+                &path,
+                131072,
+                &prior.path,
+                prior.format.as_str(),
+            ))
+            .unwrap();
+            layers.push(RootDiskLayer {
+                layer_id: new_id("layer"),
+                path,
+                format: RootDiskFormat::Qcow2,
+                integrity_root: None,
+            });
+        }
+        write_state(
+            &root.join(ROOT_DISK_STATE_FILE),
+            &RootDiskState {
+                schema: ROOT_DISK_STATE_SCHEMA.into(),
+                volume_id: new_id("vol"),
+                device_id: RootDiskLayout::ManagedUpper.device_id().into(),
+                layout: RootDiskLayout::ManagedUpper,
+                published_generation: 3,
+                launch_base: None,
+                growth_target: None,
+                layers: layers.clone(),
+            },
+        )
+        .unwrap();
+        (sandbox, root, layers)
+    }
+
+    #[test]
+    fn a_second_compaction_unlinks_the_first_merged_layer_under_the_stage_directory() {
+        use super::*;
+        let (_sandbox, root, original) = sandbox_chain(5);
+        let journal = root.join(ROOT_DISK_STATE_FILE);
+
+        compact_stopped_root(&root, Some(3), false).unwrap();
+        let first = read_state(&journal).unwrap();
+        let merged = first.layers[0].path.clone();
+        assert!(merged.starts_with(&root), "the merged layer lives under runtime/");
+        assert!(merged.exists());
+        for old in &original[1..3] {
+            assert!(!old.path.exists(), "{} was retired", old.path.display());
+        }
+
+        compact_stopped_root(&root, None, false).unwrap();
+        let second = read_state(&journal).unwrap();
+        assert!(!merged.exists(), "the first merged layer was retired");
+        assert!(second.layers.iter().all(|layer| layer.path.exists()));
+        assert!(original[0].path.exists(), "the launch base stays");
+        assert!(load_runtime_owned_root_chain(&root).unwrap().is_some());
+    }
