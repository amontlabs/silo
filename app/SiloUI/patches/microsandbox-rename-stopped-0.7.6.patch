+    fn only_paths_below_the_old_directory_are_rewritten() {
+        let mut value = serde_json::json!({
+            "inside": "/home/sandboxes/old/runtime/disk",
+            "exact": "/home/sandboxes/old",
+            "sibling": "/home/sandboxes/older/disk",
+            "elsewhere": ["/data/old", "old"],
+        });
+        move_paths(
+            &mut value,
+            Path::new("/home/sandboxes/old"),
+            Path::new("/home/sandboxes/new"),
+        );
+        assert_eq!(value["inside"], "/home/sandboxes/new/runtime/disk");
+        assert_eq!(value["exact"], "/home/sandboxes/new");
+        assert_eq!(value["sibling"], "/home/sandboxes/older/disk");
+        assert_eq!(value["elsewhere"], serde_json::json!(["/data/old", "old"]));
+    }
