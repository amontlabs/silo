+    #[tokio::test]
+    async fn rename_refuses_an_existing_name_in_the_catalog_or_on_disk() {
+        let (_temp, backend) = fixture().await;
+        let first = add(&backend, "first", SandboxStatus::Stopped).await;
+        add(&backend, "second", SandboxStatus::Stopped).await;
+        let local = backend.as_local().unwrap();
+        let error = rename_stopped(backend.clone(), "first", "second")
+            .await
+            .unwrap_err();
+        assert!(matches!(error, MicrosandboxError::SandboxAlreadyExists(_)));
+
+        std::fs::create_dir_all(local.sandboxes_dir().join("leftover")).unwrap();
+        let error = rename_stopped(backend.clone(), "first", "leftover")
+            .await
+            .unwrap_err();
+        assert!(matches!(error, MicrosandboxError::SandboxAlreadyExists(_)));
+        assert_eq!(name_of(&backend, first).await.as_deref(), Some("first"));
+        assert!(local.sandboxes_dir().join("first/marker").is_file());
+
+        let error = rename_stopped(backend.clone(), "first", "first")
+            .await
+            .unwrap_err();
+        assert!(error.to_string().contains("differ"));
+        let error = rename_stopped(backend.clone(), "missing", "other")
+            .await
+            .unwrap_err();
+        assert!(matches!(error, MicrosandboxError::SandboxNotFound(_)));
+    }
