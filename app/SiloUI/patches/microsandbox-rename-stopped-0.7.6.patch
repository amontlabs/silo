+//! Rename a stopped sandbox.
+//!
+//! A sandbox name lives in three places: the catalog row (`name`, and the `spec.name` inside the
+//! stored configuration), the sandbox directory `sandboxes/<name>`, and the per-name lock files
+//! under the run directory, which are derived from the name and never need to move. Everything
+//! else the runtime persists is keyed by the numeric sandbox id (runs, labels, root disk records,
+//! the snapshot ancestry cursor inside the sandbox directory) or is a relative path inside the
+//! sandbox directory, so it follows the directory.
+//!
+//! The rename takes the transition, snapshot-ancestry and lifecycle locks of both names (in name
+//! order, so two opposite renames cannot wait on each other), writes a journal that records the
+//! complete new configuration, renames the directory, updates the row in one transaction and
+//! removes the journal. A process that dies in between leaves the journal; the next rename or
+//! start of either name finishes it. Snapshot groups are labels chosen when a capture is taken
+//! and keep their name.
+
+use std::{
+    any::Any,
+    path::{Path, PathBuf},
+    sync::Arc,
+    time::Duration,
+};
+
+use sea_orm::{ColumnTrait, EntityTrait, QueryFilter, sea_query::Expr};
+use serde::{Deserialize, Serialize};
+
+use crate::backend::{Backend, LocalBackend};
+use crate::db::entity::sandbox as sandbox_entity;
+use crate::{MicrosandboxError, MicrosandboxResult};
+
+use super::{SandboxConfig, SandboxStatus};
+
+//--------------------------------------------------------------------------------------------------
+// Constants
+//--------------------------------------------------------------------------------------------------
+
+const JOURNAL_DIRECTORY: &str = "rename-journal";
+const JOURNAL_SCHEMA: u32 = 1;
+
+//--------------------------------------------------------------------------------------------------
+// Types
+//--------------------------------------------------------------------------------------------------
+
+/// Everything needed to finish a rename after the process that began it is gone.
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Journal {
+    schema: u32,
+    sandbox_id: i32,
+    old: String,
+    new: String,
+    config: String,
+    active_config: Option<String>,
+}
+
+type Held = Vec<Box<dyn Any + Send>>;
+
+//--------------------------------------------------------------------------------------------------
+// Functions
+//--------------------------------------------------------------------------------------------------
+
+/// Rename a created, stopped or crashed local sandbox.
+pub(crate) async fn rename_stopped(
+    backend: Arc<dyn Backend>,
+    old: &str,
+    new: &str,
+) -> MicrosandboxResult<()> {
+    let invalid = |message: String| MicrosandboxError::InvalidConfig(message);
+    let local = backend
+        .as_local()
+        .ok_or_else(|| MicrosandboxError::local_only(crate::error::Operation::SandboxModify))?;
+    local.validate_sandbox_name_for_runtime(new)?;
+    if old == new {
+        return Err(invalid(
+            "the new name must differ from the current name".into(),
+        ));
+    }
+    recover_for_names(local, &[old, new]).await?;
+
+    // The handle reconciles a row left Running by a crashed runtime before the status check.
+    let handle = backend.sandboxes().get(backend.clone(), old).await?;
+    if !matches!(
+        handle.status_snapshot(),
+        SandboxStatus::Created | SandboxStatus::Stopped | SandboxStatus::Crashed
+    ) {
+        return Err(MicrosandboxError::SandboxStillRunning(format!(
+            "cannot rename sandbox {old:?}: stop it first"
+        )));
+    }
+
+    let _held = acquire(local, &[old, new]).await?;
+    let model = find_by_name(local, old)
+        .await?
+        .ok_or_else(|| MicrosandboxError::SandboxNotFound(old.into()))?;
+    if let Some(state) = handle.local()
+        && state.db_id != model.id
+    {
+        return Err(MicrosandboxError::SandboxReplaced {
+            name: old.into(),
+            expected: format!("local:{}", state.db_id),
+            actual: format!("local:{}", model.id),
+        });
+    }
+    if !matches!(
+        model.status,
+        SandboxStatus::Created | SandboxStatus::Stopped | SandboxStatus::Crashed
+    ) {
+        return Err(MicrosandboxError::SandboxStillRunning(format!(
+            "cannot rename sandbox {old:?}: status is {:?}",
+            model.status
+        )));
+    }
+    if find_by_name(local, new).await?.is_some() {
+        return Err(MicrosandboxError::SandboxAlreadyExists(format!(
+            "sandbox '{new}' already exists"
+        )));
+    }
+    let sandboxes_dir = local.sandboxes_dir();
+    let old_dir = sandboxes_dir.join(old);
+    let new_dir = sandboxes_dir.join(new);
+    if std::fs::symlink_metadata(&new_dir).is_ok() {
+        return Err(MicrosandboxError::SandboxAlreadyExists(format!(
+            "sandbox '{new}' already exists"
+        )));
+    }
+    if !std::fs::symlink_metadata(&old_dir)?.is_dir() {
+        return Err(invalid(format!(
+            "the directory of sandbox {old:?} is missing"
+        )));
+    }
+
+    let journal = Journal {
+        schema: JOURNAL_SCHEMA,
+        sandbox_id: model.id,
+        old: old.into(),
+        new: new.into(),
+        config: rewrite_config(&model.config, new, &old_dir, &new_dir)?,
+        active_config: model
+            .active_config
+            .as_deref()
+            .map(|json| rewrite_config(json, new, &old_dir, &new_dir))
+            .transpose()?,
+    };
+    crate::runtime::remove_sandbox_socket_artifacts_for(local, old)?;
+    write_journal(local, &journal)?;
+    if let Err(error) = rename_directory(&old_dir, &new_dir) {
+        remove_journal(local, model.id)?;
+        return Err(error);
+    }
+    if let Err(error) = update_row(local, &journal).await {
+        // Put the directory back so the catalog and the filesystem agree; if that fails too the
+        // journal stays and the next start finishes the rename instead.
+        if rename_directory(&new_dir, &old_dir).is_ok() {
+            remove_journal(local, model.id)?;
+        }
+        return Err(error);
+    }
+    remove_journal(local, model.id)
+}
+
+/// Finish any interrupted rename that involves one of `names`.
+pub(crate) async fn recover_for_names(
+    local: &LocalBackend,
+    names: &[&str],
+) -> MicrosandboxResult<()> {
+    let directory = journal_directory(local);
+    let entries = match std::fs::read_dir(&directory) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error.into()),
+    };
+    let mut pending = Vec::new();
+    for entry in entries {
+        let path = entry?.path();
+        if path.extension().and_then(|extension| extension.to_str()) != Some("json") {
+            continue;
+        }
+        let journal: Journal = serde_json::from_slice(&std::fs::read(&path)?)?;
+        if journal.schema == JOURNAL_SCHEMA
+            && names
+                .iter()
+                .any(|name| *name == journal.old || *name == journal.new)
+        {
+            pending.push(journal);
+        }
+    }
+    for journal in pending {
+        let _held = acquire(local, &[&journal.old, &journal.new]).await?;
+        // Another process may have finished it while this one waited for the locks.
+        if journal_path(local, journal.sandbox_id).is_file() {
+            finish(local, &journal).await?;
+        }
+    }
+    Ok(())
+}
+
+/// Complete a journaled rename once the caller holds the locks of both names.
+async fn finish(local: &LocalBackend, journal: &Journal) -> MicrosandboxResult<()> {
+    let sandboxes_dir = local.sandboxes_dir();
+    let old_dir = sandboxes_dir.join(&journal.old);
+    let new_dir = sandboxes_dir.join(&journal.new);
+    let old_present = std::fs::symlink_metadata(&old_dir).is_ok();
+    let new_present = std::fs::symlink_metadata(&new_dir).is_ok();
+    let row = find_by_id(local, journal.sandbox_id).await?;
+
+    let Some(row) = row else {
+        // The sandbox is gone; nothing remains to finish.
+        return remove_journal(local, journal.sandbox_id);
+    };
+    if row.name == journal.new {
+        if !new_present && old_present {
+            rename_directory(&old_dir, &new_dir)?;
+        }
+        return remove_journal(local, journal.sandbox_id);
+    }
+    if row.name != journal.old {
+        return Err(MicrosandboxError::Runtime(format!(
+            "rename journal for sandbox {} names {:?} and {:?}, but the sandbox is {:?}",
+            journal.sandbox_id, journal.old, journal.new, row.name
+        )));
+    }
+    if find_by_name(local, &journal.new).await?.is_some() {
+        // Another sandbox took the new name before this one's directory moved: abandon the
+        // rename, which leaves the sandbox under its old name.
+        if old_present {
+            return remove_journal(local, journal.sandbox_id);
+        }
+        return Err(MicrosandboxError::Runtime(format!(
+            "cannot finish renaming sandbox {:?}: {:?} is taken",
+            journal.old, journal.new
+        )));
+    }
+    match (old_present, new_present) {
+        (true, false) => rename_directory(&old_dir, &new_dir)?,
+        (false, true) => {}
+        _ => {
+            return Err(MicrosandboxError::Runtime(format!(
+                "cannot finish renaming sandbox {:?}: the directories {} and {} are inconsistent",
+                journal.old,
+                old_dir.display(),
+                new_dir.display()
+            )));
+        }
+    }
+    update_row(local, journal).await?;
+    remove_journal(local, journal.sandbox_id)
+}
+
+async fn acquire(local: &LocalBackend, names: &[&str]) -> MicrosandboxResult<Held> {
+    let run_dir = local.config().run_dir();
+    let mut ordered: Vec<&str> = names.to_vec();
+    ordered.sort_unstable();
+    ordered.dedup();
+    let mut held: Held = Vec::new();
+    for name in &ordered {
+        held.push(Box::new(
+            LocalBackend::acquire_sandbox_transition_guard(&run_dir, name).await?,
+        ));
+    }
+    for name in &ordered {
+        held.push(Box::new(
+            crate::snapshot::lineage::lock_source(&run_dir, name).await?,
+        ));
+    }
+    for name in &ordered {
+        held.push(Box::new(
+            crate::runtime::acquire_sandbox_lifecycle_guard(&run_dir, name, Duration::from_secs(5))
+                .await?,
+        ));
+    }
+    Ok(held)
+}
+
+async fn find_by_name(
+    local: &LocalBackend,
+    name: &str,
+) -> MicrosandboxResult<Option<sandbox_entity::Model>> {
+    let pools = local.db().await?;
+    Ok(microsandbox_db::catalog::sandbox_query(pools.read())
+        .await?
+        .filter(sandbox_entity::Column::Name.eq(name))
+        .one(pools.read())
+        .await?)
+}
+
+async fn find_by_id(
+    local: &LocalBackend,
+    id: i32,
+) -> MicrosandboxResult<Option<sandbox_entity::Model>> {
+    let pools = local.db().await?;
+    Ok(microsandbox_db::catalog::sandbox_query(pools.read())
+        .await?
+        .filter(sandbox_entity::Column::Id.eq(id))
+        .one(pools.read())
+        .await?)
+}
+
+async fn update_row(local: &LocalBackend, journal: &Journal) -> MicrosandboxResult<()> {
+    let pools = local.db().await?;
+    pools
+        .write()
+        .transaction(|txn| {
+            let config = journal.config.clone();
+            let active_config = journal.active_config.clone();
+            let new = journal.new.clone();
+            let old = journal.old.clone();
+            let id = journal.sandbox_id;
+            async move {
+                let result = sandbox_entity::Entity::update_many()
+                    .col_expr(sandbox_entity::Column::Name, Expr::value(new))
+                    .col_expr(sandbox_entity::Column::Config, Expr::value(config))
+                    .col_expr(
+                        sandbox_entity::Column::ActiveConfig,
+                        Expr::value(active_config),
+                    )
+                    .col_expr(
+                        sandbox_entity::Column::UpdatedAt,
+                        Expr::value(chrono::Utc::now().naive_utc()),
+                    )
+                    .filter(sandbox_entity::Column::Id.eq(id))
+                    .filter(sandbox_entity::Column::Name.eq(old.as_str()))
+                    .exec(&txn)
+                    .await?;
+                if result.rows_affected != 1 {
+                    return Err(MicrosandboxError::SandboxNotFound(old));
+                }
+                Ok((txn, ()))
+            }
+        })
+        .await
+}
+
+/// Set the new name and move every path under the old sandbox directory to the new one.
+fn rewrite_config(
+    json: &str,
+    new: &str,
+    old_dir: &Path,
+    new_dir: &Path,
+) -> MicrosandboxResult<String> {
+    let mut config: SandboxConfig = serde_json::from_str(json)?;
+    config.spec.name = new.into();
+    let mut value = serde_json::to_value(&config)?;
+    move_paths(&mut value, old_dir, new_dir);
+    Ok(serde_json::to_string(&value)?)
+}
+
+fn move_paths(value: &mut serde_json::Value, old_dir: &Path, new_dir: &Path) {
+    match value {
+        serde_json::Value::String(text) => {
+            if let Ok(rest) = Path::new(text.as_str()).strip_prefix(old_dir) {
+                let moved = if rest.as_os_str().is_empty() {
+                    new_dir.to_path_buf()
+                } else {
+                    new_dir.join(rest)
+                };
+                *text = moved.to_string_lossy().into_owned();
+            }
+        }
+        serde_json::Value::Array(items) => {
+            items
+                .iter_mut()
+                .for_each(|item| move_paths(item, old_dir, new_dir));
+        }
+        serde_json::Value::Object(map) => {
+            map.values_mut()
+                .for_each(|item| move_paths(item, old_dir, new_dir));
+        }
+        _ => {}
+    }
+}
+
+fn rename_directory(from: &Path, to: &Path) -> MicrosandboxResult<()> {
+    std::fs::rename(from, to)?;
+    sync_directory(to.parent().expect("sandbox directory has a parent"))
+}
+
+fn journal_directory(local: &LocalBackend) -> PathBuf {
+    local.config().home().join(JOURNAL_DIRECTORY)
+}
+
+fn journal_path(local: &LocalBackend, sandbox_id: i32) -> PathBuf {
+    journal_directory(local).join(format!("{sandbox_id}.json"))
+}
+
+fn write_journal(local: &LocalBackend, journal: &Journal) -> MicrosandboxResult<()> {
+    use std::io::Write;
+    let directory = journal_directory(local);
+    std::fs::create_dir_all(&directory)?;
+    let mut staged = tempfile::NamedTempFile::new_in(&directory)?;
+    staged.write_all(&serde_json::to_vec(journal)?)?;
+    staged.as_file().sync_all()?;
+    staged
+        .persist(journal_path(local, journal.sandbox_id))
+        .map_err(|error| MicrosandboxError::Io(error.error))?;
+    sync_directory(&directory)
+}
+
+fn remove_journal(local: &LocalBackend, sandbox_id: i32) -> MicrosandboxResult<()> {
+    match std::fs::remove_file(journal_path(local, sandbox_id)) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error.into()),
+    }
+    sync_directory(&journal_directory(local))
+}
+
+fn sync_directory(path: &Path) -> MicrosandboxResult<()> {
+    #[cfg(unix)]
+    std::fs::File::open(path)?.sync_all()?;
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
