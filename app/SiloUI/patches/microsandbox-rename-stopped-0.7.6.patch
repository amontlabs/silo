+            assert!(!local.sandboxes_dir().join("before").exists());
+            assert_eq!(
+                std::fs::read_to_string(local.sandboxes_dir().join("after/marker")).unwrap(),
+                "before"
+            );
+            let row = find_by_name(local, "after").await.unwrap().unwrap();
+            assert_eq!(row.status, status);
+            let config = stored_config(&row);
+            assert_eq!(config.spec.name, "after");
+            assert_eq!(
+                config.spec.env[0].value,
+                local
+                    .sandboxes_dir()
+                    .join("after/runtime")
+                    .to_string_lossy()
+            );
+            assert!(!journal_path(local, id).exists());
+        }
+    }
