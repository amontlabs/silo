+    #[tokio::test]
+    async fn rename_refuses_active_states_and_changes_nothing() {
+        for status in [
+            SandboxStatus::Running,
+            SandboxStatus::Starting,
+            SandboxStatus::Draining,
+            SandboxStatus::Paused,
+        ] {
+            let (_temp, backend) = fixture().await;
+            let id = add(&backend, "busy", status).await;
+            let local = backend.as_local().unwrap();
+            // A live runtime owns the lifecycle lock; without it the row would be reconciled.
+            let _runtime = microsandbox_runtime::ipc::acquire_lifecycle_guard(
+                &local.config().run_dir(),
+                "busy",
+            )
+            .unwrap();
+            let error = rename_stopped(backend.clone(), "busy", "idle")
+                .await
+                .unwrap_err();
+            assert!(error.to_string().contains("busy"), "{status:?}: {error}");
+            assert_eq!(name_of(&backend, id).await.as_deref(), Some("busy"));
+            assert!(local.sandboxes_dir().join("busy/marker").is_file());
+            assert!(!local.sandboxes_dir().join("idle").exists());
+        }
+    }
