+    async fn add(backend: &Arc<dyn Backend>, name: &str, status: SandboxStatus) -> i32 {
+        let local = backend.as_local().unwrap();
+        let directory = local.sandboxes_dir().join(name);
+        std::fs::create_dir_all(directory.join("runtime")).unwrap();
+        std::fs::write(directory.join("marker"), name).unwrap();
+        let mut config = SandboxConfig::default();
+        config.spec.name = name.into();
+        config.snapshot_parent = None;
