+    /// Build the journal a crashed rename would leave behind.
+    async fn crashed_journal(backend: &Arc<dyn Backend>, old: &str, new: &str) -> Journal {
+        let local = backend.as_local().unwrap();
+        let row = find_by_name(local, old).await.unwrap().unwrap();
+        let sandboxes_dir = local.sandboxes_dir();
+        let journal = Journal {
+            schema: JOURNAL_SCHEMA,
+            sandbox_id: row.id,
+            old: old.into(),
+            new: new.into(),
+            config: rewrite_config(
+                &row.config,
+                new,
+                &sandboxes_dir.join(old),
+                &sandboxes_dir.join(new),
+            )
+            .unwrap(),
+            active_config: None,
+        };
+        write_journal(local, &journal).unwrap();
+        journal
+    }
+
+    #[tokio::test]
+    async fn an_interrupted_rename_finishes_from_every_crash_point() {
+        // After the journal, after the directory moved, and with the catalog already updated.
+        for point in 0..3 {
+            let (_temp, backend) = fixture().await;
+            let id = add(&backend, "old", SandboxStatus::Stopped).await;
+            let local = backend.as_local().unwrap();
+            let journal = crashed_journal(&backend, "old", "new").await;
+            if point >= 1 {
+                std::fs::rename(
+                    local.sandboxes_dir().join("old"),
+                    local.sandboxes_dir().join("new"),
+                )
+                .unwrap();
+            }
+            if point >= 2 {
+                update_row(local, &journal).await.unwrap();
+            }
+            recover_for_names(local, &["old"]).await.unwrap();
+            assert_eq!(
+                name_of(&backend, id).await.as_deref(),
+                Some("new"),
+                "{point}"
+            );
+            assert!(
+                local.sandboxes_dir().join("new/marker").is_file(),
+                "{point}"
+            );
+            assert!(!local.sandboxes_dir().join("old").exists(), "{point}");
+            assert!(!journal_path(local, id).exists(), "{point}");
+            let row = find_by_name(local, "new").await.unwrap().unwrap();
+            assert_eq!(stored_config(&row).spec.name, "new");
+        }
+    }
+
+    #[tokio::test]
+    async fn recovery_abandons_a_rename_whose_new_name_was_taken_before_the_move() {
+        let (_temp, backend) = fixture().await;
+        let id = add(&backend, "old", SandboxStatus::Stopped).await;
+        let local = backend.as_local().unwrap();
+        crashed_journal(&backend, "old", "new").await;
+        let other = add(&backend, "new", SandboxStatus::Stopped).await;
+        recover_for_names(local, &["old", "new"]).await.unwrap();
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("old"));
+        assert_eq!(name_of(&backend, other).await.as_deref(), Some("new"));
+        assert!(local.sandboxes_dir().join("old/marker").is_file());
+        assert!(!journal_path(local, id).exists());
+    }
