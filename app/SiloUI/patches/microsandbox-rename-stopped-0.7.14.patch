+    #[tokio::test]
+    async fn a_directory_sync_that_fails_once_undoes_the_rename() {
+        let (_temp, backend) = fixture().await;
+        let id = add(&backend, "before", SandboxStatus::Stopped).await;
+        let local = backend.as_local().unwrap();
+        fail_syncs_of(local.sandboxes_dir(), 1);
+        let error = rename_stopped(backend.clone(), "before", "after")
+            .await
+            .unwrap_err();
+        assert!(error.to_string().contains("injected"), "{error}");
+        // The directory moved before the sync failed: it is back, the row never changed, and no
+        // journal is left claiming otherwise.
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("before"));
+        assert_named(local, "before", "after");
+        assert!(!journal_path(local, id).exists());
+    }
+
+    #[tokio::test]
+    async fn a_directory_sync_that_keeps_failing_keeps_the_journal_until_recovery() {
+        let (_temp, backend) = fixture().await;
+        let id = add(&backend, "before", SandboxStatus::Stopped).await;
+        let local = backend.as_local().unwrap();
+        fail_syncs_of(local.sandboxes_dir(), 100);
+        rename_stopped(backend.clone(), "before", "after")
+            .await
+            .unwrap_err();
+        // Neither the rename nor its undo could be confirmed, so the journal stays.
+        let journal = read_journal(local, id).unwrap().expect("journal is kept");
+        assert!(journal.rolling_back);
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("before"));
+
+        fail_syncs_of(local.sandboxes_dir(), 0);
+        recover_for_names(local, &["before"]).await.unwrap();
+        assert!(!journal_path(local, id).exists());
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("before"));
+        assert_named(local, "before", "after");
+        // The sandbox can be renamed afterwards.
+        rename_stopped(backend.clone(), "before", "after")
+            .await
+            .unwrap();
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("after"));
+        assert_named(local, "after", "before");
+    }
