+//! `msb rename` command: rename a stopped sandbox.
+
+use clap::Args;
+use microsandbox::sandbox::Sandbox;
+
+/// Arguments for renaming one stopped sandbox.
+#[derive(Debug, Args)]
+pub struct RenameArgs {
+    /// Existing created, stopped, or crashed sandbox.
+    pub name: String,
+    /// New sandbox name. Must not belong to another sandbox.
+    pub new_name: String,
+    /// Suppress the confirmation line.
+    #[arg(short, long)]
+    pub quiet: bool,
+}
+
+/// Rename the sandbox's catalog row, directory and saved configuration.
+pub async fn run(args: RenameArgs) -> anyhow::Result<()> {
+    Sandbox::rename_stopped(&args.name, &args.new_name).await?;
+    if !args.quiet {
+        println!("Renamed {} to {}", args.name, args.new_name);
+    }
+    Ok(())
+}
