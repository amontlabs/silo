+    #[test]
+    fn saved_caller_overrides_follow_the_rewritten_configuration() {
+        let old = Path::new("/home/sandboxes/old");
+        let new = Path::new("/home/sandboxes/new");
+        let config = crate::sandbox::SandboxBuilder::new("old")
+            .image(old.join("rootfs"))
+            .volume("/guest", |mount| mount.bind(old.join("share")))
+            .finish(None, None)
+            .unwrap();
+        let json = serde_json::to_string(&config).unwrap();
+        let overrides = config.caller_config_overrides_json(&json).unwrap();
+        assert!(overrides.is_some());
+
+        let (rewritten, rewritten_overrides) =
+            rewrite_config(&json, overrides.as_deref(), "new", old, new).unwrap();
+
+        let value: Value = serde_json::from_str(&rewritten).unwrap();
+        assert_eq!(value["name"], "new");
+        assert_eq!(value["mounts"][0]["host"], "/home/sandboxes/new/share");
+        assert_eq!(value["image"]["Bind"]["path"], "/home/sandboxes/new/rootfs");
+        let loaded =
+            SandboxConfig::from_stored(&rewritten, rewritten_overrides.as_deref()).unwrap();
+        let patch = loaded
+            .caller_config_overrides
+            .expect("overrides match the rewritten configuration");
+        let patch = serde_json::to_string(&*patch).unwrap();
+        assert!(patch.contains("/home/sandboxes/new/share"), "{patch}");
+        assert!(!patch.contains("/home/sandboxes/old/"), "{patch}");
+    }
