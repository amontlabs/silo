+    #[tokio::test]
+    async fn a_rename_that_died_in_every_step_finishes_or_rolls_back() {
+        // (directory moved, state rewritten, recorded step), then forward or back.
+        let points = [
+            (false, false, Step::Journaled),
+            (true, false, Step::Journaled),
+            (true, false, Step::DirectoryMoved),
+            (true, true, Step::DirectoryMoved),
+            (true, true, Step::StateRewritten),
+        ];
+        for rolling_back in [false, true] {
+            for (moved, rewritten, step) in points {
+                let label = format!("{rolling_back} {moved} {rewritten} {step:?}");
+                let (_temp, backend) = fixture().await;
+                let id = add(&backend, "old", SandboxStatus::Stopped).await;
+                let local = backend.as_local().unwrap();
+                let mut journal = crashed_journal(&backend, "old", "new").await;
+                let directory = local.sandboxes_dir();
+                if moved {
+                    std::fs::rename(directory.join("old"), directory.join("new")).unwrap();
+                }
+                if rewritten {
+                    rewrite_state_files(
+                        &directory.join("new"),
+                        &directory.join("old"),
+                        &directory.join("new"),
+                    )
+                    .unwrap();
+                }
+                journal.step = step;
+                journal.rolling_back = rolling_back;
+                write_journal(local, &journal).unwrap();
+                recover_for_names(local, &["new"]).await.unwrap();
+                let (name, other) = if rolling_back {
+                    ("old", "new")
+                } else {
+                    ("new", "old")
+                };
+                assert_eq!(
+                    name_of(&backend, id).await.as_deref(),
+                    Some(name),
+                    "{label}"
+                );
+                assert_named(local, name, other);
+                assert!(!journal_path(local, id).exists(), "{label}");
+                let row = find_by_id(local, id).await.unwrap().unwrap();
+                assert_eq!(stored_config(&row).spec.name, name, "{label}");
+            }
+        }
+    }
