new file mode 100644
index 0000000000000000000000000000000000000000..646e6a9ae59802c7289e7ffd6df5aa0cb888b0a2
--- /dev/null
+++ b/sdk/rust/lib/sandbox/rename.rs
@@ -0,0 +1,1407 @@
+//! Rename a stopped sandbox.
+//!
+//! A sandbox name lives in three places: the catalog row (`name`, and the `spec.name` inside the
+//! stored configuration), the sandbox directory `sandboxes/<name>`, and the per-name lock files
+//! under the run directory, which are derived from the name and never need to move. Everything
+//! else the runtime persists is keyed by the numeric sandbox id (runs, labels, root disk records,
+//! the snapshot ancestry cursor inside the sandbox directory) or is a relative path inside the
+//! sandbox directory, so it follows the directory.
+//!
+//! The runtime keeps one more thing under the old name: the root-disk record (`root-disk.json`
+//! beside the protected layout record, or under `runtime/` for storage that has not been migrated
+//! yet) holds the absolute path of every layer of the root disk and of its launch base, and a start
+//! refuses a record whose layer is not the configured one. The saved configuration can also name host
+//! paths below the sandbox directory. The rename rewrites exactly those fields (the fields that
+//! hold a host path, listed in `HOST_PATH_FIELDS` below), never a string that merely looks like
+//! such a path, such as a guest working directory or mount destination. The caller overrides saved
+//! beside the configuration carry a digest of it, so they are rewritten with it.
+//!
+//! The rename takes the transition, snapshot-ancestry and lifecycle locks of both names (in name
+//! order, so two opposite renames cannot wait on each other) and writes a journal that records
+//! the complete new configuration. Each step then runs in turn: the directory moves and the
+//! sandboxes directory is synced, the state files are rewritten, and the catalog row is updated.
+//! The journal records each step once it is confirmed and is removed only after the last one, so
+//! a process that dies in between, or a step that fails, leaves a journal whose recorded step
+//! says what remains. A step that fails before the catalog changed is undone the same way (the
+//! journal then says it is rolling back). The next rename or start of either name reads the
+//! journal while holding the locks and finishes or undoes the rename. Snapshot groups are labels
+//! chosen when a capture is taken and keep their name.
+
+use std::{
+    any::Any,
+    path::{Path, PathBuf},
+    sync::Arc,
+    time::Duration,
+};
+
+use sea_orm::{ColumnTrait, EntityTrait, QueryFilter, sea_query::Expr};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+use crate::backend::{Backend, LocalBackend};
+use crate::db::entity::sandbox as sandbox_entity;
+use crate::{MicrosandboxError, MicrosandboxResult};
+
+use super::{SandboxConfig, SandboxStatus};
+
+//--------------------------------------------------------------------------------------------------
+// Constants
+//--------------------------------------------------------------------------------------------------
+
+const JOURNAL_DIRECTORY: &str = "rename-journal";
+const JOURNAL_SCHEMA: u32 = 1;
+const STATE_FILE: &str = "root-disk.json";
+const LAYOUT_RECORD: &str = "state-layout.json";
+const STATE_FILE_LIMIT: u64 = 1024 * 1024;
+const RECOVERY_ROUNDS: usize = 8;
+
+/// The fields of the saved configuration that hold a host path which can lie below the sandbox
+/// directory. Each entry is a path of object keys; `*` visits every array element, and `[key=value]`
+/// keeps an object only when its `key` field equals `value`.
+const HOST_PATH_FIELDS: &[&str] = &[
+    "image.Bind.path",
+    "image.DiskImage.path",
+    "image.Oci.root_disk[kind=disk-image].path",
+    "mounts.*[type=Bind].host",
+    "mounts.*[type=DiskImage].host",
+    "patches.*.CopyFile.src",
+    "patches.*.CopyDir.src",
+    "vsock.routes.*.host_socket",
+    "checkpoint_restore.closure",
+    "network.tls.upstream_ca_cert.*",
+    "network.tls.scoped_upstream_ca_cert.*.path",
+    "network.tls.intercept_ca.cert_path",
+    "network.tls.intercept_ca.key_path",
+];
+
+//--------------------------------------------------------------------------------------------------
+// Types
+//--------------------------------------------------------------------------------------------------
+
+/// How far a rename has got. Each value is recorded only after its step is confirmed.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Step {
+    /// The journal is written; nothing has moved.
+    #[default]
+    Journaled,
+    /// The directory carries the new name and the sandboxes directory is synced.
+    DirectoryMoved,
+    /// The state files name the new directory.
+    StateRewritten,
+    /// The catalog row has the new name and configuration.
+    CatalogUpdated,
+}
+
+/// Everything needed to finish (or undo) a rename after the process that began it is gone.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Journal {
+    schema: u32,
+    /// Distinguishes this rename from a later one of the same sandbox.
+    #[serde(default)]
+    generation: String,
+    sandbox_id: i32,
+    old: String,
+    new: String,
+    config: String,
+    #[serde(default)]
+    caller_config_overrides: Option<String>,
+    active_config: Option<String>,
+    #[serde(default)]
+    step: Step,
+    /// The rename is being undone: the directory and state files go back to the old name.
+    #[serde(default)]
+    rolling_back: bool,
+}
+
+type Held = Vec<Box<dyn Any + Send>>;
+
+//--------------------------------------------------------------------------------------------------
+// Functions
+//--------------------------------------------------------------------------------------------------
+
+/// Rename a created, stopped or crashed local sandbox.
+pub(crate) async fn rename_stopped(
+    backend: Arc<dyn Backend>,
+    old: &str,
+    new: &str,
+) -> MicrosandboxResult<()> {
+    let invalid = |message: String| MicrosandboxError::InvalidConfig(message);
+    let local = backend
+        .as_local()
+        .ok_or_else(|| MicrosandboxError::local_only(crate::error::Operation::SandboxModify))?;
+    local.validate_sandbox_name_for_runtime(new)?;
+    if old == new {
+        return Err(invalid(
+            "the new name must differ from the current name".into(),
+        ));
+    }
+
+    let mut rounds = 0;
+    let (_held, handle, model) = loop {
+        recover_for_names(local, &[old, new]).await?;
+
+        // The handle reconciles a row left Running by a crashed runtime before the status check.
+        let handle = backend.sandboxes().get(backend.clone(), old).await?;
+        if !matches!(
+            handle.status_snapshot(),
+            SandboxStatus::Created | SandboxStatus::Stopped | SandboxStatus::Crashed
+        ) {
+            return Err(MicrosandboxError::SandboxStillRunning(format!(
+                "cannot rename sandbox {old:?}: stop it first"
+            )));
+        }
+
+        let held = acquire(local, &[old, new]).await?;
+        // A rename that began after the recovery above, and died, left a journal: finish it
+        // before reading the row.
+        if !pending_for_names(local, &[old, new])?.is_empty() {
+            drop(held);
+            rounds += 1;
+            if rounds >= RECOVERY_ROUNDS {
+                return Err(MicrosandboxError::Runtime(format!(
+                    "cannot rename sandbox {old:?}: another rename keeps being left unfinished"
+                )));
+            }
+            continue;
+        }
+        let model = find_by_name(local, old)
+            .await?
+            .ok_or_else(|| MicrosandboxError::SandboxNotFound(old.into()))?;
+        break (held, handle, model);
+    };
+    if let Some(state) = handle.local()
+        && state.db_id != model.id
+    {
+        return Err(MicrosandboxError::SandboxReplaced {
+            name: old.into(),
+            expected: format!("local:{}", state.db_id),
+            actual: format!("local:{}", model.id),
+        });
+    }
+    if !matches!(
+        model.status,
+        SandboxStatus::Created | SandboxStatus::Stopped | SandboxStatus::Crashed
+    ) {
+        return Err(MicrosandboxError::SandboxStillRunning(format!(
+            "cannot rename sandbox {old:?}: status is {:?}",
+            model.status
+        )));
+    }
+    if find_by_name(local, new).await?.is_some() {
+        return Err(MicrosandboxError::SandboxAlreadyExists(format!(
+            "sandbox '{new}' already exists"
+        )));
+    }
+    crate::backend::local::creation::require_complete(local.db().await?.read(), model.id, old)
+        .await?;
+    let sandboxes_dir = local.sandboxes_dir();
+    let old_dir = sandboxes_dir.join(old);
+    let new_dir = sandboxes_dir.join(new);
+    if std::fs::symlink_metadata(&new_dir).is_ok() {
+        return Err(MicrosandboxError::SandboxAlreadyExists(format!(
+            "sandbox '{new}' already exists"
+        )));
+    }
+    if !std::fs::symlink_metadata(&old_dir)?.is_dir() {
+        return Err(invalid(format!(
+            "the directory of sandbox {old:?} is missing"
+        )));
+    }
+
+    require_settled_layout(&old_dir)?;
+    let (config, caller_config_overrides) = rewrite_config(
+        &model.config,
+        model.caller_config_overrides.as_deref(),
+        new,
+        &old_dir,
+        &new_dir,
+    )?;
+    let mut journal = Journal {
+        schema: JOURNAL_SCHEMA,
+        generation: format!("{:032x}", rand::random::<u128>()),
+        sandbox_id: model.id,
+        old: old.into(),
+        new: new.into(),
+        config,
+        caller_config_overrides,
+        active_config: model
+            .active_config
+            .as_deref()
+            .map(|json| rewrite_config(json, None, new, &old_dir, &new_dir))
+            .transpose()?
+            .map(|(json, _)| json),
+        step: Step::Journaled,
+        rolling_back: false,
+    };
+    crate::runtime::remove_socket_artifacts_at(&local.config().run_dir(), &sandboxes_dir, old)?;
+    write_journal(local, &journal)?;
+    match advance(local, &mut journal).await {
+        Ok(()) => Ok(()),
+        Err(error) => {
+            // The journal stays unless every step of the undo is confirmed too; either way the
+            // next rename or start of either name finishes whichever direction it records.
+            let _ = undo_after_failure(local, &mut journal).await;
+            Err(error)
+        }
+    }
+}
+
+/// Finish or undo any interrupted rename that involves one of `names`.
+///
+/// The journals found by an unlocked scan only say which names to lock; each one is read again
+/// while holding the locks of its names, and acted on only if it is still the same rename.
+pub(crate) async fn recover_for_names(
+    local: &LocalBackend,
+    names: &[&str],
+) -> MicrosandboxResult<()> {
+    for _ in 0..RECOVERY_ROUNDS {
+        let candidates = pending_for_names(local, names)?;
+        if candidates.is_empty() {
+            return Ok(());
+        }
+        let mut changed = false;
+        for candidate in candidates {
+            changed |= recover_candidate(local, &candidate).await?;
+        }
+        if !changed {
+            return Ok(());
+        }
+    }
+    Err(MicrosandboxError::Runtime(
+        "a sandbox rename kept changing while it was being finished".into(),
+    ))
+}
+
+/// Lock the names of `candidate`, a journal read without any lock, read the journal again and
+/// carry it on only if it is still that rename. Returns whether a different rename of the same
+/// sandbox has taken its place, which the caller must look at in another round.
+async fn recover_candidate(local: &LocalBackend, candidate: &Journal) -> MicrosandboxResult<bool> {
+    let _held = acquire(local, &[&candidate.old, &candidate.new]).await?;
+    // Another process may have finished it, or finished it and begun a different rename of the
+    // same sandbox, while this one waited for the locks.
+    let Some(mut journal) = read_journal(local, candidate.sandbox_id)? else {
+        return Ok(false);
+    };
+    if journal.generation != candidate.generation
+        || journal.old != candidate.old
+        || journal.new != candidate.new
+    {
+        return Ok(true);
+    }
+    advance(local, &mut journal).await?;
+    Ok(false)
+}
+
+/// The journals, read without any lock, that involve one of `names`.
+fn pending_for_names(local: &LocalBackend, names: &[&str]) -> MicrosandboxResult<Vec<Journal>> {
+    let directory = journal_directory(local);
+    let entries = match std::fs::read_dir(&directory) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(error) => return Err(error.into()),
+    };
+    let mut pending = Vec::new();
+    for entry in entries {
+        let path = entry?.path();
+        if path.extension().and_then(|extension| extension.to_str()) != Some("json") {
+            continue;
+        }
+        let bytes = match std::fs::read(&path) {
+            Ok(bytes) => bytes,
+            // Finished by another process since the directory was listed.
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(error) => return Err(error.into()),
+        };
+        let journal: Journal = serde_json::from_slice(&bytes)?;
+        if journal.schema == JOURNAL_SCHEMA
+            && names
+                .iter()
+                .any(|name| *name == journal.old || *name == journal.new)
+        {
+            pending.push(journal);
+        }
+    }
+    Ok(pending)
+}
+
+/// Carry a journaled rename to its end in the direction the journal records, with the locks of
+/// both names held.
+async fn advance(local: &LocalBackend, journal: &mut Journal) -> MicrosandboxResult<()> {
+    if !journal.rolling_back && journal.step == Step::Journaled {
+        let sandboxes_dir = local.sandboxes_dir();
+        let old_present = std::fs::symlink_metadata(sandboxes_dir.join(&journal.old)).is_ok();
+        let row = find_by_id(local, journal.sandbox_id).await?;
+        let still_old = row.is_some_and(|row| row.name == journal.old);
+        // Another sandbox took the new name before this one's directory moved: abandon the
+        // rename, which leaves the sandbox under its old name.
+        if still_old && old_present && find_by_name(local, &journal.new).await?.is_some() {
+            journal.rolling_back = true;
+            write_journal(local, journal)?;
+        }
+    }
+    if journal.rolling_back {
+        roll_back(local, journal).await
+    } else {
+        roll_forward(local, journal).await
+    }
+}
+
+/// After a failed step: if the catalog still has the old name, record that the rename is being
+/// undone and undo it.
+async fn undo_after_failure(local: &LocalBackend, journal: &mut Journal) -> MicrosandboxResult<()> {
+    let row = find_by_id(local, journal.sandbox_id).await?;
+    if row.is_some_and(|row| row.name == journal.new) {
+        // The row changed even though its update reported a failure: keep going forward.
+        return roll_forward(local, journal).await;
+    }
+    journal.rolling_back = true;
+    write_journal(local, journal)?;
+    roll_back(local, journal).await
+}
+
+/// Move the directory, rewrite the state files and update the row; remove the journal last.
+async fn roll_forward(local: &LocalBackend, journal: &mut Journal) -> MicrosandboxResult<()> {
+    let sandboxes_dir = local.sandboxes_dir();
+    let old_dir = sandboxes_dir.join(&journal.old);
+    let new_dir = sandboxes_dir.join(&journal.new);
+
+    if journal.step < Step::DirectoryMoved {
+        let old_present = std::fs::symlink_metadata(&old_dir).is_ok();
+        let new_present = std::fs::symlink_metadata(&new_dir).is_ok();
+        match (old_present, new_present) {
+            (true, false) => std::fs::rename(&old_dir, &new_dir)?,
+            // Moved by an earlier attempt that died before it could sync.
+            (false, true) => {}
+            _ => return Err(inconsistent(journal, &old_dir, &new_dir)),
+        }
+        sync_directory(&sandboxes_dir)?;
+        set_step(local, journal, Step::DirectoryMoved)?;
+    }
+    if journal.step < Step::StateRewritten {
+        rewrite_state_files(&new_dir, &old_dir, &new_dir)?;
+        set_step(local, journal, Step::StateRewritten)?;
+    }
+    if journal.step < Step::CatalogUpdated {
+        match find_by_id(local, journal.sandbox_id).await? {
+            // The sandbox is gone; nothing remains to finish.
+            None => return remove_journal(local, journal),
+            Some(row) if row.name == journal.new => {}
+            Some(row) if row.name == journal.old => update_row(local, journal).await?,
+            Some(row) => {
+                return Err(MicrosandboxError::Runtime(format!(
+                    "rename journal for sandbox {} names {:?} and {:?}, but the sandbox is {:?}",
+                    journal.sandbox_id, journal.old, journal.new, row.name
+                )));
+            }
+        }
+        set_step(local, journal, Step::CatalogUpdated)?;
+    }
+    remove_journal(local, journal)
+}
+
+/// Put the directory and the state files back under the old name; remove the journal last.
+async fn roll_back(local: &LocalBackend, journal: &mut Journal) -> MicrosandboxResult<()> {
+    let sandboxes_dir = local.sandboxes_dir();
+    let old_dir = sandboxes_dir.join(&journal.old);
+    let new_dir = sandboxes_dir.join(&journal.new);
+
+    match find_by_id(local, journal.sandbox_id).await? {
+        None => return remove_journal(local, journal),
+        // The row changed after all: the rename is complete, so complete it.
+        Some(row) if row.name == journal.new => {
+            journal.rolling_back = false;
+            write_journal(local, journal)?;
+            return roll_forward(local, journal).await;
+        }
+        Some(row) if row.name == journal.old => {}
+        Some(row) => {
+            return Err(MicrosandboxError::Runtime(format!(
+                "rename journal for sandbox {} names {:?} and {:?}, but the sandbox is {:?}",
+                journal.sandbox_id, journal.old, journal.new, row.name
+            )));
+        }
+    }
+    let old_present = std::fs::symlink_metadata(&old_dir).is_ok();
+    let new_present = std::fs::symlink_metadata(&new_dir).is_ok();
+    match (old_present, new_present) {
+        (false, true) => std::fs::rename(&new_dir, &old_dir)?,
+        (true, false) => {}
+        // Nothing moved yet and another sandbox owns the new name's directory: leave both.
+        (true, true) if journal.step == Step::Journaled => return remove_journal(local, journal),
+        _ => return Err(inconsistent(journal, &old_dir, &new_dir)),
+    }
+    sync_directory(&sandboxes_dir)?;
+    rewrite_state_files(&old_dir, &new_dir, &old_dir)?;
+    remove_journal(local, journal)
+}
+
+fn inconsistent(journal: &Journal, old_dir: &Path, new_dir: &Path) -> MicrosandboxError {
+    MicrosandboxError::Runtime(format!(
+        "cannot finish renaming sandbox {:?}: the directories {} and {} are inconsistent",
+        journal.old,
+        old_dir.display(),
+        new_dir.display()
+    ))
+}
+
+async fn acquire(local: &LocalBackend, names: &[&str]) -> MicrosandboxResult<Held> {
+    let run_dir = local.config().run_dir();
+    let mut ordered: Vec<&str> = names.to_vec();
+    ordered.sort_unstable();
+    ordered.dedup();
+    let mut held: Held = Vec::new();
+    for name in &ordered {
+        held.push(Box::new(
+            LocalBackend::acquire_sandbox_transition_guard(&run_dir, name).await?,
+        ));
+    }
+    for name in &ordered {
+        held.push(Box::new(
+            crate::snapshot::lineage::lock_source(&run_dir, name).await?,
+        ));
+    }
+    for name in &ordered {
+        held.push(Box::new(
+            crate::runtime::acquire_sandbox_lifecycle_guard(&run_dir, name, Duration::from_secs(5))
+                .await?,
+        ));
+    }
+    Ok(held)
+}
