+
+async fn update_row(local: &LocalBackend, journal: &Journal) -> MicrosandboxResult<()> {
+    let pools = local.db().await?;
+    pools
+        .write()
+        .transaction(|txn| {
+            let config = journal.config.clone();
+            let caller_config_overrides = journal.caller_config_overrides.clone();
+            let active_config = journal.active_config.clone();
+            let new = journal.new.clone();
+            let old = journal.old.clone();
+            let id = journal.sandbox_id;
+            async move {
+                let result = sandbox_entity::Entity::update_many()
+                    .col_expr(sandbox_entity::Column::Name, Expr::value(new))
+                    .col_expr(sandbox_entity::Column::Config, Expr::value(config))
+                    .col_expr(
+                        sandbox_entity::Column::CallerConfigOverrides,
+                        Expr::value(caller_config_overrides),
+                    )
+                    .col_expr(
+                        sandbox_entity::Column::ActiveConfig,
+                        Expr::value(active_config),
+                    )
+                    .col_expr(
+                        sandbox_entity::Column::UpdatedAt,
+                        Expr::value(chrono::Utc::now().naive_utc()),
+                    )
+                    .filter(sandbox_entity::Column::Id.eq(id))
+                    .filter(sandbox_entity::Column::Name.eq(old.as_str()))
+                    .exec(&txn)
+                    .await?;
+                if result.rows_affected != 1 {
+                    return Err(MicrosandboxError::SandboxNotFound(old));
+                }
+                Ok((txn, ()))
+            }
+        })
+        .await
+}
+
+/// Set the new name and move the host paths below the old sandbox directory to the new one, in
+/// the saved configuration and in the caller overrides saved beside it.
+fn rewrite_config(
+    json: &str,
+    caller_config_overrides_json: Option<&str>,
+    new: &str,
+    old_dir: &Path,
+    new_dir: &Path,
+) -> MicrosandboxResult<(String, Option<String>)> {
+    let mut config = SandboxConfig::from_stored(json, caller_config_overrides_json)?;
+    config.spec.name = new.into();
+    let mut value = serde_json::to_value(&config)?;
+    for field in HOST_PATH_FIELDS {
+        move_field(&mut value, &parse_field(field), old_dir, new_dir);
+    }
+    let rewritten = serde_json::to_string(&value)?;
+
+    // The overrides record the digest of the configuration they belong to; without a new one a
+    // later edit would stop applying them.
+    let caller_config_overrides = match config.caller_config_overrides.take() {
+        Some(patch) => {
+            let mut patch_value = serde_json::to_value(&*patch)?;
+            if let Some(name) = patch_value
+                .get_mut("spec")
+                .and_then(|spec| spec.get_mut("name"))
+                .filter(|name| name.is_string())
+            {
+                *name = Value::String(new.into());
+            }
+            for field in HOST_PATH_FIELDS {
+                let parts = parse_field(field);
+                if let Some(spec) = patch_value.get_mut("spec") {
+                    move_field(spec, &parts, old_dir, new_dir);
+                }
+            }
+            config.caller_config_overrides = Some(Box::new(serde_json::from_value(patch_value)?));
+            config.caller_config_overrides_json(&rewritten)?
+        }
+        None => None,
+    };
+    Ok((rewritten, caller_config_overrides))
+}
+
+/// One component of a `HOST_PATH_FIELDS` entry.
+enum Part<'a> {
+    Key(&'a str),
+    Each,
+    /// Keep the element only if `key` of the object is `value`.
+    Where(&'a str, &'a str),
+}
+
+fn parse_field(field: &str) -> Vec<Part<'_>> {
+    let mut parts = Vec::new();
+    for component in field.split('.') {
+        let (key, filter) = match component.split_once('[') {
+            Some((key, rest)) => (key, rest.strip_suffix(']')),
+            None => (component, None),
+        };
+        parts.push(if key == "*" {
+            Part::Each
+        } else {
+            Part::Key(key)
+        });
+        if let Some((tag, value)) = filter.and_then(|filter| filter.split_once('=')) {
+            parts.push(Part::Where(tag, value));
+        }
+    }
+    parts
+}
+
+/// Rewrite the string at `parts` below `value` if it is a path below `old_dir`.
+fn move_field(value: &mut Value, parts: &[Part<'_>], old_dir: &Path, new_dir: &Path) -> bool {
+    let Some((part, rest)) = parts.split_first() else {
+        return move_path(value, old_dir, new_dir);
+    };
+    match part {
+        Part::Key(key) => value
+            .as_object_mut()
+            .and_then(|map| map.get_mut(*key))
+            .is_some_and(|child| move_field(child, rest, old_dir, new_dir)),
+        Part::Each => value.as_array_mut().is_some_and(|items| {
+            items.iter_mut().fold(false, |changed, item| {
+                move_field(item, rest, old_dir, new_dir) | changed
+            })
+        }),
+        Part::Where(key, expected) => {
+            value.get(*key).and_then(Value::as_str) == Some(*expected)
+                && move_field(value, rest, old_dir, new_dir)
+        }
+    }
+}
+
+/// Replace a string that is a path at or below `old_dir` with the same path below `new_dir`.
+fn move_path(value: &mut Value, old_dir: &Path, new_dir: &Path) -> bool {
+    let Value::String(text) = value else {
+        return false;
+    };
+    let Ok(rest) = Path::new(text.as_str()).strip_prefix(old_dir) else {
+        return false;
+    };
+    let moved = if rest.as_os_str().is_empty() {
+        new_dir.to_path_buf()
+    } else {
+        new_dir.join(rest)
+    };
+    *text = moved.to_string_lossy().into_owned();
+    true
+}
+
+/// Rewrites the paths below `from` to `to` in the root-disk records of the sandbox (the
+/// `launch_base` and the `path` of every layer). Repeating it changes nothing.
+fn rewrite_state_files(sandbox_dir: &Path, from: &Path, to: &Path) -> MicrosandboxResult<()> {
+    for path in [
+        sandbox_dir.join(STATE_FILE),
+        sandbox_dir.join("runtime").join(STATE_FILE),
+    ] {
+        rewrite_state_file(&path, from, to)?;
+    }
+    Ok(())
+}
+
+fn rewrite_state_file(path: &Path, from: &Path, to: &Path) -> MicrosandboxResult<()> {
+    use std::io::Write;
+    let metadata = match std::fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error.into()),
+    };
+    if !metadata.is_file() || metadata.len() > STATE_FILE_LIMIT {
+        return Ok(());
+    }
+    let Ok(mut value) = serde_json::from_slice::<Value>(&std::fs::read(path)?) else {
+        return Ok(());
+    };
+    let mut changed = value
+        .get_mut("launch_base")
+        .is_some_and(|base| move_path(base, from, to));
+    if let Some(Value::Array(layers)) = value.get_mut("layers") {
+        for layer in layers {
+            changed |= layer
+                .get_mut("path")
+                .is_some_and(|layer_path| move_path(layer_path, from, to));
+        }
+    }
+    if changed {
+        let parent = path.parent().expect("state file has a directory");
+        let mut staged = tempfile::NamedTempFile::new_in(parent)?;
+        staged.write_all(&serde_json::to_vec(&value)?)?;
+        staged.as_file().sync_all()?;
+        staged
+            .persist(path)
+            .map_err(|error| MicrosandboxError::Io(error.error))?;
+        sync_directory(parent)?;
+    }
+    Ok(())
+}
+
+/// Refuse a sandbox whose protected layout is still being prepared: that record keeps the
+/// configured disk path it was prepared for.
+fn require_settled_layout(sandbox_dir: &Path) -> MicrosandboxResult<()> {
+    let path = sandbox_dir.join(LAYOUT_RECORD);
+    let preparing = match std::fs::read(&path) {
+        Ok(bytes) => serde_json::from_slice::<Value>(&bytes)
+            .ok()
+            .and_then(|record| {
+                record
+                    .get("phase")
+                    .and_then(Value::as_str)
+                    .map(str::to_owned)
+            })
+            .is_none_or(|phase| phase != "ready"),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => false,
+        Err(error) => return Err(error.into()),
+    };
+    if preparing {
+        return Err(MicrosandboxError::InvalidConfig(
+            "the sandbox's storage migration has not finished; start it or repair it before renaming"
+                .into(),
+        ));
+    }
+    Ok(())
+}
+
+fn journal_directory(local: &LocalBackend) -> PathBuf {
+    local.config().home().join(JOURNAL_DIRECTORY)
+}
+
+fn journal_path(local: &LocalBackend, sandbox_id: i32) -> PathBuf {
+    journal_directory(local).join(format!("{sandbox_id}.json"))
+}
+
+fn read_journal(local: &LocalBackend, sandbox_id: i32) -> MicrosandboxResult<Option<Journal>> {
+    match std::fs::read(journal_path(local, sandbox_id)) {
+        Ok(bytes) => Ok(Some(serde_json::from_slice(&bytes)?)),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error.into()),
+    }
+}
+
+fn write_journal(local: &LocalBackend, journal: &Journal) -> MicrosandboxResult<()> {
+    use std::io::Write;
+    let directory = journal_directory(local);
+    std::fs::create_dir_all(&directory)?;
+    let mut staged = tempfile::NamedTempFile::new_in(&directory)?;
+    staged.write_all(&serde_json::to_vec(journal)?)?;
+    staged.as_file().sync_all()?;
+    staged
+        .persist(journal_path(local, journal.sandbox_id))
+        .map_err(|error| MicrosandboxError::Io(error.error))?;
+    sync_directory(&directory)
+}
+
+fn set_step(local: &LocalBackend, journal: &mut Journal, step: Step) -> MicrosandboxResult<()> {
+    journal.step = step;
+    write_journal(local, journal)
+}
+
+/// Remove the journal of this rename. The caller holds the locks of both names, so the file is
+/// still this rename's; a journal of another generation is left alone.
+fn remove_journal(local: &LocalBackend, journal: &Journal) -> MicrosandboxResult<()> {
+    match read_journal(local, journal.sandbox_id)? {
+        Some(current) if current.generation == journal.generation => {
+            std::fs::remove_file(journal_path(local, journal.sandbox_id))?;
+        }
+        _ => {}
+    }
+    // A sync that fails here only risks the removal being undone by a crash; the journal then
+    // finds every step complete and is removed again.
+    let _ = sync_directory(&journal_directory(local));
+    Ok(())
+}
+
+fn sync_directory(path: &Path) -> MicrosandboxResult<()> {
+    #[cfg(test)]
+    tests::inject_sync_failure(path)?;
+    #[cfg(unix)]
+    std::fs::File::open(path)?.sync_all()?;
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
