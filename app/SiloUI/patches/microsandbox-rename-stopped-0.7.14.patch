+    use std::{cell::RefCell, path::PathBuf};
+
+    thread_local! {
+        static SYNC_FAULT: RefCell<Option<(PathBuf, usize)>> = const { RefCell::new(None) };
+    }
+
+    /// Called by `sync_directory`: fail the next `count` syncs of `path` when armed.
+    pub(super) fn inject_sync_failure(path: &Path) -> MicrosandboxResult<()> {
+        SYNC_FAULT.with(|fault| {
+            let mut fault = fault.borrow_mut();
+            if let Some((target, remaining)) = fault.as_mut()
+                && target == path
+                && *remaining > 0
+            {
+                *remaining -= 1;
+                return Err(MicrosandboxError::Io(std::io::Error::other(
+                    "injected sync failure",
+                )));
+            }
+            Ok(())
+        })
+    }
+
+    fn fail_syncs_of(path: PathBuf, count: usize) {
+        SYNC_FAULT.with(|fault| *fault.borrow_mut() = Some((path, count)));
+    }
+
+    fn assert_named(local: &LocalBackend, name: &str, other: &str) {
+        let directory = local.sandboxes_dir();
+        assert!(directory.join(name).join("marker").is_file(), "{name}");
+        assert!(!directory.join(other).exists(), "{other}");
+        for record in ["root-disk.json", "runtime/root-disk.json"] {
+            let state = std::fs::read_to_string(directory.join(name).join(record)).unwrap();
+            assert!(state.contains(&directory.join(name).to_string_lossy().into_owned()));
+            assert!(!state.contains(&directory.join(other).to_string_lossy().into_owned()));
+        }
+    }
