+            .await
+            .unwrap_err();
+        assert!(error.to_string().contains("storage migration"), "{error}");
+        for (id, name) in [(pending, "pending"), (migrating, "migrating")] {
+            assert_eq!(name_of(&backend, id).await.as_deref(), Some(name));
+            assert!(local.sandboxes_dir().join(name).join("marker").is_file());
+            assert!(!journal_path(local, id).exists());
+        }
+    }
