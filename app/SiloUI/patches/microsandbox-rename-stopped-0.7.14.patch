+    #[tokio::test]
+    async fn a_stale_reader_leaves_a_later_rename_of_the_same_sandbox_alone() {
+        let (_temp, backend) = fixture().await;
+        let id = add(&backend, "a", SandboxStatus::Stopped).await;
+        let local = backend.as_local().unwrap();
+        // One process reads the journal of a -> b without a lock...
+        let stale = crashed_journal(&backend, "a", "b").await;
+        // ...another finishes it and begins b -> c, which also dies.
+        recover_for_names(local, &["a"]).await.unwrap();
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("b"));
+        let later = crashed_journal(&backend, "b", "c").await;
+
+        let changed = recover_candidate(local, &stale).await.unwrap();
+        assert!(changed, "the journal of a different rename took its place");
+        let kept = read_journal(local, id)
+            .unwrap()
+            .expect("later journal kept");
+        assert_eq!(kept.generation, later.generation);
+        assert_eq!((kept.old.as_str(), kept.new.as_str()), ("b", "c"));
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("b"));
+        assert!(local.sandboxes_dir().join("b/marker").is_file());
+
+        // Removing with the stale journal is also refused.
+        remove_journal(local, &stale).unwrap();
+        assert!(journal_path(local, id).is_file());
+
+        // The rounds in recover_for_names pick the later rename up under its own locks.
+        recover_for_names(local, &["b"]).await.unwrap();
+        assert_eq!(name_of(&backend, id).await.as_deref(), Some("c"));
+        assert!(!journal_path(local, id).exists());
+    }
