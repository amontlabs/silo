+impl SecretsSession {
+    /// Snapshot used by the TCP proxy task for this generation.
+    pub(crate) fn snapshot(&self) -> Arc<SecretsConfig> {
+        self.snapshot.clone()
+    }
+
+    /// Wait until this session's generation is revoked.
+    pub(crate) async fn changed(&mut self) -> Result<(), tokio::sync::watch::error::RecvError> {
+        self.changes.changed().await
+    }
+}
+
+impl Drop for SecretsSession {
+    fn drop(&mut self) {
+        let mut state = self
+            .shared
+            .state
+            .lock()
+            .expect("secrets state lock poisoned");
+        if let Some(active) = state.active_sessions.get_mut(&self.generation) {
+            *active -= 1;
+            if *active == 0 {
+                state.active_sessions.remove(&self.generation);
+            }
+        }
+        drop(state);
+        let tick = self
+            .shared
+            .drain_generation
+            .fetch_add(1, Ordering::SeqCst)
+            .wrapping_add(1);
+        self.shared.drain_changes.send_replace(tick);
+    }
+}
+
+fn publish_legacy(shared: &SecretsShared, state: &mut SecretsState, config: SecretsConfig) {
+    state.snapshot = Arc::new(config);
+    state.generation = state.generation.wrapping_add(1);
+    shared.generation_changes.send_replace(state.generation);
+    shared.legacy_changes.send_replace(());
+}
