+/// Create the capture root and reclaim what an earlier runtime process left in it.
+///
+/// This is the first thing `open` does, so the sweep finishes before the executor accepts a
+/// capture of this process.
+fn prepare_capture_root(host: &Path) -> Result<PathBuf, String> {
+    let root = host.join("checkpoints");
+    std::fs::create_dir_all(&root).map_err(|error| error.to_string())?;
+    reclaim_stale_captures(&root);
+    Ok(root)
+}
+
+/// Remove capture directories left by an earlier runtime process.
+///
+/// A capture directory holds hard links to its layer closure, so keeping one pins disk blocks
+/// that compaction and snapshot removal would otherwise return. Clients reclaim a directory once
+/// they have published from it, and hold a lock inside it while they do; a directory whose lock
+/// is held by another process is being published from and stays. What is left was abandoned by a
+/// crash or by a failed client, including a capture whose source failed to resume.
+fn reclaim_stale_captures(root: &Path) {
+    use microsandbox_utils::process_lock::{open_lock_file, try_lock_exclusive};
+
+    let entries = match std::fs::read_dir(root) {
+        Ok(entries) => entries,
+        Err(error) => {
+            tracing::warn!(%error, "failed to list stale checkpoint captures");
+            return;
+        }
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let removed = match entry.file_type() {
+            Ok(kind) if kind.is_dir() => {
+                let lock = open_lock_file(&path.join(super::CAPTURE_PUBLISHING_LOCK))
+                    .and_then(|file| try_lock_exclusive(&file).map(|held| held.then_some(file)));
+                match lock {
+                    Ok(Some(_lock)) => std::fs::remove_dir_all(&path),
+                    Ok(None) => {
+                        tracing::info!(path = %path.display(), "checkpoint capture is being published; kept");
+                        continue;
+                    }
+                    Err(error) => Err(error),
+                }
+            }
+            Ok(_) => std::fs::remove_file(&path),
+            Err(error) => Err(error),
+        };
+        if let Err(error) = removed {
+            tracing::warn!(%error, path = %path.display(), "failed to remove stale checkpoint capture");
+        }
+    }
+}
