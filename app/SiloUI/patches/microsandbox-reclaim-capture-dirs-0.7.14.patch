+impl CaptureDir {
+    /// Take ownership of the capture directory the runtime reported for this operation.
+    ///
+    /// Only the directory this operation's own identity names is adopted: a locator the runtime
+    /// returned for anything else is never removed.
+    fn adopt(expected: PathBuf, returned: &Path, source_recovery: Option<&str>) -> Self {
+        if source_recovery.is_some() || returned != expected {
+            return Self::retained();
+        }
+        let lock = std::fs::create_dir_all(&expected)
+            .and_then(|()| {
+                microsandbox_utils::process_lock::open_lock_file(
+                    &expected.join(microsandbox_runtime::checkpoint::CAPTURE_PUBLISHING_LOCK),
+                )
+            })
+            .and_then(|file| {
+                microsandbox_utils::process_lock::try_lock_exclusive(&file)
+                    .map(|held| held.then_some(file))
+            });
+        let lock = match lock {
+            Ok(lock) => lock,
+            Err(error) => {
+                tracing::warn!(%error, path = %expected.display(), "failed to lock checkpoint capture");
+                None
+            }
+        };
+        Self {
+            path: Some(expected),
+            _lock: lock,
+        }
+    }
+
+    fn retained() -> Self {
+        Self {
+            path: None,
+            _lock: None,
+        }
+    }
+}
+
+impl Drop for CaptureDir {
+    fn drop(&mut self) {
+        // The lock outlives the removal: its file closes with this value's fields.
+        if let Some(path) = self.path.take()
+            && let Err(error) = std::fs::remove_dir_all(&path)
+            && error.kind() != std::io::ErrorKind::NotFound
+        {
+            tracing::warn!(%error, path = %path.display(), "failed to remove published checkpoint capture");
+        }
+    }
+}
