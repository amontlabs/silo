+    /// A 0.7.6 fork of a running sandbox with a sealed qcow2 layer links that layer into the child
+    /// as `layer_<id>.qcow2`; both directions must account it as the sealed root alias it is.
+    #[test]
+    fn fork_child_layer_named_by_journal_id_is_a_sealed_root_alias() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let rows = [record(1, "parent"), record(2, "child")];
+        let parent_bindings = initialize(&root, &rows[0], true);
+        let child_bindings = initialize(&root, &rows[1], false);
+        share_base(&root, "parent", "child");
+        // Parent chain: upper.ext4 <- sealed <- head. Its `initialize` layer is the sealed one here.
+        let sealed = root
+            .join("parent")
+            .join(format!("upper-{}.qcow2", "b".repeat(32)));
+        let head = root
+            .join("parent")
+            .join(format!("upper-{}.qcow2", "e".repeat(32)));
+        fs::write(&head, vec![23; 65536]).unwrap();
+        let journal_path = root.join("parent/runtime/root-disk.json");
+        let mut journal: serde_json::Value =
+            serde_json::from_slice(&fs::read(&journal_path).unwrap()).unwrap();
+        journal["layers"]
+            .as_array_mut()
+            .unwrap()
+            .push(serde_json::json!({
+                "layer_id": format!("layer_{}", "e".repeat(32)), "path": head,
+                "format": "qcow2", "integrity_root": null
+            }));
+        fs::write(&journal_path, serde_json::to_vec(&journal).unwrap()).unwrap();
+        let linked = root
+            .join("child")
+            .join(format!("layer_{}.qcow2", "b".repeat(32)));
+        fs::hard_link(&sealed, &linked).unwrap();
+        let restore = root
+            .join("child")
+            .join("upper-restore-0123456789abcdef.qcow2");
+        fs::write(&restore, vec![24; 65536]).unwrap();
+        fs::write(root.join("child/runtime/root-disk.json"), serde_json::to_vec(&serde_json::json!({
+            "schema":"microsandbox.runtime-root-disk/1", "volume_id":format!("vol_{}", "d".repeat(32)),
+            "device_id":"vdb", "layout":"managed-upper", "published_generation":0,
+            "layers":[
+                {"layer_id":format!("layer_{}", "a".repeat(32)), "path":root.join("child/upper.ext4"), "format":"raw", "integrity_root":null},
+                {"layer_id":format!("layer_{}", "b".repeat(32)), "path":linked, "format":"qcow2", "integrity_root":null},
+                {"layer_id":format!("layer_{}", "f".repeat(32)), "path":restore, "format":"qcow2", "integrity_root":null}
+            ]
+        })).unwrap()).unwrap();
+        for (current, bindings) in [(1, &parent_bindings), (2, &child_bindings)] {
+            let report =
+                discover(&root, &root.join("volumes"), current, bindings, &rows, &[]).unwrap();
+            assert!(
+                report.reasons.is_empty(),
+                "current {current}: {:?}",
+                report.reasons
+            );
+            assert!(
+                report
+                    .aliases
+                    .iter()
+                    .any(|alias| alias.path == linked || alias.path == sealed)
+            );
+        }
+        // The head is still never shared: a writable head aliased into the child stays refused.
+        fs::remove_file(&restore).unwrap();
+        fs::hard_link(&head, &restore).unwrap();
+        let report = discover(
+            &root,
+            &root.join("volumes"),
+            1,
+            &parent_bindings,
+            &rows,
+            &[],
+        )
+        .unwrap();
+        assert!(
+            report
+                .reasons
+                .iter()
+                .any(|reason| reason.contains("unsealed")),
+            "{:?}",
+            report.reasons
+        );
+    }
+
