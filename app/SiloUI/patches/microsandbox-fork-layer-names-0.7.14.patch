     if format == "raw" {
         return name == if flat { "rootfs.raw" } else { "upper.ext4" };
     }
+    // A fork or restore of a sandbox whose chain has sealed qcow2 layers hard-links each ancestor
+    // into the child's directory under its journal layer id (`layer_<32 hex>.qcow2`).
+    if format == "qcow2"
+        && name
+            .strip_suffix(".qcow2")
+            .and_then(|s| s.strip_prefix("layer_"))
+            .is_some_and(hex32)
