+/// Accept mode for a TCP SYN to a DNS port.
+///
+/// The DNS interceptor answers connections to the gateway itself without a
+/// network egress check. A connection to any other address is a regular
+/// outbound flow: if policy denies it the guest gets a reset instead of a
+/// handshake with a resolver it may not reach.
+fn dns_accept_mode(
+    dst: SocketAddr,
+    gateway: GatewayIps,
+    network_policy: &NetworkPolicy,
+    platform_policy: Option<&NetworkPolicy>,
+    shared: &SharedState,
+    intercepted: TcpAcceptMode,
+) -> TcpAcceptMode {
+    let to_gateway = match dst.ip() {
+        IpAddr::V4(ip) => gateway.ipv4 == Some(ip),
+        IpAddr::V6(ip) => gateway.ipv6 == Some(ip),
+    };
+    if to_gateway {
+        return intercepted;
+    }
+    let platform_allows = platform_policy.is_none_or(|policy| {
+        policy
+            .evaluate_egress(dst, Protocol::Tcp, shared)
+            .is_allow()
+    });
+    let denied = matches!(
+        network_policy.evaluate_egress_with_source(
+            dst,
+            Protocol::Tcp,
+            shared,
+            HostnameSource::Deferred,
+        ),
+        EgressEvaluation::Deny
+    );
+    if platform_allows && !denied {
+        intercepted
+    } else {
+        TcpAcceptMode::Reject
+    }
+}
