+    /// Send a SYN to `dst:port` under an allowlist (default HTTP settings,
+    /// intercepted port 443, DNS interception on) and return the reply's
+    /// (syn, rst) flags.
+    fn syn_reply_flags(dst: [u8; 4], port: u16) -> (bool, bool) {
+        use crate::policy::{Action, Destination, PortRange, Protocol, Rule};
+
+        let _ = rustls::crypto::ring::default_provider().install_default();
+        let mut allow_host =
+            Rule::allow_egress(Destination::Domain("example.com".parse().unwrap()));
+        allow_host.protocols = vec![Protocol::Tcp];
+        allow_host.ports = vec![PortRange::single(443)];
+        let policy = NetworkPolicy {
+            default_egress: Action::Deny,
+            default_ingress: Action::Allow,
+            rules: vec![Rule::allow_dns(), allow_host],
+        };
+        let shared = Arc::new(SharedState::new(256));
+        shared.set_http_config(crate::config::NetworkConfig::default().http);
+        let secrets = SecretsHandle::new(Default::default());
+        let tls_state = Arc::new(
+            TlsState::new(microsandbox_types::TlsConfig::default(), secrets.clone()).unwrap(),
+        );
+        assert!(tls_state.config.intercepted_ports.contains(&443));
+
+        let loop_shared = shared.clone();
+        std::thread::spawn(move || {
+            let runtime = tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+                .unwrap();
+            smoltcp_poll_loop(
+                loop_shared,
+                leak_poll_config(),
+                policy,
+                None,
+                DnsConfig::default(),
+                Some(tls_state),
+                BoundPublishedPorts::default(),
+                mpsc::channel().1,
+                false,
+                None,
+                None,
+                None,
+                runtime.handle().clone(),
+                secrets,
+                None,
+            );
+        });
+        shared
+            .tx_ring
+            .push(build_arp_request_frame(GUEST_MAC, GUEST_IP, GATEWAY_IP))
+            .unwrap();
+        shared
+            .tx_ring
+            .push(build_tcp_frame_to(
+                dst,
+                40000,
+                port,
+                TcpControl::Syn,
+                1000,
+                None,
+                &[],
+            ))
+            .unwrap();
+        shared.tx_wake.wake();
+
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        let reply = loop {
+            if let Some(reply) = last_tcp_reply(&shared) {
+                break reply;
+            }
+            assert!(std::time::Instant::now() < deadline, "no reply to the SYN");
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        };
+        let (_, _, syn, _, rst) = reply;
+        (syn, rst)
+    }
