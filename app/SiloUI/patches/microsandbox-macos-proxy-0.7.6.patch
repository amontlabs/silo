+        || host.len() > 253
+        || host.starts_with('.')
+        || host.ends_with('.')
+    {
+        return false;
+    }
+    let labels_valid = host.split('.').all(|label| {
+        !label.is_empty()
+            && label.len() <= 63
+            && label.as_bytes()[0].is_ascii_alphanumeric()
+            && label.as_bytes()[label.len() - 1].is_ascii_alphanumeric()
+            && label
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-')
+    });
+    labels_valid && (!wildcard || host.contains('.'))
+}
+
+fn valid_json(value: &str) -> bool {
+    serde_json::from_str::<serde::de::IgnoredAny>(value).is_ok()
+}
+
+fn invalid_update(name: &str) -> SecretsUpdateError {
+    SecretsUpdateError::InvalidUpdate {
+        name: name.to_string(),
     }
 }
 
