+/// One-time conversion of an external raw ext4 disk into a sandbox-owned disk.
+///
+/// The sandbox must be inactive. The disk is copied and verified before the owned mount replaces
+/// the external one, and the external image is retained.
+pub(crate) async fn adopt_disk_as_owned(
+    backend: Arc<dyn Backend>,
+    name: &str,
+    guest: &str,
+    source_override: Option<&Path>,
+) -> MicrosandboxResult<()> {
+    let invalid = |message: &str| MicrosandboxError::InvalidConfig(message.into());
+    if guest != "/workspace" {
+        return Err(invalid("only the /workspace disk can be adopted"));
+    }
+    let local = backend
+        .as_local()
+        .ok_or_else(|| MicrosandboxError::local_only(Operation::SandboxModify))?;
+    let run_dir = local.config().run_dir();
+    let transition = crate::LocalBackend::acquire_sandbox_transition_guard(&run_dir, name).await?;
+    let lineage = crate::snapshot::lineage::lock_source(&run_dir, name).await?;
+    let lifecycle =
+        crate::runtime::acquire_sandbox_lifecycle_guard(&run_dir, name, Duration::from_secs(5))
+            .await?;
+    let handle = backend.sandboxes().get(backend.clone(), name).await?;
+    let local_state = handle
+        .local()
+        .ok_or_else(|| MicrosandboxError::local_only(Operation::SandboxModify))?;
+    if !matches!(
+        handle.status_snapshot(),
+        SandboxStatus::Created | SandboxStatus::Stopped | SandboxStatus::Crashed
+    ) {
+        return Err(invalid(
+            "disk adoption requires a created, stopped, or crashed sandbox",
+        ));
+    }
+    creation::require_complete(local.db().await?.read(), local_state.db_id, name).await?;
+    let mut config = handle.config()?;
+    let sandbox_dir = local.sandboxes_dir().join(name);
+    let Some(index) = config
+        .spec
+        .mounts
+        .iter()
+        .position(|mount| mount.guest() == guest)
+    else {
+        return Err(invalid("sandbox has no /workspace disk"));
+    };
+    if let VolumeMount::Owned {
+        storage: OwnedVolumeStorage::Disk { .. },
+        ..
+    } = &config.spec.mounts[index]
+    {
+        crate::runtime::owned_volumes::validate(&sandbox_dir, &config.spec.mounts)?;
+        return Ok(());
+    }
+    let VolumeMount::DiskImage {
+        host,
+        format,
+        fstype,
+        options,
+        ..
+    } = &config.spec.mounts[index]
+    else {
+        return Err(invalid("/workspace is not an external disk image"));
+    };
+    if *format != microsandbox_types::DiskImageFormat::Raw || fstype.as_deref() != Some("ext4") {
+        return Err(invalid("/workspace must be a raw ext4 disk image"));
+    }
+    if std::fs::symlink_metadata(host)?.file_type().is_symlink() {
+        return Err(invalid("external disk image must not be a symlink"));
+    }
+    let original = host.clone();
+    let options = options.clone();
+    let source = source_override.unwrap_or(&original).to_path_buf();
+    if std::fs::symlink_metadata(&source)?.file_type().is_symlink() {
+        return Err(invalid("source disk image must not be a symlink"));
+    }
+    let size = std::fs::metadata(&source)?;
+    if !size.is_file() || size.len() == 0 || size.len() % (1024 * 1024) != 0 {
+        return Err(invalid("external disk has invalid size"));
+    }
+    let capacity_mib = u32::try_from(size.len() / (1024 * 1024))
+        .map_err(|_| invalid("external disk exceeds the supported owned-disk size"))?;
+    let storage = OwnedVolumeStorage::Disk { capacity_mib };
+    let backing = crate::runtime::owned_volumes::backing_path(&sandbox_dir, guest, &storage);
+    let backing_dir = backing
+        .parent()
+        .ok_or_else(|| invalid("owned disk path is invalid"))?
+        .to_path_buf();
+    let owned_root = backing_dir
+        .parent()
+        .ok_or_else(|| invalid("owned disk path is invalid"))?
+        .to_path_buf();
+    let length = size.len();
+    let stage_parent = CreationStorage::acquire(local, name)?;
+    let stage_dir = sandbox_dir.clone();
+    tokio::task::spawn_blocking(move || -> MicrosandboxResult<()> {
+        // The worker keeps every guard, so cancelling the caller cannot release the disk early.
+        let _storage = stage_parent;
+        let _lifecycle = lifecycle;
+        let _lineage = lineage;
+        let _transition = transition;
+        let invalid = |message: &str| MicrosandboxError::InvalidConfig(message.into());
+        let root = |path: &Path| -> MicrosandboxResult<_> {
+            Ok(microsandbox_image::checkpoint::sparse_file_integrity(path)?.root)
+        };
+        let source_root = root(&source)?;
+        if source != original
+            && (std::fs::metadata(&original)?.len() != length || root(&original)? != source_root)
+        {
+            return Err(invalid(
+                "staged source disk differs from configured external disk",
+            ));
+        }
+        std::fs::create_dir_all(&owned_root)?;
+        if !backing_dir.exists() {
+            let stage = tempfile::Builder::new()
+                .prefix(".owned-disk-adopt-")
+                .tempdir_in(&stage_dir)?;
+            let staged = stage.path().join("disk.raw");
+            microsandbox_utils::copy::fast_copy(&source, &staged)?;
+            if std::fs::metadata(&staged)?.len() != length || root(&staged)? != source_root {
+                return Err(invalid("copied disk differs from source"));
+            }
+            std::fs::File::open(&staged)?.sync_all()?;
+            std::fs::rename(stage.path(), &backing_dir)?;
+            std::fs::File::open(&owned_root)?.sync_all()?;
+        }
+        if !backing.is_file()
+            || std::fs::metadata(&backing)?.len() != length
+            || root(&backing)? != source_root
+        {
+            return Err(invalid("owned disk backing differs from source"));
+        }
+        Ok(())
+    })
+    .await
+    .map_err(|error| MicrosandboxError::Runtime(format!("disk adoption task failed: {error}")))??;
+    config.spec.mounts[index] = VolumeMount::Owned {
+        guest: guest.into(),
+        storage,
+        options,
+        stat_virtualization: microsandbox_types::StatVirtualization::Strict,
+        host_permissions: microsandbox_types::HostPermissions::Private,
+    };
+    crate::runtime::owned_volumes::validate(&sandbox_dir, &config.spec.mounts)?;
+    persist_config(&backend, &handle, &config, None).await?;
+    Ok(())
+}
