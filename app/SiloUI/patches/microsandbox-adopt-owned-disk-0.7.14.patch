+    async fn adopt_disk_fixture(
+        status: SandboxStatus,
+    ) -> (tempfile::TempDir, Arc<dyn Backend>, std::path::PathBuf) {
+        let temp = tempfile::tempdir_in("/tmp").unwrap();
+        let backend: Arc<dyn Backend> = Arc::new(
+            LocalBackend::builder()
+                .home(temp.path())
+                .build()
+                .await
+                .unwrap(),
+        );
+        let source = temp.path().join("workspace.raw");
+        let mut bytes = vec![0_u8; 1024 * 1024];
+        bytes[..9].copy_from_slice(b"workspace");
+        std::fs::write(&source, bytes).unwrap();
+        let mut current = config(1, 256);
+        current.spec.mounts.push(VolumeMount::DiskImage {
+            host: source.clone(),
+            guest: "/workspace".into(),
+            format: microsandbox_types::DiskImageFormat::Raw,
+            fstype: Some("ext4".into()),
+            options: Default::default(),
+        });
+        let local = backend.as_local().unwrap();
+        std::fs::create_dir_all(local.sandboxes_dir().join("api")).unwrap();
+        sandbox_entity::ActiveModel {
+            name: Set("api".into()),
+            config: Set(serde_json::to_string(&current).unwrap()),
+            status: Set(status),
+            ephemeral: Set(false),
+            ..Default::default()
+        }
+        .insert(local.db().await.unwrap().write())
+        .await
+        .unwrap();
+        // No guest image or runtime exists. Adoption must only copy the disk and update config.
+        (temp, backend, source)
+    }
+
+    #[tokio::test]
+    async fn adopt_disk_accepts_inactive_states_without_booting_and_preserves_bytes() {
+        for status in [
+            SandboxStatus::Created,
+            SandboxStatus::Stopped,
+            SandboxStatus::Crashed,
+        ] {
+            let (_temp, backend, source) = adopt_disk_fixture(status).await;
+            let before = std::fs::read(&source).unwrap();
+            let staged = source.with_extension("staged.raw");
+            std::fs::write(&staged, &before).unwrap();
+            adopt_disk_as_owned(backend.clone(), "api", "/workspace", Some(&staged))
+                .await
+                .unwrap();
+            let handle = backend
+                .sandboxes()
+                .get(backend.clone(), "api")
+                .await
+                .unwrap();
+            assert_eq!(handle.status_snapshot(), status);
+            let config = handle.config().unwrap();
+            let VolumeMount::Owned { storage, .. } = &config.spec.mounts[0] else {
+                panic!("workspace was not adopted for {status:?}");
+            };
+            let backing = crate::runtime::owned_volumes::backing_path(
+                &backend.as_local().unwrap().sandboxes_dir().join("api"),
+                "/workspace",
+                storage,
+            );
+            assert_eq!(std::fs::read(backing).unwrap(), before);
+            assert_eq!(std::fs::read(&source).unwrap(), before);
+            assert_eq!(std::fs::read(&staged).unwrap(), before);
+            // A retried conversion remains idempotent without changing lifecycle state.
+            adopt_disk_as_owned(backend.clone(), "api", "/workspace", Some(&staged))
+                .await
+                .unwrap();
+            assert_eq!(
+                backend
+                    .sandboxes()
+                    .get(backend.clone(), "api")
+                    .await
+                    .unwrap()
+                    .status_snapshot(),
+                status
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn adopt_disk_rejects_active_states_without_changing_the_mount_or_disk() {
+        for status in [
+            SandboxStatus::Running,
+            SandboxStatus::Starting,
+            SandboxStatus::Draining,
+            SandboxStatus::Paused,
+        ] {
+            let (_temp, backend, source) = adopt_disk_fixture(status).await;
+            let before = std::fs::read(&source).unwrap();
+            let error = adopt_disk_as_owned(backend.clone(), "api", "/workspace", None)
+                .await
+                .unwrap_err();
+            assert!(
+                error.to_string().contains("disk adoption requires"),
+                "{status:?}: {error}"
+            );
+            assert_eq!(std::fs::read(&source).unwrap(), before);
+            assert!(
+                !backend
+                    .as_local()
+                    .unwrap()
+                    .sandboxes_dir()
+                    .join("api/owned-volumes")
+                    .exists()
+            );
+            let row = sandbox_entity::Entity::find()
+                .one(backend.as_local().unwrap().db().await.unwrap().read())
+                .await
+                .unwrap()
+                .unwrap();
+            let config: SandboxConfig = serde_json::from_str(&row.config).unwrap();
+            assert!(matches!(
+                config.spec.mounts[0],
+                VolumeMount::DiskImage { .. }
+            ));
+            assert_eq!(row.status, status);
+        }
+    }
