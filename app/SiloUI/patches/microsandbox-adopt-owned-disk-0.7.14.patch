+//! One-time conversion of an inactive external raw disk to sandbox-owned storage.
+use clap::Args;
+use microsandbox::sandbox::Sandbox;
+
+/// Arguments for converting one inactive external disk to owned storage.
+#[derive(Debug, Args)]
+pub struct AdoptDiskArgs {
+    /// Existing created, stopped, or crashed sandbox.
+    pub name: String,
+    /// Existing guest mount path. Currently only /workspace is supported.
+    #[arg(long, default_value = "/workspace")]
+    pub guest: String,
+    /// Independent staged copy of the configured external disk.
+    #[arg(long)]
+    pub source: Option<std::path::PathBuf>,
+}
+
+/// Copy and verify the disk, then persist the owned mount.
+pub async fn run(args: AdoptDiskArgs) -> anyhow::Result<()> {
+    Sandbox::adopt_disk_as_owned(&args.name, &args.guest, args.source.as_deref()).await?;
+    println!("Adopted {} as sandbox-owned storage", args.guest);
+    Ok(())
+}
