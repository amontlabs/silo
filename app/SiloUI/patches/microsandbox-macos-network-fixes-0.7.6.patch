+/// Re-read the host's resolver table whenever it changes and swap the routing in. A failed or
+/// empty read keeps the routing in use: a query is better served by the last good table than by
+/// none. Ends when the forwarder is gone or the watcher stops.
+#[cfg(not(windows))]
+async fn follow_host_changes(
+    host: std::sync::Weak<HostResolvers>,
+    source: Arc<dyn HostResolverSource>,
+    mut changes: watch::Receiver<u64>,
+) {
+    while changes.changed().await.is_ok() {
+        let Some(host) = host.upgrade() else {
+            return;
+        };
+        let reader = Arc::clone(&source);
+        match tokio::task::spawn_blocking(move || reader.read()).await {
+            Ok(Ok(table)) if !table.is_empty() => {
+                if table != host.current().table {
+                    match HostRouting::build(table, host.query_timeout).await {
+                        Some(routing) => host.replace(routing),
+                        None => tracing::warn!(
+                            "host resolver change could not be applied; keeping the previous resolvers"
+                        ),
+                    }
+                }
+            }
+            Ok(Ok(_)) => tracing::warn!(
+                "host resolver configuration is empty; keeping the previous resolvers"
+            ),
+            Ok(Err(error)) => tracing::warn!(
+                %error,
+                "host resolver configuration unreadable; keeping the previous resolvers"
+            ),
+            Err(error) => tracing::warn!(%error, "host resolver read did not finish"),
+        }
+        host.handled.send_modify(|count| *count += 1);
+    }
+}
