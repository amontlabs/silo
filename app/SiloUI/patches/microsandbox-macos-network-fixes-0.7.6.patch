+    #[test]
+    fn trust_probe_leaf_is_accepted_only_by_a_client_that_trusts_the_issuing_ca() {
+        use rustls::client::WebPkiServerVerifier;
+        use rustls::client::danger::ServerCertVerifier;
+        use rustls::pki_types::{CertificateDer, ServerName, UnixTime, pem::PemObject};
+        use rustls::RootCertStore;
+
+        let _ = rustls::crypto::aws_lc_rs::default_provider().install_default();
+        let (cert_pem, key_pem) = generate_intercept_ca_pair().unwrap();
+        let probe = issue_trust_probe_pem(&cert_pem, &key_pem, "probe.invalid", 24 * 365).unwrap();
+        assert_eq!(probe.matches("-----BEGIN CERTIFICATE-----").count(), 1);
+        assert!(!probe.contains("PRIVATE KEY"));
+        let leaf = CertificateDer::from_pem_slice(probe.as_bytes()).unwrap();
+        let ca = CertificateDer::from_pem_slice(&cert_pem).unwrap();
+        let name = ServerName::try_from("probe.invalid").unwrap();
+
+        let mut trusted = RootCertStore::empty();
+        trusted.add(ca).unwrap();
+        let verifier = WebPkiServerVerifier::builder(Arc::new(trusted)).build().unwrap();
+        verifier
+            .verify_server_cert(&leaf, &[], &name, &[], UnixTime::now())
+            .expect("a client that trusts the CA accepts the leaf");
+        let other = ServerName::try_from("other.invalid").unwrap();
+        assert!(
+            verifier
+                .verify_server_cert(&leaf, &[], &other, &[], UnixTime::now())
+                .is_err(),
+            "the leaf is only valid for the probe name"
+        );
+
+        // A CA that is merely present, as an untrusted extra certificate, is not enough.
+        let mut unrelated = RootCertStore::empty();
+        let (other_ca, _) = generate_intercept_ca_pair().unwrap();
+        unrelated
+            .add(CertificateDer::from_pem_slice(&other_ca).unwrap())
+            .unwrap();
+        let verifier = WebPkiServerVerifier::builder(Arc::new(unrelated)).build().unwrap();
+        let ca = CertificateDer::from_pem_slice(&cert_pem).unwrap();
+        assert!(
+            verifier
+                .verify_server_cert(&leaf, &[ca], &name, &[], UnixTime::now())
+                .is_err()
+        );
+    }
