+    #[test]
+    fn read_frame_keeps_rx_wake_readable_while_frames_remain() {
+        let shared = Arc::new(SharedState::new(8));
+        let mut backend = SmoltcpBackend::new(shared.clone());
+        let mut buf = [0u8; 64];
+
+        for frame in [vec![1u8], vec![2], vec![3]] {
+            assert!(shared.push_rx_frame_and_wake(frame));
+        }
+
+        for expected in [1u8, 2] {
+            let n = backend.read_frame(&mut buf).expect("frame should be read");
+            assert_eq!(&buf[VIRTIO_NET_HDR_LEN..n], &[expected]);
+            assert!(
+                fd_is_readable(backend.raw_socket_fd()),
+                "queued frames must keep the wake descriptor readable"
+            );
+        }
+        let n = backend.read_frame(&mut buf).expect("last frame");
+        assert_eq!(&buf[VIRTIO_NET_HDR_LEN..n], &[3]);
+        assert!(!fd_is_readable(backend.raw_socket_fd()));
+        assert!(matches!(
+            backend.read_frame(&mut buf),
+            Err(ReadError::NothingRead)
+        ));
+        assert!(!fd_is_readable(backend.raw_socket_fd()));
+    }
+
+    #[test]
