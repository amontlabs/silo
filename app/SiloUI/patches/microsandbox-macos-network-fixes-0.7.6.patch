+/// Largest DNS payload a UDP response may carry: what the guest advertised through EDNS, but no
+/// more than one unfragmented datagram of the guest's MTU can hold. The response leaves as a
+/// single frame, so an answer above the MTU limit never reaches the guest. Truncating it sends
+/// the stub to TCP instead. Without a known destination the larger IPv6 header is assumed.
+fn udp_response_limit(advertised: usize, mtu: usize, destination: Option<IpAddr>) -> usize {
+    const UDP_HEADER: usize = 8;
+    let ip_header = match destination {
+        Some(IpAddr::V4(_)) => 20,
+        Some(IpAddr::V6(_)) | None => 40,
+    };
+    advertised.min(mtu.saturating_sub(ip_header + UDP_HEADER))
+}
