+        let mut buf = [0u8; VIRTIO_NET_HDR_LEN + 2];
+
+        assert!(shared.push_rx_frame_and_wake(vec![0; 8]));
+        assert!(shared.push_rx_frame_and_wake(vec![7, 8]));
+
+        assert!(matches!(
+            backend.read_frame(&mut buf),
+            Err(ReadError::NothingRead)
+        ));
+        assert!(fd_is_readable(backend.raw_socket_fd()));
+        let n = backend.read_frame(&mut buf).expect("next frame");
+        assert_eq!(&buf[VIRTIO_NET_HDR_LEN..n], &[7, 8]);
+    }
