+/// Issue a certificate for `domain` from an existing interception CA and return it as PEM.
+///
+/// The leaf's private key is discarded, so the result can only be used to ask whether a client
+/// trusts the CA. It cannot terminate TLS for `domain`.
+pub fn issue_trust_probe_pem(
+    ca_cert_pem: &[u8],
+    ca_key_pem: &[u8],
+    domain: &str,
+    validity_hours: u64,
+) -> Result<String, String> {
+    use base64::{Engine, engine::general_purpose::STANDARD};
+
+    let ca = CertAuthority::load(ca_cert_pem, ca_key_pem)?;
+    let cert = crate::engine::tls::certgen::generate_domain_cert(domain, &ca, validity_hours)
+        .map_err(|error| error.to_string())?;
+    let der = cert
+        .chain
+        .first()
+        .ok_or_else(|| "the issued certificate chain is empty".to_owned())?;
+    let encoded = STANDARD.encode(der.as_ref());
+    let mut pem = String::from("-----BEGIN CERTIFICATE-----\n");
+    for line in encoded.as_bytes().chunks(64) {
+        pem.push_str(std::str::from_utf8(line).map_err(|error| error.to_string())?);
+        pem.push('\n');
+    }
+    pem.push_str("-----END CERTIFICATE-----\n");
+    Ok(pem)
+}
