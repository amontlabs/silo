+#[cfg(not(windows))]
+impl HostResolvers {
+    fn current(&self) -> Arc<HostRouting> {
+        self.routing
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+    }
+
+    fn replace(&self, routing: HostRouting) {
+        *self
+            .routing
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = Arc::new(routing);
+    }
+}
