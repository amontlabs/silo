+        assert!(fd_is_readable(backend.raw_socket_fd()));
+        let n = backend.read_frame(&mut buf).expect("next frame");
+        assert_eq!(&buf[VIRTIO_NET_HDR_LEN..n], &[7, 8]);
+    }
