+        source.change(Err(io::Error::other("configd is restarting")));
+        handled.wait_for(|count| *count >= 1).await.unwrap();
+        source.change(Ok(HostResolverTable::default()));
+        handled.wait_for(|count| *count >= 2).await.unwrap();
+
+        assert_eq!(
+            resolve_name(&forwarder, "example.org.").await,
+            Some(Ipv4Addr::new(192, 0, 2, 1))
+        );
+    }
+
+    /// An upstream that answers every query over UDP and TCP, on one port, with `records` TXT
+    /// records of about 230 bytes each.
+    async fn txt_upstream(records: usize) -> SocketAddr {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+        fn answer(query: &Message, records: usize) -> Vec<u8> {
+            let mut response = Message::response(query.metadata.id, query.metadata.op_code);
+            response.metadata.response_code = ResponseCode::NoError;
+            response.metadata.recursion_available = true;
+            let question = query.queries[0].clone();
+            response.add_query(question.clone());
+            for index in 0..records {
+                let text = format!("{index:03}{}", "x".repeat(227));
+                response.answers.push(Record::from_rdata(
+                    question.name().clone(),
+                    60,
+                    RData::TXT(TXT::new(vec![text])),
+                ));
+            }
+            response.to_bytes().expect("encode answer")
+        }
+
+        loop {
+            let tcp = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let addr = tcp.local_addr().unwrap();
+            let Ok(udp) = tokio::net::UdpSocket::bind(addr).await else {
+                continue;
+            };
+            tokio::spawn(async move {
+                let mut buf = [0u8; 4096];
+                loop {
+                    let Ok((len, from)) = udp.recv_from(&mut buf).await else {
+                        continue;
+                    };
+                    if let Ok(query) = Message::from_bytes(&buf[..len]) {
+                        let _ = udp.send_to(&answer(&query, records), from).await;
+                    }
+                }
+            });
+            tokio::spawn(async move {
+                loop {
+                    let Ok((mut stream, _)) = tcp.accept().await else {
+                        continue;
+                    };
+                    tokio::spawn(async move {
+                        loop {
+                            let mut size = [0u8; 2];
+                            if stream.read_exact(&mut size).await.is_err() {
+                                return;
+                            }
+                            let mut body = vec![0u8; usize::from(u16::from_be_bytes(size))];
+                            if stream.read_exact(&mut body).await.is_err() {
+                                return;
+                            }
+                            let Ok(query) = Message::from_bytes(&body) else {
+                                return;
+                            };
+                            let response = answer(&query, records);
+                            let mut framed = (response.len() as u16).to_be_bytes().to_vec();
+                            framed.extend_from_slice(&response);
+                            if stream.write_all(&framed).await.is_err() {
+                                return;
+                            }
+                        }
+                    });
+                }
+            });
+            return addr;
+        }
+    }
+
+    fn edns_txt_query(payload: u16) -> Vec<u8> {
+        let mut query = make_query("big.example.com.", RecordType::TXT);
+        let mut edns = Edns::new();
+        edns.set_max_payload(payload);
+        query.edns = Some(edns);
+        query.to_bytes().expect("encode query")
+    }
+
+    /// The reported bug: with EDNS 4096 a ~2 KiB answer went out as one UDP frame above the
+    /// MTU, which the gateway dropped, so the guest saw neither an answer nor TC=1.
+    #[tokio::test]
+    async fn an_answer_above_the_guest_mtu_is_truncated_and_then_served_over_tcp() {
+        let upstream = txt_upstream(9).await;
+        let forwarder = forwarder_over(&[upstream]).await;
+        let raw = edns_txt_query(4096);
+        let gateway: IpAddr = "10.0.0.1".parse().unwrap();
+
+        let udp = forwarder
+            .forward(&raw, Some(gateway), Transport::Udp, None)
+            .await
+            .expect("a UDP response");
+        let truncated = Message::from_bytes(&udp).unwrap();
+        assert!(
+            truncated.metadata.truncation,
+            "TC must tell the guest to retry over TCP"
+        );
+        assert!(truncated.answers.is_empty());
+        assert!(
+            udp.len() <= 1500 - 20 - 8,
+            "the response fits one unfragmented datagram"
+        );
+
+        let tcp = forwarder
+            .forward(&raw, Some(gateway), Transport::Tcp, None)
+            .await
+            .expect("a TCP response");
+        let whole = Message::from_bytes(&tcp).unwrap();
+        assert!(!whole.metadata.truncation);
+        assert_eq!(whole.answers.len(), 9);
+        assert!(tcp.len() > 2000);
+    }
+
+    #[tokio::test]
+    async fn a_smaller_guest_mtu_lowers_the_udp_limit_below_the_advertised_buffer() {
+        let upstream = txt_upstream(3).await;
+        let mut forwarder = forwarder_over(&[upstream]).await;
+        let raw = edns_txt_query(4096);
+        let gateway: IpAddr = "10.0.0.1".parse().unwrap();
+
+        // About 750 bytes: one datagram at the default MTU...
+        let udp = forwarder
+            .forward(&raw, Some(gateway), Transport::Udp, None)
+            .await
+            .unwrap();
+        let message = Message::from_bytes(&udp).unwrap();
+        assert!(!message.metadata.truncation);
+        assert_eq!(message.answers.len(), 3);
+
+        // ...but not at an MTU of 576, whatever the guest advertised.
+        Arc::get_mut(&mut forwarder)
+            .expect("unique test forwarder")
+            .mtu = 576;
+        let udp = forwarder
+            .forward(&raw, Some(gateway), Transport::Udp, None)
+            .await
+            .unwrap();
+        assert!(Message::from_bytes(&udp).unwrap().metadata.truncation);
+    }
+
+    #[test]
+    fn the_udp_limit_is_the_smaller_of_the_advertised_buffer_and_the_datagram_the_mtu_holds() {
+        let v4 = Some(IpAddr::V4(Ipv4Addr::new(10, 0, 0, 1)));
+        let v6 = Some(IpAddr::V6("fd42::1".parse().unwrap()));
+        assert_eq!(udp_response_limit(4096, 1500, v4), 1472);
+        assert_eq!(udp_response_limit(4096, 1500, v6), 1452);
+        assert_eq!(udp_response_limit(4096, 1500, None), 1452);
+        assert_eq!(udp_response_limit(1232, 1500, v4), 1232);
+        assert_eq!(udp_response_limit(512, 1500, v4), 512);
+        assert_eq!(udp_response_limit(4096, 576, v4), 548);
+        assert_eq!(udp_response_limit(4096, 20, v4), 0);
+    }
+
     fn make_response(query: &Message) -> Message {
         let mut response = Message::response(query.metadata.id, query.metadata.op_code);
         response.metadata.response_code = ResponseCode::NoError;
diff --git a/crates/network/lib/engine/dns/host_resolvers.rs b/crates/network/lib/engine/dns/host_resolvers.rs
new file mode 100644
index 0000000..cc7b91e
--- /dev/null
+++ b/crates/network/lib/engine/dns/host_resolvers.rs
@@ -0,0 +1,357 @@
+//! Host resolver routing: the host's resolver configuration with its split-DNS entries, a
+//! source that reads it, and the change notifications that keep a running forwarder current.
+//!
+//! The default resolver answers every name that no scoped resolver claims. A scoped resolver
+//! (a VPN's supplemental match domains, or a file in `/etc/resolver`) claims its domain and every
+//! name below it, as the system resolver does, so an internal name never leaks to the default
+//! servers and a public name never goes to a VPN's private ones.
+
+use std::any::Any;
+use std::io;
+use std::net::{IpAddr, SocketAddr};
+
+use tokio::sync::watch;
+
+//--------------------------------------------------------------------------------------------------
+// Constants
+//--------------------------------------------------------------------------------------------------
+
+/// DNS port, used when a resolver entry names none.
+pub(crate) const DNS_PORT: u16 = 53;
+
+//--------------------------------------------------------------------------------------------------
+// Types
+//--------------------------------------------------------------------------------------------------
+
+/// A snapshot of the host's resolver configuration.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct HostResolverTable {
+    /// Nameservers for every name no scoped resolver claims, in the order to try them.
+    pub(crate) default_servers: Vec<SocketAddr>,
+    /// Resolvers that claim a domain.
+    pub(crate) scoped: Vec<ScopedResolver>,
+}
+
+/// A resolver that answers one domain and the names below it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ScopedResolver {
+    /// Lowercase, without leading or trailing dots, never empty.
+    pub(crate) domain: String,
+    pub(crate) servers: Vec<SocketAddr>,
+    /// Among resolvers of the same domain, the lower order answers first.
+    pub(crate) order: u32,
+}
+
+/// Where the host's resolver configuration comes from.
+pub(crate) trait HostResolverSource: Send + Sync + 'static {
+    /// Read the configuration now. Blocking: callers run it off the async runtime.
+    fn read(&self) -> io::Result<HostResolverTable>;
+
+    /// Start watching for configuration changes. `None` when the platform cannot say.
+    fn watch(&self) -> Option<HostResolverWatch> {
+        None
+    }
+}
+
+/// A stream of change notifications. Dropping it stops the underlying watcher.
+pub(crate) struct HostResolverWatch {
+    /// Counts notifications; a receiver wakes when the count moves.
+    pub(crate) changes: watch::Receiver<u64>,
+    /// Keeps the platform watcher alive.
+    pub(crate) _guard: Box<dyn Any + Send + Sync>,
+}
+
+/// The host's own configuration source for this platform.
+pub(crate) struct SystemResolverSource;
+
+//--------------------------------------------------------------------------------------------------
+// Methods
+//--------------------------------------------------------------------------------------------------
+
+impl HostResolverTable {
+    pub(crate) fn is_empty(&self) -> bool {
+        self.default_servers.is_empty() && self.scoped.is_empty()
+    }
+
+    /// The index of the scoped resolver that answers `name`: the longest matching domain, then
+    /// the lowest order, then the first listed. `None` means the default resolver answers.
+    pub(crate) fn scoped_index_for(&self, name: &str) -> Option<usize> {
+        let name = normalize_domain(name)?;
+        self.scoped
+            .iter()
+            .enumerate()
+            .filter(|(_, resolver)| {
+                !resolver.servers.is_empty() && domain_contains(&resolver.domain, &name)
+            })
+            .min_by_key(|(index, resolver)| {
+                (
+                    std::cmp::Reverse(resolver.domain.len()),
+                    resolver.order,
+                    *index,
+                )
+            })
+            .map(|(index, _)| index)
+    }
+
+    /// The nameservers that answer `name`.
+    #[cfg(test)]
+    pub(crate) fn servers_for(&self, name: &str) -> &[SocketAddr] {
+        match self.scoped_index_for(name) {
+            Some(index) => &self.scoped[index].servers,
+            None => &self.default_servers,
+        }
+    }
+}
+
+impl HostResolverSource for SystemResolverSource {
+    fn read(&self) -> io::Result<HostResolverTable> {
+        #[cfg(target_os = "macos")]
+        {
+            let mut table = super::nameserver::scdynamicstore::read_resolver_table()
+                .unwrap_or_else(|error| {
+                    tracing::debug!(%error, "SCDynamicStore resolver table unavailable");
+                    HostResolverTable::default()
+                });
+            if table.default_servers.is_empty() {
+                table.default_servers =
+                    super::nameserver::read_resolv_conf_blocking().unwrap_or_default();
+            }
+            if table.is_empty() {
+                return Err(io::Error::new(
+                    io::ErrorKind::NotFound,
+                    "the host has no resolver configuration",
+                ));
+            }
+            Ok(table)
+        }
+        #[cfg(not(target_os = "macos"))]
+        {
+            Ok(HostResolverTable {
+                default_servers: super::nameserver::read_resolv_conf_blocking()?,
+                scoped: Vec::new(),
+            })
+        }
+    }
+
+    fn watch(&self) -> Option<HostResolverWatch> {
+        #[cfg(target_os = "macos")]
+        {
+            let (sender, changes) = watch::channel(0u64);
+            match super::nameserver::scdynamicstore::watch_changes(sender) {
+                Ok(watcher) => Some(HostResolverWatch {
+                    changes,
+                    _guard: Box::new(watcher),
+                }),
+                Err(error) => {
+                    tracing::warn!(%error, "host resolver changes will not be followed");
+                    None
+                }
+            }
+        }
+        #[cfg(not(target_os = "macos"))]
+        {
+            None
+        }
+    }
+}
+
+//--------------------------------------------------------------------------------------------------
+// Functions
+//--------------------------------------------------------------------------------------------------
+
+/// Lowercase `name` without leading or trailing dots; `None` for the empty name.
+pub(crate) fn normalize_domain(name: &str) -> Option<String> {
+    let name = name.trim_matches('.').to_ascii_lowercase();
+    (!name.is_empty()).then_some(name)
+}
+
+/// Whether `name` is `domain` or a name below it.
+fn domain_contains(domain: &str, name: &str) -> bool {
+    name == domain
+        || name
+            .strip_suffix(domain)
+            .is_some_and(|rest| rest.ends_with('.'))
+}
+
+/// A scoped resolver from the text of a `/etc/resolver/<domain>` file. The file's name is the
+/// domain unless the file has a `domain` line. `None` when the file names no usable nameserver
+/// or domain.
+pub(crate) fn parse_resolver_file(file_name: &str, text: &str) -> Option<ScopedResolver> {
+    let mut domain = file_name.to_owned();
+    let mut port = DNS_PORT;
+    let mut order = 0u32;
+    let mut addresses = Vec::new();
+    for line in text.lines() {
+        let line = line.split('#').next().unwrap_or("").trim();
+        let mut words = line.split_whitespace();
+        let (Some(key), Some(value)) = (words.next(), words.next()) else {
+            continue;
+        };
+        match key {
+            "nameserver" => {
+                if let Ok(address) = value.parse::<IpAddr>() {
+                    addresses.push(address);
+                }
+            }
+            "port" => {
+                if let Ok(value) = value.parse() {
+                    port = value;
+                }
+            }
+            "domain" => domain = value.to_owned(),
+            "search_order" | "order" => {
+                if let Ok(value) = value.parse() {
+                    order = value;
+                }
+            }
+            _ => {}
+        }
+    }
+    let domain = normalize_domain(&domain)?;
+    if addresses.is_empty() {
+        return None;
+    }
+    Some(ScopedResolver {
+        domain,
+        servers: addresses
+            .into_iter()
+            .map(|address| SocketAddr::new(address, port))
+            .collect(),
+        order,
+    })
+}
+
+//--------------------------------------------------------------------------------------------------
+// Tests
+//--------------------------------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn addr(value: &str) -> SocketAddr {
+        value.parse().unwrap()
+    }
+
+    fn scoped(domain: &str, server: &str, order: u32) -> ScopedResolver {
+        ScopedResolver {
+            domain: domain.into(),
+            servers: vec![addr(server)],
+            order,
+        }
+    }
+
+    fn table() -> HostResolverTable {
+        HostResolverTable {
+            default_servers: vec![addr("8.8.8.8:53")],
+            scoped: vec![
+                scoped("corp.example.com", "10.0.0.53:53", 0),
+                scoped("example.com", "10.1.0.53:53", 0),
+                scoped("lab.example.com", "10.2.0.53:53", 5),
+                scoped("lab.example.com", "10.3.0.53:53", 1),
+            ],
+        }
+    }
+
+    #[test]
+    fn a_name_goes_to_the_resolver_with_the_longest_matching_domain() {
+        let table = table();
+        assert_eq!(
+            table.servers_for("host.corp.example.com."),
+            [addr("10.0.0.53:53")]
+        );
+        assert_eq!(
+            table.servers_for("corp.example.com"),
+            [addr("10.0.0.53:53")]
+        );
+        assert_eq!(table.servers_for("www.EXAMPLE.com"), [addr("10.1.0.53:53")]);
+        assert_eq!(table.servers_for("example.com"), [addr("10.1.0.53:53")]);
+    }
+
+    #[test]
+    fn names_outside_every_scoped_domain_use_the_default_resolver() {
+        let table = table();
+        for name in ["example.org", "notexample.com", "com", "", "."] {
+            assert_eq!(table.servers_for(name), [addr("8.8.8.8:53")], "{name:?}");
+        }
+    }
+
+    #[test]
+    fn equal_domains_prefer_the_lowest_order() {
+        assert_eq!(
+            table().servers_for("a.lab.example.com"),
+            [addr("10.3.0.53:53")]
+        );
+    }
+
+    #[test]
+    fn a_scoped_resolver_without_servers_claims_nothing() {
+        let mut table = table();
+        table.scoped[0].servers.clear();
+        assert_eq!(
+            table.servers_for("host.corp.example.com"),
+            [addr("10.1.0.53:53")]
+        );
+    }
+
+    #[test]
+    fn resolver_files_name_a_domain_servers_port_and_order() {
+        let resolver = parse_resolver_file(
+            "Corp.Example.com",
+            "# split dns\nnameserver 10.0.0.53\nnameserver fd00::53 # v6\nport 5353\nsearch_order 3\n",
+        )
+        .unwrap();
+        assert_eq!(resolver.domain, "corp.example.com");
+        assert_eq!(
+            resolver.servers,
+            [addr("10.0.0.53:5353"), addr("[fd00::53]:5353")]
+        );
+        assert_eq!(resolver.order, 3);
+
+        let overridden = parse_resolver_file("ignored", "domain lab.test\nnameserver 192.0.2.1\n");
+        assert_eq!(overridden.unwrap().domain, "lab.test");
+        assert!(parse_resolver_file("corp.test", "port 53\n").is_none());
+        assert!(parse_resolver_file("corp.test", "nameserver not-an-ip\n").is_none());
+        assert!(parse_resolver_file("", "nameserver 192.0.2.1\n").is_none());
+    }
+}
+
+/// A change source for tests and embedders: the counter moves when `notify` is called.
+#[cfg(test)]
+pub(crate) struct ManualSource {
+    table: std::sync::Mutex<io::Result<HostResolverTable>>,
+    sender: watch::Sender<u64>,
+}
+
+#[cfg(test)]
+impl ManualSource {
+    pub(crate) fn new(table: HostResolverTable) -> std::sync::Arc<Self> {
+        std::sync::Arc::new(Self {
+            table: std::sync::Mutex::new(Ok(table)),
+            sender: watch::channel(0).0,
+        })
+    }
+
+    /// Replace the configuration and announce the change.
+    pub(crate) fn change(&self, table: io::Result<HostResolverTable>) {
+        *self.table.lock().unwrap() = table;
+        self.sender.send_modify(|count| *count += 1);
+    }
+}
+
+#[cfg(test)]
+impl HostResolverSource for ManualSource {
+    fn read(&self) -> io::Result<HostResolverTable> {
+        match &*self.table.lock().unwrap() {
+            Ok(table) => Ok(table.clone()),
+            Err(error) => Err(io::Error::new(error.kind(), error.to_string())),
+        }
+    }
+
+    fn watch(&self) -> Option<HostResolverWatch> {
+        Some(HostResolverWatch {
+            changes: self.sender.subscribe(),
+            _guard: Box::new(()),
+        })
+    }
+}
