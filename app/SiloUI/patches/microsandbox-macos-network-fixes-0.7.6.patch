+pub fn read_resolver_table() -> io::Result<HostResolverTable> {
+    let store = SCDynamicStoreBuilder::new("microsandbox-network")
+        .build()
+        .ok_or_else(|| Error::other("SCDynamicStoreBuilder::build failed"))?;
