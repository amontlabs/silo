+/// Reports changes to the host's resolver configuration. Dropping it stops the watcher.
+pub struct ChangeWatcher {
+    run_loop: CFRunLoop,
+    stop: Arc<AtomicBool>,
+}
+
+impl Drop for ChangeWatcher {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::SeqCst);
+        self.run_loop.stop();
+    }
+}
+
+/// Watch the dynamic store for DNS changes and count each notification on `sender`.
+///
+/// The store's callbacks run on a dedicated thread that owns a run loop; the thread ends within
+/// [`WATCHER_POLL`] of the watcher being dropped, immediately when its run loop is already
+/// running.
+pub fn watch_changes(sender: watch::Sender<u64>) -> io::Result<ChangeWatcher> {
+    let stop = Arc::new(AtomicBool::new(false));
+    let (ready_tx, ready_rx) = std::sync::mpsc::sync_channel::<Result<CFRunLoop, String>>(1);
+    let thread_stop = Arc::clone(&stop);
+    std::thread::Builder::new()
+        .name("msb-dns-watch".into())
+        .spawn(move || {
+            let context = SCDynamicStoreCallBackContext {
+                callout: notify_change,
+                info: sender,
+            };
+            let Some(store) = SCDynamicStoreBuilder::new("microsandbox-network-watch")
+                .callback_context(context)
+                .build()
+            else {
+                let _ = ready_tx.send(Err("SCDynamicStore session failed".into()));
+                return;
+            };
+            let keys: CFArray<CFString> = CFArray::from_CFTypes(&[
+                CFString::from("State:/Network/Global/DNS"),
+                CFString::from("State:/Network/Global/IPv4"),
+            ]);
+            let patterns: CFArray<CFString> =
+                CFArray::from_CFTypes(&[CFString::from("State:/Network/Service/[^/]+/DNS")]);
+            if !store.set_notification_keys(&keys, &patterns) {
+                let _ = ready_tx.send(Err("SCDynamicStore notification keys failed".into()));
+                return;
+            }
+            let Some(source) = store.create_run_loop_source() else {
+                let _ = ready_tx.send(Err("SCDynamicStore run loop source failed".into()));
+                return;
+            };
+            let run_loop = CFRunLoop::get_current();
+            run_loop.add_source(&source, unsafe { kCFRunLoopCommonModes });
+            if ready_tx.send(Ok(run_loop)).is_err() {
+                return;
+            }
+            while !thread_stop.load(Ordering::SeqCst) {
+                CFRunLoop::run_in_mode(unsafe { kCFRunLoopDefaultMode }, WATCHER_POLL, false);
+            }
+        })
+        .map_err(|error| Error::other(error.to_string()))?;
+    match ready_rx.recv() {
+        Ok(Ok(run_loop)) => Ok(ChangeWatcher { run_loop, stop }),
+        Ok(Err(message)) => Err(Error::other(message)),
+        Err(_) => Err(Error::other(
+            "the DNS watcher thread ended before it started",
+        )),
+    }
+}
+
+fn notify_change(
+    _store: SCDynamicStore,
+    _changed_keys: CFArray<CFString>,
+    sender: &mut watch::Sender<u64>,
+) {
+    sender.send_modify(|count| *count = count.wrapping_add(1));
+}
