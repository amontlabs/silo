+#[cfg(not(windows))]
+impl HostRouting {
+    /// Build the upstreams of every resolver in `table`. `None` when none can be built.
+    async fn build(table: HostResolverTable, query_timeout: Duration) -> Option<Self> {
+        let default = if table.default_servers.is_empty() {
+            Vec::new()
+        } else {
+            DnsForwarder::build_direct_upstreams(table.default_servers.clone(), query_timeout)
+                .await
+                .unwrap_or_default()
+        };
+        let mut scoped = Vec::with_capacity(table.scoped.len());
+        for resolver in &table.scoped {
+            scoped.push(
+                DnsForwarder::build_direct_upstreams(resolver.servers.clone(), query_timeout)
+                    .await
+                    .unwrap_or_default(),
+            );
+        }
+        if default.is_empty() && scoped.iter().all(Vec::is_empty) {
+            tracing::error!("no upstream DNS client could be built for the host resolvers");
+            return None;
+        }
+        Some(Self {
+            table,
+            default,
+            scoped,
+        })
+    }
+
+    /// The upstreams that answer `name`: those of the scoped resolver that claims it, else the
+    /// default ones.
+    fn upstreams_for(&self, name: &str) -> &[ConfiguredUpstream] {
+        match self.table.scoped_index_for(name) {
+            Some(index) if !self.scoped[index].is_empty() => &self.scoped[index],
+            _ => &self.default,
+        }
+    }
+}
