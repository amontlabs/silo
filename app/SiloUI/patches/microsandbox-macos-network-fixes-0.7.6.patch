+/// The scoped resolvers one service's DNS dictionary defines (none without match domains).
+fn service_resolvers(dict: &CFDictionary) -> Vec<ScopedResolver> {
+    let domains = string_array(
+        dict,
+        unsafe { kSCPropNetDNSSupplementalMatchDomains }.to_void(),
+    );
+    if domains.is_empty() {
+        return Vec::new();
+    }
+    let port = dict
+        .find(unsafe { kSCPropNetDNSServerPort }.to_void())
+        .map(|ptr| unsafe { CFType::wrap_under_get_rule(*ptr) })
+        .and_then(CFType::downcast_into::<CFNumber>)
+        .and_then(|number| number.to_i32())
+        .and_then(|port| u16::try_from(port).ok())
+        .unwrap_or(RESOLVER_DNS_PORT);
+    let servers: Vec<SocketAddr> =
+        string_array(dict, unsafe { kSCPropNetDNSServerAddresses }.to_void())
+            .iter()
+            .filter_map(|address| address.parse::<IpAddr>().ok())
+            .map(|address| SocketAddr::new(address, port))
+            .collect();
+    let orders = number_array(
+        dict,
+        unsafe { kSCPropNetDNSSupplementalMatchOrders }.to_void(),
+    );
+    domains
+        .iter()
+        .enumerate()
+        .filter_map(|(index, domain)| {
+            Some(ScopedResolver {
+                domain: normalize_domain(domain)?,
