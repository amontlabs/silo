+++ b/crates/network/lib/engine/secrets/usage.rs
@@ -0,0 +1,229 @@
+//! Secret usage events.
+//!
+//! One JSON line per request where a placeholder was substituted (`used`) and
+//! per attempt to send a placeholder where it is not allowed (`blocked`). A
+//! line carries the secret's name, the destination host and the HTTP method.
+//! It never carries a secret value or a placeholder.
+
+use std::fs::{self, File, OpenOptions};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+//--------------------------------------------------------------------------------------------------
+// Constants
+//--------------------------------------------------------------------------------------------------
+
+/// Size at which the event file moves to `<name>.1` (one generation is kept).
+const MAX_USAGE_LOG_BYTES: u64 = 1024 * 1024;
+
+/// File name the sandbox runtime uses inside its log directory.
+pub const USAGE_LOG_FILE: &str = "secret-usage.jsonl";
+
+static SINK: Mutex<Option<UsageLog>> = Mutex::new(None);
+
+//--------------------------------------------------------------------------------------------------
+// Types
+//--------------------------------------------------------------------------------------------------
+
+/// Kind of a usage event.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum UsageKind {
+    /// A placeholder was replaced by the secret for an allowed host.
+    Used,
+    /// A placeholder was sent to a host the secret is not allowed for.
+    Blocked,
+}
+
+/// Append-only, size-capped event file.
+pub struct UsageLog {
+    path: PathBuf,
+    file: File,
+    written: u64,
+    max_bytes: u64,
+}
+
+//--------------------------------------------------------------------------------------------------
+// Methods
+//--------------------------------------------------------------------------------------------------
+
+impl UsageLog {
+    /// Open (creating) the event file at `path`.
+    pub fn open(path: &Path, max_bytes: u64) -> std::io::Result<Self> {
+        if let Some(parent) = path.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        let file = OpenOptions::new().create(true).append(true).open(path)?;
+        let written = file.metadata().map(|m| m.len()).unwrap_or(0);
+        Ok(Self {
+            path: path.to_path_buf(),
+            file,
+            written,
+            max_bytes,
+        })
+    }
+
+    /// Append one line, rotating first when the cap would be exceeded.
+    pub fn append(&mut self, line: &str) -> std::io::Result<()> {
+        if self.written + line.len() as u64 > self.max_bytes {
+            let mut rotated = self.path.clone().into_os_string();
+            rotated.push(".1");
+            fs::rename(&self.path, rotated)?;
+            self.file = OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(&self.path)?;
+            self.written = 0;
+        }
+        self.file.write_all(line.as_bytes())?;
+        self.written += line.len() as u64;
+        Ok(())
+    }
+}
+
+//--------------------------------------------------------------------------------------------------
+// Functions
+//--------------------------------------------------------------------------------------------------
+
+/// Route events to `path`. Without a call, events are dropped.
+pub fn set_usage_log(path: &Path) {
+    match UsageLog::open(path, MAX_USAGE_LOG_BYTES) {
+        Ok(log) => *SINK.lock().unwrap_or_else(|e| e.into_inner()) = Some(log),
+        Err(error) => tracing::warn!(%error, "secret usage log unavailable"),
+    }
+}
+
+/// Record one event on the configured file (a no-op when none is set).
+pub(crate) fn record(kind: UsageKind, secret: &str, host: &str, method: &str, reason: &str) {
+    let mut sink = SINK.lock().unwrap_or_else(|e| e.into_inner());
+    let Some(log) = sink.as_mut() else { return };
+    let line = format_event(now_ms(), kind, secret, host, method, reason);
+    if let Err(error) = log.append(&line) {
+        tracing::warn!(%error, "secret usage log write failed");
+    }
+}
+
+/// Render one event as a JSON line (with trailing newline).
+pub fn format_event(
+    at_ms: u64,
+    kind: UsageKind,
+    secret: &str,
+    host: &str,
+    method: &str,
+    reason: &str,
+) -> String {
+    let kind = match kind {
+        UsageKind::Used => "used",
+        UsageKind::Blocked => "blocked",
+    };
+    let mut line = format!("{{\"v\":1,\"at\":{at_ms},\"kind\":\"{kind}\"");
+    for (key, value) in [
+        ("secret", secret),
+        ("host", host),
+        ("method", method),
+        ("reason", reason),
+    ] {
+        if key == "reason" && value.is_empty() {
+            continue;
+        }
+        line.push_str(&format!(",\"{key}\":\"{}\"", escape_json(value)));
+    }
+    line.push_str("}\n");
+    line
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+
+fn escape_json(value: &str) -> String {
+    let mut out = String::with_capacity(value.len());
+    for c in value.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// HTTP method of a request line (`GET /path HTTP/1.1`), or empty.
+pub(crate) fn request_line_method(header_bytes: &[u8]) -> String {
+    let end = header_bytes
+        .iter()
+        .position(|b| *b == b' ' || *b == b'\r')
+        .unwrap_or(0);
+    String::from_utf8_lossy(&header_bytes[..end]).into_owned()
+}
+
+//--------------------------------------------------------------------------------------------------
+// Tests
+//--------------------------------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn event_line_names_secret_host_and_method_only() {
+        let line = format_event(
+            7,
+            UsageKind::Used,
+            "OPENAI_API_KEY",
+            "api.openai.com",
+            "POST",
+            "",
+        );
+        assert_eq!(
+            line,
+            "{\"v\":1,\"at\":7,\"kind\":\"used\",\"secret\":\"OPENAI_API_KEY\",\"host\":\"api.openai.com\",\"method\":\"POST\"}\n"
+        );
+        let blocked = format_event(
+            8,
+            UsageKind::Blocked,
+            "T",
+            "evil.example",
+            "GET",
+            "host_not_allowed",
+        );
+        assert!(blocked.contains("\"kind\":\"blocked\""));
+        assert!(blocked.contains("\"reason\":\"host_not_allowed\""));
+    }
+
+    #[test]
+    fn values_are_escaped() {
+        let line = format_event(1, UsageKind::Used, "A\"B", "h\\x", "G\nT", "");
+        assert!(line.contains("A\\\"B") && line.contains("h\\\\x") && line.contains("G\\u000aT"));
+        assert_eq!(line.matches('\n').count(), 1);
+    }
+
+    #[test]
+    fn method_is_the_request_line_token() {
+        assert_eq!(
+            request_line_method(b"POST /v1 HTTP/1.1\r\nHost: x\r\n\r\n"),
+            "POST"
+        );
+        assert_eq!(request_line_method(b""), "");
+    }
+
+    #[test]
+    fn log_rotates_at_the_cap() {
+        let dir = std::env::temp_dir().join(format!("msb-usage-{}", std::process::id()));
+        let path = dir.join(USAGE_LOG_FILE);
+        let mut log = UsageLog::open(&path, 200).unwrap();
+        for _ in 0..4 {
+            log.append(&format_event(1, UsageKind::Used, "K", "h", "GET", ""))
+                .unwrap();
+        }
+        assert!(path.exists());
+        assert!(dir.join("secret-usage.jsonl.1").exists());
+        assert!(fs::metadata(&path).unwrap().len() <= 200);
+        let _ = fs::remove_dir_all(&dir);
+    }
+}
