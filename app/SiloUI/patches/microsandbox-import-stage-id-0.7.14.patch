+fn validate_stage_id(id: &str) -> MicrosandboxResult<()> {
+    if id.len() != 32
+        || !id
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    {
+        return Err(MicrosandboxError::InvalidConfig(
+            "snapshot load stage ID must be 32 lowercase hex digits".into(),
+        ));
+    }
+    Ok(())
+}
+
+fn operation_stage(
+    root: &Path,
+    prefix: &str,
+    id: Option<&str>,
+) -> MicrosandboxResult<tempfile::TempDir> {
+    match id {
+        Some(id) => {
+            validate_stage_id(id)?;
+            Ok(tempfile::Builder::new()
+                .prefix(&format!("{prefix}{id}"))
+                .rand_bytes(0)
+                .tempdir_in(root)?)
+        }
+        None => Ok(tempfile::Builder::new().prefix(prefix).tempdir_in(root)?),
+    }
+}
