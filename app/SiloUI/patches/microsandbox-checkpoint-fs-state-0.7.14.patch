+/// Add one device state object to the checkpoint's retained total, refusing a checkpoint whose
+/// device states together exceed the aggregate budget however many devices it names.
+///
+/// The budget is 64 MiB, or one maximal virtio-fs state when `fs_state_limit` is configured
+/// larger than that.
+pub fn charge_device_state(
+    retained: &mut u64,
+    len: u64,
+    fs_state_limit: usize,
+) -> Result<(), String> {
+    let one_fs_state = (fs_state_limit as u64).saturating_add(DEVICE_STATE_FRAME_BYTES);
+    let budget = MAX_TOTAL_DEVICE_STATE_BYTES.max(one_fs_state);
+    *retained = retained.saturating_add(len);
+    if *retained > budget {
+        return Err(format!(
+            "checkpoint device state exceeds the aggregate {budget} byte budget"
+        ));
+    }
+    Ok(())
+}
