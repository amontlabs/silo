+/// Check the captured device inventory against what this sandbox can contain, from manifest
+/// metadata alone, before any payload is read or retained.
+///
+/// A sandbox has at most one virtio-fs transport for its root, one for the runtime share and one
+/// per mount, so a checkpoint naming more virtio-fs devices than `max_fs_devices` cannot belong to
+/// it.
+fn validate_device_inventory(
+    references: &[microsandbox_image::checkpoint::DeviceStateRef],
+    max_fs_devices: usize,
+) -> Result<(), String> {
+    let fs_devices = references
+        .iter()
+        .filter(|device| device.is_virtio_fs())
+        .count();
+    if fs_devices > max_fs_devices {
+        return Err(format!(
+            "checkpoint names {fs_devices} virtio-fs devices but this sandbox has at most {max_fs_devices}"
+        ));
+    }
+    Ok(())
+}
