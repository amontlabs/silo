+fn write_test_vmdk(
+    cache: &microsandbox_image::GlobalCache,
+    image_digest: &microsandbox_image::Digest,
+    diff_id: &microsandbox_image::Digest,
+) {
+    let extents = [
+        cache.fsmeta_erofs_path(image_digest),
+        cache.layer_erofs_path(diff_id),
+    ];
+    let mut descriptor = String::from(
+        "# Disk DescriptorFile\nversion=1\nCID=fffffffe\nparentCID=ffffffff\ncreateType=\"twoGbMaxExtentFlat\"\n\n# Extent description\n",
+    );
+    let mut sectors = 0;
+    for path in &extents {
+        let count = std::fs::metadata(path).unwrap().len() / 512;
+        sectors += count;
+        descriptor.push_str(&format!(
+            "RW {count} FLAT \"{}\" 0\n",
+            std::fs::canonicalize(path).unwrap().display()
+        ));
+    }
+    descriptor.push_str(&format!(
+        "\n# The Disk Data Base\n#DDB\nddb.virtualHWVersion = \"4\"\nddb.geometry.cylinders = \"{}\"\nddb.geometry.heads = \"16\"\nddb.geometry.sectors = \"63\"\nddb.adapterType = \"ide\"\n",
+        sectors.div_ceil(16 * 63)
+    ));
+    std::fs::write(cache.vmdk_path(image_digest), descriptor).unwrap();
+}
