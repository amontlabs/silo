+    /// Bind a cached VMDK to the EROFS files in this cache. Archive VMDKs contain
+    /// absolute extent paths, so importing their bytes cannot make them portable.
+    pub fn rebind_vmdk(
+        &self,
+        manifest_digest: &Digest,
+        layer_diff_ids: &[Digest],
+    ) -> ImageResult<()> {
+        use super::lock::{flock_unlock, lock_exclusive, open_lock_file};
+
+        // Image materialization uses the fsmeta lock while writing its VMDK.
+        let lock = open_lock_file(&self.fsmeta_erofs_lock_path(manifest_digest))?;
+        lock_exclusive(&lock)?;
+        let _guard = scopeguard::guard(lock, |file| {
+            let _ = flock_unlock(&file);
+        });
+
+        let mut extents = vec![self.fsmeta_erofs_path(manifest_digest)];
+        extents.extend(
+            layer_diff_ids
+                .iter()
+                .map(|diff_id| self.layer_erofs_path(diff_id)),
+        );
+        for path in &extents {
+            if !is_valid_erofs_artifact(path) {
+                return Err(ImageError::Materialize {
+                    digest: manifest_digest.to_string(),
+                    message: format!("invalid cached VMDK extent: {}", path.display()),
+                    source: None,
+                });
+            }
+        }
+
+        let target = self.vmdk_path(manifest_digest);
+        let temporary = tempfile::Builder::new()
+            .prefix(".vmdk-rebind-")
+            .tempfile_in(&self.vmdk_dir)
+            .map_err(|source| ImageError::Cache {
+                path: self.vmdk_dir.clone(),
+                source,
+            })?
+            .into_temp_path();
+        let extent_paths = extents.iter().map(PathBuf::as_path).collect::<Vec<_>>();
+        crate::stitch::write_vmdk_descriptor(&temporary, &extent_paths).map_err(|source| {
+            ImageError::Cache {
+                path: temporary.to_path_buf(),
+                source,
+            }
+        })?;
+
+        match std::fs::symlink_metadata(&target) {
+            Ok(metadata) if !metadata.file_type().is_file() => {
+                return Err(ImageError::Cache {
+                    path: target,
+                    source: std::io::Error::other("VMDK cache target is not a regular file"),
+                });
+            }
+            Ok(_) => {
+                if std::fs::read(&target)? == std::fs::read(&temporary)? {
+                    return Ok(());
+                }
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(source) => {
+                return Err(ImageError::Cache {
+                    path: target,
+                    source,
+                });
+            }
+        }
+        temporary
+            .persist(&target)
+            .map_err(|error| ImageError::Cache {
+                path: target,
+                source: error.error,
+            })?;
+        Ok(())
+    }
+
