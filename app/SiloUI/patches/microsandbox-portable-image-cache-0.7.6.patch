+#[tokio::test]
+async fn imported_image_vmdk_uses_destination_cache_after_source_is_removed() {
+    let tmp = TempDir::new().unwrap();
+    let export_home = tmp.path().join("retired-export-home");
+    let export_backend = isolated_backend(&export_home).await;
+    let export_cache = microsandbox_image::GlobalCache::new(&export_home.join("cache")).unwrap();
+    let seeded = seed_image_cache(&export_cache).await;
+    let source_descriptor = std::fs::read(export_cache.vmdk_path(&seeded.image_digest)).unwrap();
+    let fsmeta = std::fs::read(export_cache.fsmeta_erofs_path(&seeded.image_digest)).unwrap();
+    let layer = std::fs::read(export_cache.layer_erofs_path(&seeded.diff_id)).unwrap();
+    let (artifact, _) = make_artifact_with_image(
+        tmp.path(),
+        "portable-image-source",
+        b"upper",
+        seeded.image_ref.to_string(),
+        seeded.manifest_digest.clone(),
+    );
+    let archive = tmp.path().join("portable-image.tar");
+    microsandbox::with_backend(
+        export_backend,
+        Box::pin(async {
+            save_snapshot(
+                artifact.to_str().unwrap(),
+                &archive,
+                SaveOpts {
+                    with_image: true,
+                    plain_tar: true,
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        }),
+    )
+    .await;
+    std::fs::remove_dir_all(&export_home).unwrap();
+
+    for mode in ["cold", "valid-warm", "stale-warm"] {
+        let import_home = tmp.path().join(mode);
+        let import_backend = isolated_backend(&import_home).await;
+        let import_cache =
+            microsandbox_image::GlobalCache::new(&import_home.join("cache")).unwrap();
+        if mode != "cold" {
+            std::fs::write(
+                import_cache.fsmeta_erofs_path(&seeded.image_digest),
+                &fsmeta,
+            )
+            .unwrap();
+            std::fs::write(import_cache.layer_erofs_path(&seeded.diff_id), &layer).unwrap();
+            if mode == "valid-warm" {
+                write_test_vmdk(&import_cache, &seeded.image_digest, &seeded.diff_id);
+            } else {
+                std::fs::write(
+                    import_cache.vmdk_path(&seeded.image_digest),
+                    &source_descriptor,
+                )
+                .unwrap();
+            }
+        }
+        #[cfg(unix)]
+        let valid_warm_inode = (mode == "valid-warm").then(|| {
+            std::fs::metadata(import_cache.vmdk_path(&seeded.image_digest))
+                .unwrap()
+                .ino()
+        });
+        let destination = tmp.path().join(format!("{mode}-snapshots"));
+        microsandbox::with_backend(
+            import_backend,
+            Box::pin(async {
+                Snapshot::load(&archive, Some(&destination)).await.unwrap();
+            }),
+        )
+        .await;
+        let descriptor =
+            std::fs::read_to_string(import_cache.vmdk_path(&seeded.image_digest)).unwrap();
+        for extent in [
+            import_cache.fsmeta_erofs_path(&seeded.image_digest),
+            import_cache.layer_erofs_path(&seeded.diff_id),
+        ] {
+            assert!(
+                extent.is_file(),
+                "{mode}: missing imported extent {}",
+                extent.display()
+            );
+            assert!(
+                descriptor.contains(
+                    std::fs::canonicalize(&extent)
+                        .unwrap()
+                        .to_string_lossy()
+                        .as_ref()
+                ),
+                "{mode}: VMDK does not point to imported extent {}",
+                extent.display()
+            );
+        }
+        assert!(
+            !descriptor.contains(export_home.to_string_lossy().as_ref()),
+            "{mode}: VMDK still points to retired source home"
+        );
+        #[cfg(unix)]
+        if let Some(inode) = valid_warm_inode {
+            assert_eq!(
+                std::fs::metadata(import_cache.vmdk_path(&seeded.image_digest))
+                    .unwrap()
+                    .ino(),
+                inode,
+                "valid warm VMDK was replaced"
+            );
+        }
+    }
+}
