+            let input = b"POST / HTTP/1.1\r\nHost: api.example.com\r\nContent-Encoding: gzip\r\nContent-Length: 8\r\n\r\n$BODYKEY";
+            assert!(handler.substitute(input).is_err());
+
+            // A placeholder over the limit: placeholder_too_long.
+            let long = format!("${}", "L".repeat(MAX_SECRET_PLACEHOLDER_BYTES + 1));
+            let mut secret = make_secret(&long, "long-value", "api.example.com");
+            secret.env_var = "REASON_LONG".into();
+            let mut handler =
+                SecretsHandler::new(&make_config(vec![secret]), "api.example.com", true);
+            let input = b"GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n";
+            assert!(handler.substitute(input).is_err());
+        });
+        let has = |secret: &str, reason: &str| {
+            text.lines()
+                .any(|line| line.contains(secret) && line.contains(reason))
+        };
+        assert!(has("REASON_META", "proxy_metadata"), "{text}");
+        assert!(
+            has("\"kind\":\"blocked\"", "unsupported_location"),
+            "{text}"
+        );
+        assert!(
+            has("\"kind\":\"blocked\"", "placeholder_too_long"),
+            "{text}"
+        );
+        for value in [
+            "meta-value",
+            "body-value",
+            "long-value",
+            "$META",
