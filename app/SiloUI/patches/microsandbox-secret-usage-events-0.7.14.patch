+
+    fn usage_text_after(run: impl FnOnce(&std::path::Path)) -> String {
+        let _guard = USAGE_SINK.lock().unwrap_or_else(|e| e.into_inner());
+        let dir = std::env::temp_dir().join(format!(
+            "msb-usage-reasons-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        let path = dir.join(usage::USAGE_LOG_FILE);
+        usage::set_usage_log(&path);
+        run(&path);
+        usage::clear_usage_log();
+        let text = std::fs::read_to_string(&path).unwrap_or_default();
+        let _ = std::fs::remove_dir_all(&dir);
+        text
+    }
+
