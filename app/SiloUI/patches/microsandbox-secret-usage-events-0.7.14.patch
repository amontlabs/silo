+            method: method.into(),
+            reason: reason.into(),
+        }
+    }
+
+    fn scratch(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("msb-usage-{name}-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        dir
+    }
+
+    fn total(dir: &Path) -> u64 {
+        parse_summary(&fs::read_to_string(dir.join(SUMMARY_FILE)).unwrap())
+            .values()
