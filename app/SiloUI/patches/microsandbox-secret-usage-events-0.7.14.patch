+        assert_eq!(clean_host("api.openai.com"), "api.openai.com");
+        let huge = event(
+            UsageKind::Used,
+            "K",
+            &"a".repeat(100_000),
+            &"M".repeat(100_000),
+            "",
+        );
+        assert!(format_event(1, &clean_event(&huge)).len() < 300);
+    }
+
+    #[test]
+    fn hosts_and_methods_are_normalised() {
+        assert_eq!(clean_host("API.Example.com.:443"), "api.example.com");
+        assert_eq!(clean_host("[::1]:8080"), "[::1]");
+        assert_eq!(clean_host(":443"), UNKNOWN_HOST);
+        assert_eq!(clean_method("post"), "POST");
+        assert_eq!(
+            host_header(b"GET / HTTP/1.1\r\nhost: Api.Example.com:443\r\n\r\n"),
+            "Api.Example.com:443"
+        );
+    }
+
+    #[test]
+    fn method_is_the_request_line_token() {
+        assert_eq!(
+            request_line_method(b"POST /v1 HTTP/1.1\r\nHost: x\r\n\r\n"),
+            "POST"
+        );
+        assert_eq!(request_line_method(b""), "");
+    }
+
+    #[test]
+    fn log_rotates_but_the_summary_keeps_every_count() {
+        let dir = scratch("rotate");
+        let path = dir.join(USAGE_LOG_FILE);
+        let log = UsageLog::open(&path, 200).unwrap();
+        for _ in 0..10 {
+            log.append_events(5, &[event(UsageKind::Used, "K", "h", "GET", "")])
+                .unwrap();
+        }
+        assert!(dir.join("secret-usage.jsonl.1").exists());
+        assert!(fs::metadata(&path).unwrap().len() <= 200);
+        assert_eq!(total(&dir), 10);
+        let _ = fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn summary_is_bounded_by_distinct_keys() {
+        let dir = scratch("keys");
+        let log = UsageLog::open(&dir.join(USAGE_LOG_FILE), 1 << 30).unwrap();
+        let events: Vec<UsageEvent> = (0..MAX_SUMMARY_KEYS + 20)
+            .map(|i| event(UsageKind::Used, "K", &format!("h{i}.example"), "GET", ""))
+            .collect();
+        log.append_events(1, &events).unwrap();
+        let rows = parse_summary(&fs::read_to_string(dir.join(SUMMARY_FILE)).unwrap());
+        assert!(rows.len() <= MAX_SUMMARY_KEYS + 1);
+        assert_eq!(total(&dir), events.len() as u64);
+        let _ = fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn two_writers_do_not_lose_counts() {
+        let dir = scratch("two");
+        let path = dir.join(USAGE_LOG_FILE);
+        let threads: Vec<_> = (0..2)
+            .map(|_| {
+                let path = path.clone();
+                std::thread::spawn(move || {
+                    let log = UsageLog::open(&path, 1 << 20).unwrap();
+                    for _ in 0..25 {
+                        log.append_events(1, &[event(UsageKind::Used, "K", "h", "GET", "")])
+                            .unwrap();
+                    }
+                })
+            })
+            .collect();
+        for thread in threads {
+            thread.join().unwrap();
+        }
+        assert_eq!(total(&dir), 50);
+        let _ = fs::remove_dir_all(&dir);
+    }
+}
