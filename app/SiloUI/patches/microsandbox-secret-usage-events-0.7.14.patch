+//! Secret usage events.
+//!
+//! One JSON line per request where a placeholder was substituted (`used`) and per attempt to
+//! send a placeholder where it is not allowed (`blocked`). A line carries the secret's name, the
+//! destination host, the HTTP method and, for a blocked attempt, a reason. It never carries a
+//! secret value or a placeholder.
+//!
+//! Two files are written side by side, both under an advisory lock so several processes can
+//! share them:
+//! - `secret-usage.jsonl`: the event trail, capped with one `.1` generation. Rotation drops the
+//!   oldest events.
+//! - `secret-usage-summary.tsv`: one counter line per (kind, secret, host, method, reason),
+//!   rewritten atomically. It is bounded by [`MAX_SUMMARY_KEYS`] and is never rotated, so a
+//!   flood of events cannot erase the history of what was used.
+
+use std::collections::BTreeMap;
+use std::fs::{self, File, OpenOptions};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+//--------------------------------------------------------------------------------------------------
+// Constants
+//--------------------------------------------------------------------------------------------------
+
+/// Size at which the event file moves to `<name>.1` (one generation is kept).
+const MAX_USAGE_LOG_BYTES: u64 = 1024 * 1024;
+
+/// Most distinct counters kept in the summary; later keys count under an overflow row.
+pub const MAX_SUMMARY_KEYS: usize = 512;
+
+/// File name the sandbox runtime uses inside its log directory.
+pub const USAGE_LOG_FILE: &str = "secret-usage.jsonl";
+
+/// Counter file written next to the event file.
+pub const SUMMARY_FILE: &str = "secret-usage-summary.tsv";
+
+/// Longest HTTP method recorded; anything else is recorded as `other`.
+const MAX_METHOD_BYTES: usize = 16;
+
+/// Longest DNS name recorded.
+const MAX_HOST_BYTES: usize = 253;
+
+/// Longest secret name recorded.
+const MAX_SECRET_BYTES: usize = 128;
+
+/// Host recorded when the proxy had none to name.
+pub const UNKNOWN_HOST: &str = "(unknown host)";
+
+/// Host recorded when the guest-chosen host held a configured placeholder.
+pub const REDACTED_HOST: &str = "(redacted host)";
+
+static SINK: Mutex<Option<PathBuf>> = Mutex::new(None);
+
+//--------------------------------------------------------------------------------------------------
+// Types
+//--------------------------------------------------------------------------------------------------
+
+/// Kind of a usage event.
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum UsageKind {
+    /// A placeholder was replaced by the secret for an allowed host.
+    Used,
+    /// A placeholder was sent where it is not allowed.
+    Blocked,
+}
+
+/// One event, before it is cleaned and written.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct UsageEvent {
+    pub kind: UsageKind,
+    pub secret: String,
+    pub host: String,
+    pub method: String,
+    pub reason: String,
+}
+
+/// The event file and its counter file.
+pub struct UsageLog {
+    path: PathBuf,
+    max_bytes: u64,
+}
+
+type SummaryKey = (UsageKind, String, String, String, String);
+
+/// Advisory lock held on a sibling file until dropped.
+struct Lock(#[allow(dead_code)] File);
+
+//--------------------------------------------------------------------------------------------------
+// Methods
+//--------------------------------------------------------------------------------------------------
+
+impl UsageLog {
+    /// Use `path` as the event file, creating its directory.
+    pub fn open(path: &Path, max_bytes: u64) -> std::io::Result<Self> {
+        if let Some(parent) = path.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        OpenOptions::new().create(true).append(true).open(path)?;
+        Ok(Self {
+            path: path.to_path_buf(),
+            max_bytes,
+        })
+    }
+
+    /// Append `events` and count them, holding the lock for the whole update.
+    pub fn append_events(&self, at_ms: u64, events: &[UsageEvent]) -> std::io::Result<()> {
+        if events.is_empty() {
+            return Ok(());
+        }
+        let _lock = Lock::acquire(&self.sibling("lock"))?;
+        let cleaned: Vec<UsageEvent> = events.iter().map(clean_event).collect();
+        let mut text = String::new();
+        for event in &cleaned {
+            text.push_str(&format_event(at_ms, event));
+        }
+        self.append_text(&text)?;
+        self.update_summary(at_ms, &cleaned)
+    }
+
+    fn sibling(&self, extension: &str) -> PathBuf {
+        let mut name = self.path.clone().into_os_string();
+        name.push(".");
+        name.push(extension);
+        PathBuf::from(name)
+    }
+
+    fn summary_path(&self) -> PathBuf {
+        self.path.with_file_name(SUMMARY_FILE)
+    }
+
+    fn append_text(&self, text: &str) -> std::io::Result<()> {
+        let len = fs::metadata(&self.path).map(|m| m.len()).unwrap_or(0);
+        if len > 0 && len + text.len() as u64 > self.max_bytes {
+            fs::rename(&self.path, self.sibling("1"))?;
+        }
+        OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(&self.path)?
+            .write_all(text.as_bytes())
+    }
+
+    fn update_summary(&self, at_ms: u64, events: &[UsageEvent]) -> std::io::Result<()> {
+        let path = self.summary_path();
+        let mut rows = parse_summary(&fs::read_to_string(&path).unwrap_or_default());
+        for event in events {
+            let mut key = (
+                event.kind,
+                event.secret.clone(),
+                event.host.clone(),
+                event.method.clone(),
+                event.reason.clone(),
+            );
+            if !rows.contains_key(&key) && rows.len() >= MAX_SUMMARY_KEYS {
+                key = (
+                    event.kind,
+                    "(other)".into(),
+                    "(other)".into(),
+                    "other".into(),
+                    key.4,
+                );
+            }
+            let row = rows.entry(key).or_insert((0, 0));
+            row.0 += 1;
+            row.1 = row.1.max(at_ms);
+        }
+        let mut text = String::new();
+        for ((kind, secret, host, method, reason), (count, last)) in &rows {
+            text.push_str(&format!(
+                "{}\t{secret}\t{host}\t{method}\t{reason}\t{count}\t{last}\n",
+                kind_name(*kind)
+            ));
+        }
+        let temporary = self.sibling("tmp");
+        fs::write(&temporary, text)?;
+        fs::rename(&temporary, &path)
+    }
+}
+
+impl Lock {
+    fn acquire(path: &Path) -> std::io::Result<Self> {
+        let file = OpenOptions::new().create(true).append(true).open(path)?;
+        #[cfg(unix)]
+        {
+            use std::os::fd::AsRawFd;
+            // SAFETY: the descriptor stays open for the lifetime of `file`.
+            if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX) } != 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+        }
+        Ok(Self(file))
+    }
+}
+
+//--------------------------------------------------------------------------------------------------
+// Functions
+//--------------------------------------------------------------------------------------------------
+
+fn parse_summary(text: &str) -> BTreeMap<SummaryKey, (u64, u64)> {
+    let mut rows = BTreeMap::new();
+    for line in text.lines() {
+        let fields: Vec<&str> = line.split('\t').collect();
+        let [kind, secret, host, method, reason, count, last] = fields[..] else {
+            continue;
+        };
+        let kind = match kind {
+            "used" => UsageKind::Used,
+            "blocked" => UsageKind::Blocked,
+            _ => continue,
+        };
+        let (Ok(count), Ok(last)) = (count.parse::<u64>(), last.parse::<u64>()) else {
+            continue;
+        };
+        rows.insert(
+            (
+                kind,
+                secret.into(),
+                host.into(),
+                method.into(),
+                reason.into(),
+            ),
+            (count, last),
+        );
+    }
+    rows
+}
+
+/// Route events to `path`. Without a call, events are dropped.
+pub fn set_usage_log(path: &Path) {
+    match UsageLog::open(path, MAX_USAGE_LOG_BYTES) {
+        Ok(_) => *SINK.lock().unwrap_or_else(|e| e.into_inner()) = Some(path.to_path_buf()),
+        Err(error) => tracing::warn!(%error, "secret usage log unavailable"),
+    }
+}
+
+/// Stop recording and forget the configured file.
+pub fn clear_usage_log() {
+    *SINK.lock().unwrap_or_else(|e| e.into_inner()) = None;
+}
+
+/// Record `events` on the configured file (a no-op when none is set).
+pub(crate) fn record_all(events: &[UsageEvent]) {
+    let Some(path) = SINK.lock().unwrap_or_else(|e| e.into_inner()).clone() else {
+        return;
+    };
+    let result = UsageLog::open(&path, MAX_USAGE_LOG_BYTES)
+        .and_then(|log| log.append_events(now_ms(), events));
+    if let Err(error) = result {
+        tracing::warn!(%error, "secret usage log write failed");
+    }
+}
+
+fn kind_name(kind: UsageKind) -> &'static str {
+    match kind {
+        UsageKind::Used => "used",
+        UsageKind::Blocked => "blocked",
+    }
+}
+
+/// A method that is a valid HTTP token of at most 16 bytes, else `other` (empty stays empty).
+pub fn clean_method(method: &str) -> String {
+    let method = method.to_ascii_uppercase();
+    let method = method.as_str();
+    let token = |b: u8| b.is_ascii_alphanumeric() || b"!#$%&'*+-.^_`|~".contains(&b);
+    if method.is_empty() {
+        String::new()
+    } else if method.len() <= MAX_METHOD_BYTES && method.bytes().all(token) {
+        method.to_owned()
+    } else {
+        "other".to_owned()
+    }
+}
+
+/// A host of at most 253 bytes made of name characters, else a fixed label.
+pub fn clean_host(host: &str) -> String {
+    if host.is_empty() {
+        return UNKNOWN_HOST.to_owned();
+    }
+    if host == REDACTED_HOST {
+        return host.to_owned();
+    }
+    let host = normalize_host(host);
+    let host = host.as_str();
+    if host.is_empty() {
+        return UNKNOWN_HOST.to_owned();
+    }
+    let name = |b: u8| b.is_ascii_alphanumeric() || b"-._:[]*".contains(&b);
+    if host.len() <= MAX_HOST_BYTES && host.bytes().all(name) {
+        host.to_owned()
+    } else {
+        "(invalid host)".to_owned()
+    }
+}
+
+/// Lowercase, without a port or a trailing dot (`API.Example.com.:443` is `api.example.com`).
+pub fn normalize_host(host: &str) -> String {
+    let host = host.trim();
+    let without_port = match host.rfind(':') {
+        Some(at)
+            if !host.starts_with('[') && host[at + 1..].bytes().all(|b| b.is_ascii_digit()) =>
+        {
+            &host[..at]
+        }
+        Some(at) if host.starts_with('[') && host[..at].ends_with(']') => &host[..at],
+        _ => host,
+    };
+    without_port.trim_end_matches('.').to_ascii_lowercase()
+}
+
+/// The `Host` header of an HTTP/1 header block, or empty.
+pub(crate) fn host_header(header_bytes: &[u8]) -> String {
+    String::from_utf8_lossy(header_bytes)
+        .split("\r\n")
+        .skip(1)
+        .find_map(|line| {
+            let (name, value) = line.split_once(':')?;
+            name.eq_ignore_ascii_case("host")
+                .then(|| value.trim().to_owned())
+        })
+        .unwrap_or_default()
+}
+
+fn clean_secret(secret: &str) -> String {
+    secret
+        .chars()
+        .take(MAX_SECRET_BYTES)
+        .map(|c| {
+            if c.is_ascii_alphanumeric() || c == '_' || c == '.' || c == '-' {
+                c
+            } else {
+                '_'
+            }
+        })
+        .collect()
+}
+
+fn clean_event(event: &UsageEvent) -> UsageEvent {
+    UsageEvent {
+        kind: event.kind,
+        secret: clean_secret(&event.secret),
+        host: clean_host(&event.host),
+        method: clean_method(&event.method),
+        reason: clean_secret(&event.reason),
+    }
+}
+
+/// Render one cleaned event as a JSON line (with trailing newline).
+pub fn format_event(at_ms: u64, event: &UsageEvent) -> String {
+    let mut line = format!(
+        "{{\"v\":1,\"at\":{at_ms},\"kind\":\"{}\"",
+        kind_name(event.kind)
+    );
+    for (key, value) in [
+        ("secret", &event.secret),
+        ("host", &event.host),
+        ("method", &event.method),
+        ("reason", &event.reason),
+    ] {
+        if value.is_empty() {
+            continue;
+        }
+        line.push_str(&format!(",\"{key}\":\"{}\"", escape_json(value)));
+    }
+    line.push_str("}\n");
+    line
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+
+fn escape_json(value: &str) -> String {
+    let mut out = String::with_capacity(value.len());
+    for c in value.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// HTTP method of a request line (`GET /path HTTP/1.1`), or empty.
+pub(crate) fn request_line_method(header_bytes: &[u8]) -> String {
+    let end = header_bytes
+        .iter()
+        .position(|b| *b == b' ' || *b == b'\r')
+        .unwrap_or(0);
+    String::from_utf8_lossy(&header_bytes[..end]).into_owned()
+}
+
+//--------------------------------------------------------------------------------------------------
+// Tests
+//--------------------------------------------------------------------------------------------------
+
