#!/usr/bin/env python3
"""Clean up a finished board item. Dry run unless --yes.

  clean [--file F] [--into BRANCH] [--yes] <item>

Refuses while an unmerged item depends on <item> (or while <item> is not merged/cleaned).
Otherwise: removes its worktree (`git worktree remove`, then prune), deletes its branch only if merged
into the integration branch, removes its temp data, marks the item `cleaned`, and reports the
bytes freed. Run it from any checkout of the repository; it never touches the repository's
main checkout or a checkout of the integration branch.

Temp data = $TMPDIR/silo-agent/<item> (where `live` keeps its state when SILO_AGENT_ITEM is set),
the short temp homes listed in any `tempdirs` file under it, and the comma list in the board's
`temp` column; every path must sit under $TMPDIR (or /tmp) and is deleted only there.
Computers: clean never stops or deletes a computer (it cannot tell which engine one belongs to).
A live check stops what it started in its own cleanup(); if a `computers` file under the item's
temp data still lists computers, clean prints them and refuses until they are gone or
--leave-computers is given (the list is then removed with the rest).
The board file is --file, else $BOARD; integration branch --into, else $BOARD_INTEGRATION, else main.
"""
import argparse, importlib.machinery, importlib.util, os, shutil, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
loader = importlib.machinery.SourceFileLoader("board", os.path.join(HERE, "board"))
spec = importlib.util.spec_from_loader("board", loader)
board = importlib.util.module_from_spec(spec)
loader.exec_module(board)


def size(p):
    if os.path.islink(p) or os.path.isfile(p):
        return os.lstat(p).st_size
    total = 0
    for root, dirs, files in os.walk(p):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


def human(n):
    for u in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or u == "GiB":
            return "%.1f %s" % (n, u) if u != "B" else "%d B" % n
        n /= 1024


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--file")
    ap.add_argument("--into")
    ap.add_argument("--yes", action="store_true", help="act (default is a dry run)")
    ap.add_argument("--leave-computers", action="store_true",
                    help="clean even though a live state still lists computers")
    ap.add_argument("item")
    args = ap.parse_args()
    path = board.path_of(args)
    with board.locked(path):
        run(args, path)


def run(args, path):
    rows = board.load(path)
    r = board.find(rows, args.item)
    into = board.integration(args)
    act = args.yes
    say = (lambda m: print(("" if act else "[dry-run] ") + m))

    blockers = [o["item"] for o in rows if args.item in board.deps(o) and o["state"] not in board.DONE]
    if blockers:
        board.die("refusing: unmerged items depend on %s: %s" % (args.item, ", ".join(blockers)))
    if r["state"] not in board.DONE:
        board.die("refusing: %s is %s, not merged" % (args.item, r["state"]))

    tmp_root = os.path.realpath(os.environ.get("TMPDIR") or "/tmp")
    roots = {tmp_root, os.path.realpath("/tmp")}
    item_tmp = os.path.join(tmp_root, "silo-agent", args.item)
    temps = [item_tmp] + [t for t in r["temp"].split(",") if t]

    # which checkouts must never be touched: every worktree (the first is the main checkout)
    wt_list = board.worktree_list()
    wts = {b: p for p, b in wt_list if b}
    all_wts = {os.path.realpath(p) for p, _ in wt_list}
    git_dir = board.git("rev-parse", "--path-format=absolute", "--git-common-dir", check=True).stdout.strip()
    all_wts.add(os.path.realpath(git_dir))
    protected = {os.path.realpath(wt_list[0][0])}
    if into in wts:
        protected.add(os.path.realpath(wts[into]))

    freed = 0

    # 1. live state: leftover computers are reported, short temp homes join the temp data
    leftovers = []
    if os.path.isdir(item_tmp) and not os.path.islink(item_tmp):
        for root, _, files in os.walk(item_tmp):
            for f in files:
                full = os.path.join(root, f)
                if os.path.islink(full):
                    continue
                if f == "computers":
                    leftovers += [l.strip() for l in open(full) if l.strip()]
                elif f == "tempdirs":
                    temps += [l.strip() for l in open(full) if l.strip()]
    if leftovers:
        print("live checks of %s list computers: %s" % (args.item, ", ".join(leftovers)))
        print("  stop and delete them with the Dev engine that ran the check, or rerun the check's cleanup")
        if not args.leave_computers:
            board.die("refusing: computers may still exist (use --leave-computers once they are gone)")

    # 2. worktree: only where the item's own branch is checked out
    br = r["branch"]
    wt = wts.get(br, "")
    saved = r["worktree"]
    if saved and (not wt or os.path.realpath(saved) != os.path.realpath(wt)):
        if os.path.exists(saved):
            say("leave %s alone: %s is not checked out there" % (saved, br))
        else:
            say("worktree %s already gone" % saved)
            if act:
                board.git("worktree", "prune")
    if wt and os.path.exists(wt):
        real = os.path.realpath(wt)
        if real in protected or br == into:
            board.die("refusing: %s is the main or integration checkout" % wt)
        freed += size(real)
        say("remove worktree %s (%s)" % (wt, human(size(real))))
        if act:
            p = board.git("worktree", "remove", wt)
            if p.returncode:
                board.die("worktree remove failed (uncommitted work?): " + p.stderr.strip())
            board.git("worktree", "prune")
        wt = ""
    elif wt:
        say("worktree %s already gone" % wt)
        if act:
            board.git("worktree", "prune")

    # 3. branch, only if merged into the integration branch; compare-and-delete on the checked sha
    sha = board.git("rev-parse", "--verify", "-q", "refs/heads/" + br).stdout.strip()
    if sha:
        if wt or (br in wts and os.path.exists(wts[br])):
            say("keep branch %s: checked out in %s" % (br, wts[br]))
        elif board.git("merge-base", "--is-ancestor", sha, into).returncode == 0:
            say("delete branch %s (merged into %s)" % (br, into))
            if act:
                p = board.git("update-ref", "-d", "refs/heads/" + br, sha)
                if p.returncode:
                    say("keep branch %s: it moved while cleaning (%s)" % (br, p.stderr.strip()))
        else:
            say("keep branch %s: not merged into %s" % (br, into))

    # 4. temp data: never a worktree, anything containing or inside one, or outside $TMPDIR
    for t in temps:
        if not os.path.isabs(t):
            say("skip temp path %s (not absolute)" % t)
            continue
        t = t.rstrip("/") or "/"  # a symlink named with a trailing "/" is not a symlink to islink
        link = os.path.islink(t)
        # a symlink is removed itself; its target is never touched
        real = os.path.join(os.path.realpath(os.path.dirname(t)), os.path.basename(t)) if link else os.path.realpath(t)
        if not os.path.lexists(real):
            continue
        bad = (real in roots or not any(real.startswith(x + os.sep) for x in roots) or real in protected
               or any(real == w or w.startswith(real + os.sep) or real.startswith(w + os.sep) for w in all_wts))
        if bad:
            say("skip temp path %s (outside %s or part of a checkout)" % (t, tmp_root))
            continue
        n = size(real)
        freed += n
        say("remove %s%s (%s)" % (real, " (symlink only)" if link else "", human(n)))
        if act:
            shutil.rmtree(real) if os.path.isdir(real) and not os.path.islink(real) else os.unlink(real)

    if act:
        r["state"] = "cleaned"
        board.save(path, rows)
    say("freed %s (%d bytes)" % (human(freed), freed))


if __name__ == "__main__":
    main()
