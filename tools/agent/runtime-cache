#!/usr/bin/env python3
"""runtime-cache: run `runtime:prepare` once per distinct set of runtime inputs.

The prepared runtime (bundled msb, libkrunfw, Git, git-lfs-transfer, gateway, network
bootstrap) is ignored build output. It depends only on the pinned inputs, so a worktree whose
inputs match a saved copy restores it by copy-on-write instead of rebuilding (~9 minutes: the
MicroSandbox release build is one LTO codegen unit).

Cache key = sha256 of: runtime-inputs.json, the patch files, the toolchain (rustc +pinned
--version), the target triple, the Rust flag and release-profile environment, the Go compiler
identity and recipe environment (as upstream preparation keys on them), the Swift compiler
version and macOS SDK, the staging scripts, the macOS gateway and network-bootstrap sources, and package.json
(the app version goes into release-info.json).

The Linux `silo` that `runtime:prepare` also stages (runtime/guest-silo, bundled as guest-support/silo) is built
from the workspace's own sources, so it has a second entry with its own key: sha256 of the source of every
local crate silo-cli depends on (from `cargo metadata`), Cargo.lock, the workspace manifest and toolchain
pin, the staging script, the Rust flag environment, the pinned rustc and Zig versions and the guest target.
Only a build that really produced the program is saved; a development build without Zig stages a manifest
saying so (not saved, rebuilt each time).

Store: $SILO_AGENT_CACHE/runtime/<key>/ and $SILO_AGENT_CACHE/runtime/guest-silo-<key>/ (default ~/Library/Caches/silo-agent on macOS,
~/.cache/silo-agent elsewhere). Nothing is ever committed. An entry is saved only right after a
successful prepare in the same run, published atomically, and carries a checksum of every file;
a hit verifies them first and restores through a temporary folder inside src-tauri.
"""
import argparse, contextlib, fcntl, hashlib, json, os, platform, re, shlex, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
APP = ROOT / "app" / "SiloUI"
TAURI = APP / "src-tauri"
KEY_FILES = [
    "runtime-inputs.json", "package.json", "scripts/prepare-microsandbox-runtime.mjs",
    "scripts/microsandbox-runtime.mjs", "scripts/git-runtime.mjs", "scripts/lfs-transfer-runtime.mjs",
    "scripts/linux-package-tools.mjs", "scripts/build-input.mjs", "scripts/preflight.mjs",
    "src-tauri/guest/macos/build-network-bootstrap.sh", "src-tauri/guest/macos/silo-network-bootstrap.swift",
]
# Mirrors goRecipeEnvironment in scripts/lfs-transfer-runtime.mjs.
GO_ENV = ["GOVERSION", "GOROOT", "GOTOOLCHAIN", "GOFLAGS", "GOEXPERIMENT", "GOAMD64", "GOARM64", "GOFIPS140"]


def out(cmd, **kw):
    return subprocess.run(cmd, check=True, capture_output=True, text=True, **kw).stdout.strip()


def try_out(cmd):
    try:
        return out(cmd)
    except (OSError, subprocess.CalledProcessError):
        return "unavailable"


def target_triple():
    return (os.environ.get("SILO_RUNTIME_TARGET") or os.environ.get("TAURI_ENV_TARGET_TRIPLE")
            or out(["rustc", "--print", "host-tuple"])).strip()


def tool_identity(inputs, triple):
    """Everything outside the repository that the upstream preparation scripts also key on."""
    target_env = triple.upper().replace("-", "_")
    names = ["RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS", "CARGO_BUILD_RUSTFLAGS", f"CARGO_TARGET_{target_env}_RUSTFLAGS"]
    names += sorted(n for n in os.environ if n.startswith("CARGO_PROFILE_"))
    lines = [f"{n}={os.environ.get(n)!r}" for n in names]
    lines.append("rustc=" + out(["rustc", f"+{inputs['toolchain']}", "--version"]))
    lines.append("go=" + go_identity(triple))
    lines.append("swiftc=" + try_out(["swiftc", "--version"]))
    lines.append("sdk=" + try_out(["xcrun", "--show-sdk-version"]) + " " + try_out(["xcrun", "--show-sdk-path"]))
    return lines


def go_identity(triple):
    """`go env` as lfs-transfer-runtime.mjs asks it: in a temporary module with the pinned go line,
    for the linux guest target, so GOTOOLCHAIN=auto resolves to the Go that preparation really uses."""
    selection = re.search(r"const goSelection = '([^']*)'", (APP / "scripts/lfs-transfer-runtime.mjs").read_text())
    arch = "amd64" if triple.startswith("x86_64") else "arm64"
    env = {**os.environ, "CGO_ENABLED": "0", "GOOS": "linux", "GOARCH": arch, "GOWORK": "off", "GOSUMDB": "sum.golang.org"}
    with tempfile.TemporaryDirectory() as tmp:
        (Path(tmp) / "go.mod").write_text(f"module github.com/charmbracelet/git-lfs-transfer\n\n{selection.group(1) if selection else ''}\n")
        try:
            return out(["go", "env", "-json", *GO_ENV], cwd=tmp, env=env)
        except (OSError, subprocess.CalledProcessError):
            return "unavailable"


def compute_key(triple):
    inputs = json.loads((APP / "runtime-inputs.json").read_text())
    files = list(KEY_FILES) + [p["path"] for p in inputs["patches"]]
    gateway = TAURI / "macos-gateway"
    files += sorted(str(p.relative_to(APP)) for p in gateway.rglob("*") if p.is_file() and "target" not in p.parts)
    h = hashlib.sha256()
    for line in [f"target={triple}", *tool_identity(inputs, triple)]:
        h.update(line.encode() + b"\0")
    for name in files:
        h.update(name.encode() + b"\0" + hashlib.sha256((APP / name).read_bytes()).digest())
    return h.hexdigest()[:32]


def guest_staged():
    """This checkout stages a guest silo (newer runtimes do; older ones have no such step)."""
    return (APP / "scripts/stage-guest-silo.mjs").is_file()


def guest_key(triple):
    """Key of runtime/guest-silo, or None when the silo-cli closure cannot be read."""
    inputs = json.loads((APP / "runtime-inputs.json").read_text())
    arch = "x86_64" if triple.startswith("x86_64") else "aarch64"
    musl = f"{arch}-unknown-linux-musl"
    try:
        meta = json.loads(out(["cargo", "metadata", "--format-version", "1", "--offline", "--locked", "--filter-platform", musl], cwd=APP))
    except (OSError, subprocess.CalledProcessError, ValueError):
        return None
    packages = {p["id"]: p for p in meta["packages"]}
    nodes = {n["id"]: n for n in meta["resolve"]["nodes"]}
    todo, seen = [p["id"] for p in meta["packages"] if p["name"] == "silo-cli"], set()
    while todo:
        i = todo.pop()
        if i not in seen:
            seen.add(i)
            todo += [d["pkg"] for d in nodes[i]["deps"] if any(k.get("kind") in (None, "build") for k in d["dep_kinds"])]
    if not seen:
        return None
    root = Path(meta["workspace_root"])
    files = [root / n for n in ("Cargo.toml", "Cargo.lock", "rust-toolchain.toml", ".cargo/config.toml")]
    files.append(APP / "scripts/guest-silo-runtime.mjs")
    for i in sorted(seen):
        if packages[i]["source"] is None:
            for dirpath, dirs, names in os.walk(Path(packages[i]["manifest_path"]).parent):
                dirs[:] = sorted(d for d in dirs if d not in ("target", "node_modules", ".git"))
                files += [Path(dirpath) / n for n in sorted(names)]
    h = hashlib.sha256()
    names = ["RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS", "CARGO_BUILD_RUSTFLAGS", f"CARGO_TARGET_{musl.upper().replace('-', '_')}_RUSTFLAGS"]
    names += sorted(n for n in os.environ if n.startswith("CARGO_PROFILE_"))
    zig = os.environ.get("SILO_ZIG", "").strip() or "zig"
    for line in [f"guest={musl}", f"rustc={try_out(['rustc', '+' + inputs['toolchain'], '--version'])}", f"zig={try_out([zig, 'version'])}",
                 *(f"{n}={os.environ.get(n)!r}" for n in names)]:
        h.update(line.encode() + b"\0")
    for f in files:
        if f.is_file():
            h.update(str(f.relative_to(root) if f.is_relative_to(root) else f).encode() + b"\0" + hashlib.sha256(f.read_bytes()).digest())
    return h.hexdigest()[:32]


def guest_ready():
    """runtime/guest-silo holds a built program (not the 'unavailable' manifest)."""
    try:
        manifest = json.loads((TAURI / "runtime/guest-silo/manifest.json").read_text())
    except (OSError, ValueError):
        return False
    return manifest.get("available") is True and (TAURI / "runtime/guest-silo/silo").is_file()


def guest_entry(triple):
    key = guest_key(triple)
    return key, (cache_root() / f"guest-silo-{key}" if key else None)


def guest_cached(entry):
    return bool(entry) and bool(entry_paths(entry, required=lambda ps: "runtime/guest-silo" in ps))


def guest_save(triple, replace):
    key, entry = guest_entry(triple)
    if entry is None or not guest_ready():
        return
    with locked(entry, exclusive=True):
        save_locked(entry, triple, replace, paths=["runtime/guest-silo"], required=lambda ps: "runtime/guest-silo" in ps)
    print(f"runtime-cache: saved guest-silo {key}")


def guest_ensure(triple):
    """Put runtime/guest-silo in place: from the cache, else built by stage-guest-silo.mjs (saved when real)."""
    key, entry = guest_entry(triple)
    if entry is not None:
        with locked(entry, exclusive=False):
            paths = entry_paths(entry, required=lambda ps: "runtime/guest-silo" in ps)
            if paths:
                restore(entry, paths)
                print(f"runtime-cache: hit guest-silo {key}")
                return
    print(f"runtime-cache: miss guest-silo {key}, building it", flush=True)
    remove(TAURI / "runtime/guest-silo")
    code = subprocess.run(["node", "scripts/stage-guest-silo.mjs"], cwd=APP, stdout=subprocess.DEVNULL).returncode
    if guest_ready():
        guest_save(triple, replace=False)
    elif (TAURI / "runtime/guest-silo/manifest.json").exists():
        print("runtime-cache: guest-silo is not available in this build (see the message above); not saved")
    else:
        sys.exit(f"runtime-cache: the guest silo could not be built (exit {code})")


def cache_root():
    default = Path.home() / ("Library/Caches" if platform.system() == "Darwin" else ".cache") / "silo-agent"
    return Path(os.environ.get("SILO_AGENT_CACHE", default)) / "runtime"


@contextlib.contextmanager
def locked(entry, exclusive):
    """Per-key lock: saves hold it exclusively, restores and hit checks share it."""
    entry.parent.mkdir(parents=True, exist_ok=True)
    with open(entry.parent / f".lock-{entry.name}", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        yield


def safe_rel(p):
    """A manifest path must be relative, free of `..`, inside the worktree, with no symlinked parent."""
    if not isinstance(p, str) or not p:
        return False
    rel = Path(p)
    if rel.is_absolute() or ".." in rel.parts or "." in rel.parts:
        return False
    cur = TAURI
    for part in rel.parts[:-1]:
        cur = cur / part
        if cur.is_symlink():
            return False
    root = ROOT.resolve()
    return (TAURI / rel).resolve().is_relative_to(root) and (TAURI.resolve() / rel).parent.resolve().is_relative_to(TAURI.resolve())


def outputs(triple):
    """Paths (relative to src-tauri) that runtime:prepare produces for this target."""
    found = [p.relative_to(TAURI) for p in (TAURI / "binaries").glob(f"*-{triple}") if p.is_file()]
    for name in ("microsandbox", "git", "lfs-transfer", "linux-package", "release-info.json"):
        if (TAURI / "runtime" / name).exists():
            found.append(Path("runtime") / name)
    return sorted(found)


def clone(src, dst):
    """Copy a file or tree to a new path, copy-on-write where the filesystem supports it."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    cmd = ["cp", "-cR", str(src), str(dst)] if platform.system() == "Darwin" else ["cp", "-a", "--reflink=auto", str(src), str(dst)]
    if subprocess.run(cmd, capture_output=True).returncode:
        if dst.is_dir() and not dst.is_symlink():
            shutil.rmtree(dst)
        elif dst.exists() or dst.is_symlink():
            dst.unlink()
        shutil.copytree(src, dst, symlinks=True) if src.is_dir() else shutil.copy2(src, dst)


def remove(p):
    if p.is_dir() and not p.is_symlink():
        shutil.rmtree(p, ignore_errors=True)
    elif p.exists() or p.is_symlink():
        p.unlink()


def checksums(base):
    """{relative file: sha256, or "link:<target>"} for every file and symlink under base."""
    sums = {}
    for dirpath, dirs, names in os.walk(base):
        for n in names + [d for d in dirs if (Path(dirpath) / d).is_symlink()]:
            f = Path(dirpath) / n
            rel = str(f.relative_to(base))
            if f.is_symlink():
                sums[rel] = "link:" + os.readlink(f)
            else:
                h = hashlib.sha256()
                with open(f, "rb") as fh:
                    for chunk in iter(lambda: fh.read(1 << 20), b""):
                        h.update(chunk)
                sums[rel] = h.hexdigest()
    return sums


def runtime_complete(paths):
    return any(p.startswith("binaries/msb-") for p in paths) and "runtime/microsandbox" in paths


def entry_paths(entry, required=runtime_complete):
    """The manifest paths of a complete, intact entry, or None."""
    try:
        m = json.loads((entry / "manifest.json").read_text())
        paths, sums = m["paths"], m["checksums"]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if not (isinstance(paths, list) and paths and isinstance(sums, dict) and all(safe_rel(p) for p in paths)):
        return None
    if not required(paths):
        return None
    files = entry / "files"
    if not all((files / p).exists() or (files / p).is_symlink() for p in paths):
        return None
    return paths if checksums(files) == sums else None


def save(entry, triple, replace):
    with locked(entry, exclusive=True):
        save_locked(entry, triple, replace)


def save_locked(entry, triple, replace, paths=None, required=runtime_complete):
    paths = paths or [str(p) for p in outputs(triple)]
    if not required(paths) or not all(safe_rel(p) for p in paths):
        sys.exit("runtime-cache: runtime:prepare outputs are missing or unsafe; nothing saved")
    entry.parent.mkdir(parents=True, exist_ok=True)
    tmp = entry.with_name(f".tmp-{entry.name}-{os.getpid()}")
    remove(tmp)
    try:
        for p in paths:
            clone(TAURI / p, tmp / "files" / p)
        manifest = {"target": triple, "paths": paths, "checksums": checksums(tmp / "files")}
        (tmp / "manifest.json").write_text(json.dumps(manifest, indent=1) + "\n")
        if entry.exists() and not replace and entry_paths(entry, required):
            print(f"runtime-cache: {entry.name} already saved; keeping it")
            return
        old = None
        if entry.exists():
            old = entry.with_name(f".old-{entry.name}-{os.getpid()}")
            entry.rename(old)
        try:
            tmp.rename(entry)
        except OSError:
            if old:
                old.rename(entry)
            raise
        if old:
            remove(old)
    finally:
        remove(tmp)


def restore(entry, paths):
    """Copy every path into a temporary folder inside src-tauri, then rename each into place."""
    stage = TAURI / f".restore-{os.getpid()}"
    remove(stage)
    try:
        for p in paths:
            clone(entry / "files" / p, stage / "new" / p)
        for p in paths:
            dst = TAURI / p
            dst.parent.mkdir(parents=True, exist_ok=True)
            if dst.exists() or dst.is_symlink():
                (stage / "old" / p).parent.mkdir(parents=True, exist_ok=True)
                dst.rename(stage / "old" / p)
            (stage / "new" / p).rename(dst)
    finally:
        remove(stage)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], epilog="Environment: SILO_AGENT_CACHE (store), SILO_RUNTIME_TARGET (target triple), RUNTIME_PREPARE_CMD (replaces the prepare command, split like a shell line but run without a shell; for tests).")
    ap.add_argument("--status", action="store_true", help="print the key and hit/miss, change nothing")
    ap.add_argument("--force", action="store_true", help="ignore a hit: rebuild and replace the saved copy")
    args = ap.parse_args()

    triple = target_triple()
    key = compute_key(triple)
    entry = cache_root() / key
    if args.status:
        gkey, gentry = guest_entry(triple) if guest_staged() else ("not staged here", None)
        runtime_hit = bool(entry_paths(entry))
        guest_hit = guest_cached(gentry) if guest_staged() else True
        print(f"key {key}\ntarget {triple}\nstore {entry}\nruntime {'hit' if runtime_hit else 'miss'}\n"
              f"guest-silo key {gkey or 'unavailable'}\nguest-silo {'hit' if guest_hit else 'miss'}\n{'hit' if runtime_hit and guest_hit else 'miss'}")
        return
    if not args.force:
        with locked(entry, exclusive=False):
            paths = entry_paths(entry)
            if paths:
                restore(entry, paths)
                print(f"runtime-cache: hit {key}, restored {len(paths)} paths")
        if paths:
            if guest_staged():
                guest_ensure(triple)
            return
    print(f"runtime-cache: miss {key}, running runtime:prepare", flush=True)
    cmd = shlex.split(os.environ["RUNTIME_PREPARE_CMD"]) if os.environ.get("RUNTIME_PREPARE_CMD") else ["npm", "--prefix", str(APP), "run", "runtime:prepare"]
    if subprocess.run(cmd, cwd=ROOT).returncode:
        sys.exit("runtime-cache: runtime:prepare failed; nothing saved")
    save(entry, triple, replace=args.force)
    print(f"runtime-cache: saved {entry}")
    if guest_staged():
        guest_save(triple, replace=args.force)


main()
