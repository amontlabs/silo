#!/usr/bin/env python3
"""Merge a batch of branches into the integration branch and start the full suite.

  merge-batch [--into BRANCH] [--force] [--no-check] [--no-suite] <branch>...
  merge-batch --suite [--into BRANCH]
  merge-batch --last

Run it in the integration checkout (clean tree, a branch checked out). It refuses unless the
current branch is the integration branch: --into, else $BOARD_INTEGRATION, else the branch
checked out here.
0. Refuses (exit 4, nothing merged) a branch that `check` has not recorded as GREEN (full mode)
   for its exact tree, against a base that covers the branch's whole diff (check writes
   app/SiloUI/target/agent-check/green/tree-<tree> in the worktree it ran in; every worktree of
   the repository is searched). A branch already contained here is skipped. --force merges anyway,
   with a note.
1. Merges each branch with --no-ff, in order. On a conflict it prints the conflicting files,
   aborts that merge (earlier merges stay) and exits 2. Each branch actually merged gets
   state=merged on the board ($BOARD, else $SILO_BUILD_STATE/board.tsv, default
   <this checkout>.state/board.tsv; skipped quietly when there is no file or row).
2. If the merged changes touched app/SiloUI/api/, regenerates the API files once
   (generate_requests and generate_schema, from app/SiloUI) and commits them if they changed.
3. Runs `tools/agent/check --base <sha before the batch>` in the foreground (skipped, with a
   note, if that script does not exist yet) - unless the merged tree is exactly a tree that check
   already recorded as green (a single branch merged on top of its own base).
4. Starts the full suite in the background on the resulting commit, cancelling first a suite still
   running for an older commit of this branch (TERM to its process group; its verdict becomes
   SUPERSEDED, "superseded by <sha>"; a suite for a commit that is not older is never touched, the
   new start is refused). It runs in one fixed worktree, <this checkout>.suite, reset to exactly
   that commit (detached, tracked changes and untracked files removed; ignored build output stays,
   so Cargo stays warm; node_modules, the native runtime and, on the first run, the target folder
   are cloned from this checkout, and refreshed when package-lock.json, package.json or
   runtime-inputs.json change), so edits or merges here cannot change what is tested: cargo nextest run
   --workspace --no-fail-fast (else cargo test --workspace --locked --no-fail-fast), vitest (a
   missing node_modules is a failure), the Python and script suites and the patched updater
   tests that .github/workflows/ci.yml runs. The prepared native runtime comes from
   tools/agent/runtime-cache on a hit, else a copy-on-write clone of this checkout's
   src-tauri/binaries and src-tauri/runtime; github-build.local.json is copied from this checkout
   when present (never printed), else the synthetic SILO_GITHUB_* test values are used. Steps CI
   runs only on Linux (the isolation evals) or with packages this machine lacks (reviewer-service
   needs pytest: a cached venv from reviewer-service/requirements-dev.txt, else skipped) are
   skipped with a note in the log and a "skipped:" line in the verdict, not failed. A runtime-cache
   hit is topped up with any runtime resource it lacks, cloned from this checkout. A second suite
   for a SHA is refused while one runs. It writes
   app/SiloUI/target/agent/full-suite.<sha>.log, .merged (branch<TAB>file lines) and, when it
   ends, .done (first line PASS or FAIL). Do not change the checkout's files while it runs.
--suite takes no branches: after a merge done by hand, it makes the same branch and clean-tree checks,
merges nothing, skips the foreground check and starts step 4 on the current HEAD.
--last prints the newest full-suite verdict (superseded ones only when there is no other); on failure also the failing tests (nextest, cargo test,
Python unittest and pytest, vitest, node --test, and cargo build errors) with their step and, for each,
the merged branches that touched that crate or file.
"""
import argparse, glob, json, os, re, signal, subprocess, sys, time

ROOT = None
WS = "app/SiloUI"


def sh(*a, cwd=None):
    return subprocess.run(a, cwd=cwd or ROOT, capture_output=True, text=True,
                          encoding="utf-8", errors="surrogateescape")


def names(*a):
    """NUL-separated git file list."""
    return [f for f in git(*a, "-z").stdout.split("\0") if f]


def git(*a):
    return sh("git", *a)


def die(msg, code=1):
    print("merge-batch: " + msg, file=sys.stderr)
    sys.exit(code)


def out_dir():
    return os.path.join(ROOT, WS, "target", "agent")


def last(args):
    done = sorted(glob.glob(os.path.join(out_dir(), "full-suite.*.done")), key=os.path.getmtime)
    if not done:
        running = glob.glob(os.path.join(out_dir(), "full-suite.*.log"))
        die("no finished full suite" + (" (one is still running: %s)" % max(running, key=os.path.getmtime) if running else ""))
    real = [x for x in done if not open(x).readline().startswith("SUPERSEDED")]
    d = (real or done)[-1]
    base = d[:-5]
    lines = open(d).read().splitlines()
    print("%s  %s" % (lines[0], os.path.basename(base)))
    print("\n".join(lines[1:]))
    if lines[0] == "PASS":
        return
    if lines[0] == "SUPERSEDED":
        sys.exit(1)
    tests = parse_failures(open(base + ".log", errors="replace").read())
    merged = {}
    try:
        for l in open(base + ".merged"):
            b, _, f = l.rstrip("\n").partition("\t")
            merged.setdefault(b, []).append(f)
    except OSError:
        pass
    crates = crate_dirs()
    failed_steps = []
    for l in lines[1:]:
        if l.startswith("failed:"):
            failed_steps = l[len("failed:"):].split()
    print("\nFailing tests:")
    seen_steps = {t[0].split("/")[0] for t in tests}
    if not tests and not failed_steps:
        print("  (none recognised; read %s.log)" % base)
    for step, kind, key, name, files in sorted(tests):
        if kind == "crate":
            d_ = crates.get(key.replace("_", "-"))
            hit = [b for b, fs in merged.items() if d_ and any(f.startswith(d_ + "/") for f in fs)]
            where = "crate %s" % (d_ or key or "?")
        elif kind == "build":
            d_ = crates.get(key)
            hit = [b for b, fs in merged.items() if d_ and any(f.startswith(d_ + "/") for f in fs)]
            where = "build of %s" % (d_ or key or "?")
        else:
            pre = STEP_PATHS.get(step.split("/")[0], ())
            hit = [b for b, fs in merged.items()
                   if any((key and os.path.basename(f) == key) or f in files or f.startswith(pre) for f in fs)]
            where = "file " + key if key else "step " + step
        print("  [%s] %s  (%s) <- %s" % (step, name, where, ", ".join(hit) or "no merged branch touched it: pre-existing or flaky?"))
    for step in failed_steps:
        if step not in seen_steps:
            print("  [%s] (step failed; no test names recognised: read %s.log, section '== %s')" % (step, base, step))
    sys.exit(1)


# Where a step's tests and code live, for blaming merged branches when the log names no file.
STEP_PATHS = {
    "script-tests": ("app/SiloUI/scripts/",), "macos-release": ("app/SiloUI/scripts/",),
    "release-version": ("app/SiloUI/scripts/", "app/SiloUI/package.json"),
    "command-manifest": ("app/SiloUI/scripts/", "app/SiloUI/src-tauri/build.rs"),
    "release-tests": ("app/SiloUI/scripts/",), "evals": ("docs/evals/",),
    "reviewer-service": ("reviewer-service/",), "updater-tests": ("app/SiloUI/src-tauri/vendor/tauri-plugin-updater/",),
}


def parse_failures(log):
    """Failing tests named in a suite log: a set of (step, kind, key, name, files).

    kind "crate": key is the crate (nextest) or "" (cargo test); "file": key is a test file or module
    file; "build": key is the crate whose build failed. A step is the "== name" line above."""
    out = set()
    step, group = "", ""
    lines = log.splitlines()
    for i, l in enumerate(lines):
        m = re.match(r"^== (\S+)", l)
        if m:
            step, group = m.group(1), ""
            continue
        m = re.match(r"^::group::(\S+) \(FAILED\)", l)
        if m:
            group = m.group(1)
            continue
        if l.startswith("::group::") or l.startswith("::endgroup::"):
            group = ""
            continue
        label = step + ("/" + group if group else "")
        m = re.match(r"^\s*(?:FAIL|TIMEOUT|SIGABRT|SIGSEGV|SIGKILL|LEAK-FAIL)\s+\[[^\]]*\]\s+(\S+)\s+(\S+)", l)  # nextest
        if m:
            out.add((label, "crate", m.group(1).split("::")[0], m.group(2), ()))
            continue
        m = re.match(r"^test (\S+) \.\.\. FAILED", l)  # cargo test
        if m:
            out.add((label, "crate", "", m.group(1), ()))
            continue
        m = re.match(r"^(FAIL|ERROR): (\S+) \(([\w.]+)\)(.*)", l)  # Python unittest
        if m:
            mod = m.group(3).split(".")[0]
            f = re.search(r"file='([^']+)'", m.group(4))
            out.add((label, "file", (group or mod) if (group or mod).endswith(".py") else (group or mod) + ".py",
                     "%s (%s)" % (m.group(2), ".".join(m.group(3).split(".")[:-1]) or m.group(3)),
                     (f.group(1),) if f else ()))
            continue
        m = re.match(r"^(?:FAILED|ERROR) (\S+?\.py)(?:::(\S+))?(?: - .*)?$", l)  # pytest summary
        if m:
            out.add((label, "file", os.path.basename(m.group(1)), (m.group(2) or m.group(1)), ()))
            continue
        m = re.match(r"^\s*(?:FAIL|×)\s+(\S+\.(?:test|spec)\.\w+)(?:\s+>\s+(.*))?", l)  # vitest
        if m:
            out.add((label, "file", m.group(1), (m.group(2) or m.group(1)).strip(), ()))
            continue
        m = re.match(r"^\s*✖ (.+?)(?: \([\d.]+ms\))?$", l)  # node --test
        if m and not re.match(r"(failing tests|\d+)", m.group(1)):
            out.add((label, "file", "", m.group(1), ()))
            continue
        m = re.match(r"^error(?:\[E\d+\])?: (.+)", l)  # cargo build
        if m:
            msg = m.group(1)
            if msg.startswith(("command `", "test failed", "build failed", "aborting due to")):
                continue
            c = re.match(r"could not compile `([\w-]+)`", msg)
            crate = c or re.search(r"`([\w-]+)(?: v[\d.]+)?[ `]", msg)
            msg = re.sub(r" \([^)]*\)`", "`", msg)
            detail = ""
            for j in range(i + 1, min(i + 60, len(lines))):  # a build script's panic message
                if "panicked at" in lines[j] and j + 1 < len(lines):
                    detail = lines[j + 1].strip()
                    break
            out.add((label, "build", crate.group(1) if crate else "", (msg + (" -- " + detail if detail else ""))[:220], ()))
    merged = {}
    for step_, kind, key, name, files in out:
        merged.setdefault((step_, kind, key, name), set()).update(files)
    return {(*k, tuple(sorted(v))) for k, v in merged.items()}


def crate_dirs():
    p = sh("cargo", "metadata", "--no-deps", "--format-version", "1", "--locked", cwd=os.path.join(ROOT, WS))
    if p.returncode:
        return {}
    return {x["name"]: os.path.relpath(os.path.dirname(x["manifest_path"]), ROOT)
            for x in json.loads(p.stdout)["packages"]}


def ancestor(a, b):
    return git("merge-base", "--is-ancestor", a, b).returncode == 0


def worktree_paths():
    out = git("worktree", "list", "--porcelain", "-z").stdout
    return [f[9:] for f in out.replace("\0\0", "\0").split("\0") if f.startswith("worktree ")]


def green_bases(tree):
    """Bases of the full checks that passed on exactly this tree, in any worktree of the repository."""
    found = []
    for wt in worktree_paths():
        try:
            found.append(open(os.path.join(wt, WS, "target", "agent-check", "green", "tree-" + tree)).read().strip())
        except OSError:
            pass
    return found


def unchecked(branch, head, batch):
    """Why `check` has not vouched for this branch's tree, or "" when it has. The check's base must
    be in the history the branch is merged onto, or in an earlier branch of the batch (stacked)."""
    tree = git("rev-parse", branch + "^{tree}").stdout.strip()
    bases = green_bases(tree)
    if not bases:
        return "no green check recorded for its tree: run tools/agent/check in its worktree"
    mb = git("merge-base", head, branch).stdout.strip()
    earlier = batch[:batch.index(branch)]
    if any(ancestor(b, mb) or any(ancestor(b, e) for e in earlier) for b in bases):
        return ""
    return "its green check used a base (%s) that does not cover the whole branch: rerun tools/agent/check" % bases[0][:9]


def mark_merged(branch):
    """state=merged on the board for the item that owns this branch; quiet when there is none."""
    board = os.environ.get("BOARD") or os.path.join(os.environ.get("SILO_BUILD_STATE") or ROOT + ".state", "board.tsv")
    tool = os.path.join(os.path.dirname(os.path.realpath(__file__)), "board")
    try:
        rows = [l.split("\t") for l in open(board).read().splitlines()[1:]]
    except OSError:
        return
    for r in rows:
        if len(r) > 1 and r[1] == branch:
            q = subprocess.run([tool, "--file", board, "set", r[0], "state=merged"], capture_output=True, text=True)
            print("board: %s state=merged" % r[0] if q.returncode == 0 else "note: board not updated for %s: %s" % (r[0], q.stderr.strip()))
            return


def main():
    global ROOT
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--into")
    ap.add_argument("--last", action="store_true")
    ap.add_argument("--suite", action="store_true",
                    help="merge nothing: start the background suite on the current commit")
    ap.add_argument("--force", action="store_true", help="merge branches without a recorded green check")
    ap.add_argument("--no-check", action="store_true", help="skip the foreground check")
    ap.add_argument("--no-suite", action="store_true", help="do not start the background suite")
    ap.add_argument("branches", nargs="*")
    args = ap.parse_args()
    p = git("rev-parse", "--show-toplevel")
    if p.returncode:
        die("not in a git repository")
    ROOT = p.stdout.strip()
    if args.last:
        return last(args)
    if args.suite and (args.branches or args.last):
        ap.error("--suite takes no branches")
    if not args.branches and not args.suite:
        ap.error("give at least one branch (or --suite, or --last)")

    cur = git("symbolic-ref", "-q", "--short", "HEAD").stdout.strip()
    if not cur:
        die("HEAD is detached: run it in the integration checkout, on its branch")
    into = args.into or os.environ.get("BOARD_INTEGRATION") or cur
    if cur != into:
        die("this checkout is on %s, not %s: run it in the integration checkout" % (cur, into))
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        die("the working tree has uncommitted changes")
    for b in args.branches:
        if git("rev-parse", "--verify", "-q", "refs/heads/" + b).returncode:
            die("no such branch: " + b)
    if args.suite:
        start_suite(git("rev-parse", "HEAD").stdout.strip(), [])
        return
    start = git("rev-parse", "HEAD").stdout.strip()

    bad = {}
    for b in args.branches:
        if not ancestor(b, start):
            why = unchecked(b, start, args.branches)
            if why:
                bad[b] = why
    for b, why in bad.items():
        print("%s %s: %s" % ("note: merging anyway (--force)" if args.force else "REFUSED", b, why))
    if bad and not args.force:
        print("nothing was merged. Check the branches (or --force).")
        sys.exit(4)

    merged = []  # (branch, [files])
    for b in args.branches:
        before = git("rev-parse", "HEAD").stdout.strip()
        r = git("merge", "--no-ff", "-m", "Merge %s" % b, b)
        if r.returncode:
            files = names("diff", "--name-only", "--diff-filter=U")
            git("merge", "--abort")
            print("CONFLICT merging %s into %s; merge aborted. Conflicting files:" % (b, cur))
            print("\n".join("  " + f for f in files) or r.stdout + r.stderr)
            print("Already merged: %s" % (", ".join(x for x, _ in merged) or "nothing"))
            sys.exit(2)
        after = git("rev-parse", "HEAD").stdout.strip()
        files = names("diff", "--name-only", before, after) if after != before else []
        print("merged %s (%d files)%s" % (b, len(files), "" if after != before else " - already contained"))
        merged.append((b, files))
        if after != before:
            mark_merged(b)

    touched = {f for _, fs in merged for f in fs}
    if any(f.startswith(WS + "/api/") for f in touched):
        cwd = os.path.join(ROOT, WS)
        for ex in ("generate_requests", "generate_schema"):
            r = sh("cargo", "run", "-q", "-p", "silo-api", "--example", ex, cwd=cwd)
            if r.returncode:
                die("%s failed:\n%s" % (ex, r.stderr[-2000:]), 3)
        if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
            git("add", "-u")
            git("commit", "-q", "-m", "Regenerate API files after merging the batch")
            print("regenerated API files and committed")
        else:
            print("API files already up to date")
        merged_files = names("diff", "--name-only", start, "HEAD")
        merged.append(("api-regeneration", [f for f in merged_files if f not in touched]))

    head = git("rev-parse", "HEAD").stdout.strip()
    rc = 0
    check = os.path.join(ROOT, "tools", "agent", "check")
    if args.no_check:
        pass
    elif not bad and head != start and git("rev-parse", "HEAD^{tree}").stdout.strip() in [
            git("rev-parse", b + "^{tree}").stdout.strip() for b, _ in merged if b in args.branches]:
        print("check skipped: the merged tree is exactly the tree of a branch that check recorded as green")
    elif os.path.exists(check):
        print("== check --base %s" % start[:9])
        rc = subprocess.run([check, "--base", start], cwd=ROOT).returncode
        print("== check exit %d" % rc)
    else:
        print("note: tools/agent/check not found; skipped the foreground check")

    if not args.no_suite:
        start_suite(head, merged)
    sys.exit(1 if rc else 0)


SUITE = r'''
root="$1"; base="$2"; sha="$3"; wt="$4"; log="$base.log"; fail=""
cleanup() { [ "$(cat "$base.running" 2>/dev/null)" = "$$" ] && rm -f "$base.running"; }
trap cleanup EXIT
echo "== full suite on $sha started $(date)" > "$log"
die() { printf 'FAIL\nfailed: %s\n' "$1" > "$base.done"; echo "suite: $1" >> "$log"; exit 1; }
# One fixed worktree per integration checkout, reset to exactly $sha. Only a worktree registered for this repository
# (or an empty folder) is ever touched; ignored build output (target, node_modules, runtime) stays, so Cargo stays warm.
if git -C "$root" worktree list --porcelain | grep -qx "worktree $wt"; then
  [ -e "$wt/.git" ] || { git -C "$root" worktree prune; }
fi
if git -C "$root" worktree list --porcelain | grep -qx "worktree $wt"; then
  [ "$(git -C "$wt" symbolic-ref -q HEAD)" ] && die "worktree: $wt has a branch checked out; it is not a suite worktree"
  git -C "$wt" checkout -q -f --detach "$sha" >> "$log" 2>&1 && git -C "$wt" reset -q --hard "$sha" >> "$log" 2>&1 \
    && git -C "$wt" clean -fdq >> "$log" 2>&1 || die "worktree: cannot reset $wt to $sha"
else
  { [ ! -e "$wt" ] || [ -z "$(ls -A "$wt" 2>/dev/null)" ]; } || die "worktree: $wt exists and is not a worktree of this repository"
  git -C "$root" worktree add -q --detach "$wt" "$sha" >> "$log" 2>&1 || die "worktree"
fi
[ "$(git -C "$wt" rev-parse HEAD)" = "$sha" ] && [ -z "$(git -C "$wt" status --porcelain)" ] || die "worktree: $wt is not clean at $sha"
src="$root/app/SiloUI"; dst="$wt/app/SiloUI"
cl() { cp -cR "$1" "$2" 2>/dev/null || cp -R "$1" "$2"; }
# Ignored inputs cloned from the integration checkout: node_modules and the native runtime, on the first run and
# again whenever the files that decide them change. The target folder is never copied: mbx manages it per checkout
# (a copy of the integration checkout's target link would make both share one build folder).
stamp=$(cat "$dst/package-lock.json" "$dst/package.json" "$dst/runtime-inputs.json" 2>/dev/null | shasum | cut -c1-40)
if [ "$(cat "$dst/target/.suite-stamp" 2>/dev/null)" != "$stamp" ]; then
  rm -rf "$dst/node_modules" "$dst/src-tauri/runtime" "$dst/src-tauri/binaries"
fi
mkdir -p "$dst/target"; echo "$stamp" > "$dst/target/.suite-stamp"
[ -e "$dst/node_modules" ] || [ ! -d "$src/node_modules" ] || { cp -cR "$src/node_modules" "$dst/node_modules" 2>/dev/null || ln -s "$src/node_modules" "$dst/node_modules"; }
export SILO_AGENT_CACHE="${SILO_AGENT_CACHE:-$([ "$(uname -s)" = Darwin ] && echo "$HOME/Library/Caches/silo-agent" || echo "$HOME/.cache/silo-agent")}"
skipped=""
skip() { echo "== $1: skipped ($2)" >> "$log"; skipped="$skipped""skipped: $1 ($2)"$'\n'; }
# The native runtime (bundled msb and the other tools) is ignored build output that silo-ui's build script needs.
# A runtime-cache hit restores what it stores; the rest is cloned from the integration checkout.
if [ -x "$wt/tools/agent/runtime-cache" ] && (cd "$wt" && ./tools/agent/runtime-cache --status 2>/dev/null) | grep -qx hit; then
  (cd "$wt" && ./tools/agent/runtime-cache) >> "$log" 2>&1
fi
# Whatever a cache hit does not restore (and everything on a miss) is cloned from the integration checkout, entry by entry.
for d in binaries runtime; do
  [ -d "$src/src-tauri/$d" ] || continue
  mkdir -p "$dst/src-tauri/$d"
  for e in "$src/src-tauri/$d"/*; do
    [ -e "$e" ] && [ ! -e "$dst/src-tauri/$d/$(basename "$e")" ] && cl "$e" "$dst/src-tauri/$d/"
  done
done
[ -d "$dst/src-tauri/binaries" ] || echo "note: no prepared native runtime (runtime-cache miss and none in $src/src-tauri); the silo-ui build will fail" >> "$log"
# The private GitHub build file is copied, never printed; without it the synthetic test values apply.
if [ -f "$src/github-build.local.json" ]; then
  cp "$src/github-build.local.json" "$dst/github-build.local.json"
else
  export SILO_GITHUB_APP_SLUG=silo-ci-test SILO_GITHUB_CLIENT_ID=test-client SILO_GITHUB_CLIENT_SECRET=test-secret
fi
cd "$dst" || { printf 'FAIL\nfailed: no app/SiloUI at %s\n' "$sha" > "$base.done"; exit 1; }
step() { name="$1"; shift; echo "== $name" >> "$log"; "$@" >> "$log" 2>&1 || fail="$fail $name"; }
if cargo nextest --version >/dev/null 2>&1; then
  step rust cargo nextest run --workspace --no-fail-fast --profile ci
else
  step rust cargo test --workspace --locked --no-fail-fast
fi
if [ -d node_modules ]; then step vitest npx vitest run; else echo "== vitest: no node_modules (failure)" >> "$log"; fail="$fail vitest-missing-node_modules"; fi
step release-version python3 scripts/validate-release-version.py
step command-manifest python3 scripts/check-command-manifest.py
step script-tests python3 scripts/run-script-tests.py
step macos-release python3 -m unittest discover -s scripts -p test_macos_release.py
if [ "$(uname -s)" = Linux ]; then step evals python3 -m unittest discover -s ../../docs/evals -p "test_*.py"
else skip evals "ci.yml runs the isolation evals on Linux only; they read /proc/self/mountinfo"; fi
# ci.yml installs reviewer-service/requirements-dev.txt; here that goes into a venv cached by the file's hash.
py=python3
if ! python3 -c "import pytest" >/dev/null 2>&1; then
  req=../../reviewer-service/requirements-dev.txt
  key=$(shasum -a 256 "$req" | cut -c1-16)
  venv="$SILO_AGENT_CACHE/venv/reviewer-service-$key"
  if [ ! -x "$venv/bin/python" ]; then
    mkdir -p "$SILO_AGENT_CACHE/venv"
    tmpv="$venv.$$"
    if python3 -m venv "$tmpv" >> "$log" 2>&1 && "$tmpv/bin/python" -m pip install --quiet -r "$req" >> "$log" 2>&1 && mv "$tmpv" "$venv" 2>/dev/null; then :; else rm -rf "$tmpv"; fi
  fi
  [ -x "$venv/bin/python" ] && py="$venv/bin/python" || py=""
fi
if [ -n "$py" ]; then step reviewer-service "$py" -m pytest -q ../../reviewer-service
else skip reviewer-service "pytest is not installed and a venv from reviewer-service/requirements-dev.txt could not be built"; fi
step release-tests npm run test:release
step updater-tests cargo test --manifest-path src-tauri/Cargo.toml --locked -p tauri-plugin-updater --lib
if [ -z "$fail" ]; then echo PASS > "$base.done"; else echo FAIL > "$base.done"; echo "failed:$fail" >> "$base.done"; fi
[ -n "$skipped" ] && printf %s "$skipped" >> "$base.done"
echo "sha $sha" >> "$base.done"
echo "finished $(date)" >> "$base.done"
'''


def running(path):
    try:
        os.kill(int(open(path).read().strip() or 0), 0)
        return True
    except (OSError, ValueError):
        return False


def supersede(sha):
    """Stop every suite still running for another commit, which must be older than `sha` (TERM to its
    process group, then wait); its verdict becomes SUPERSEDED. Refuses, touching nothing it cannot
    identify as a suite of this checkout, when one is not older or does not stop."""
    for g in sorted(glob.glob(os.path.join(out_dir(), "full-suite.*.running"))):
        old = os.path.basename(g)[len("full-suite."):-len(".running")]
        if old == sha or not running(g):
            continue
        if not ancestor(old, sha):
            die("a full suite for %s is running and %s is not newer than it; wait for it or stop it" % (old[:9], sha[:9]), 3)
        pid = int(open(g).read().strip())
        cmd = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
        if pid == os.getpid() or os.getpgid(pid) != pid or "full-suite." + old not in cmd:
            die("the guard %s names pid %d, which is not that suite's process group; not touching it" % (g, pid), 3)
        os.killpg(pid, signal.SIGTERM)
        for _ in range(240):
            if not running(g) or not os.path.exists(g):
                break
            time.sleep(0.5)
        else:
            die("the suite for %s did not stop within 2 minutes after TERM; start again when it has" % old[:9], 3)
        base = g[:-len(".running")]
        with open(base + ".done", "w") as f:
            f.write("SUPERSEDED\nsuperseded by %s\nsha %s\nfinished %s\n" % (sha, old, time.ctime()))
        try:
            os.remove(g)
        except OSError:
            pass
        print("cancelled the running suite for %s (superseded by %s)" % (old[:9], sha[:9]))


def start_suite(sha, merged):
    d = out_dir()
    os.makedirs(d, exist_ok=True)
    base = os.path.join(d, "full-suite." + sha)
    guard = base + ".running"
    # The guard is created exclusively. A guard whose pid is dead is replaced while holding a
    # takeover lock (mkdir), re-reading the guard under it, so two starters cannot remove each
    # other's fresh guard.
    fd = None
    for _ in range(2):
        try:
            fd = os.open(guard, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            break
        except FileExistsError:
            if running(guard):
                die("a full suite for %s is already running or starting (%s.log)" % (sha[:9], base), 3)
            try:
                os.mkdir(guard + ".takeover")
            except FileExistsError:
                die("another starter is replacing a stale guard for %s; if none is, remove %s.takeover" % (sha[:9], guard), 3)
            try:
                if not running(guard):
                    os.remove(guard)
            except OSError:
                pass
            finally:
                os.rmdir(guard + ".takeover")
    if fd is None:
        die("cannot take the start guard for %s (%s)" % (sha[:9], guard), 3)
    os.write(fd, str(os.getpid()).encode())
    os.close(fd)
    try:
        supersede(sha)
    except SystemExit:
        os.remove(guard)
        raise
    for ext in (".done", ".log", ".merged"):
        if os.path.exists(base + ext):
            os.remove(base + ext)
    with open(base + ".merged", "w") as f:
        for b, fs in merged:
            for x in fs:
                f.write("%s\t%s\n" % (b, x))
    wt = ROOT + ".suite"
    p = subprocess.Popen(["bash", "-c", SUITE, "x", ROOT, base, sha, wt], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        with open(guard, "r+") as f:
            f.write(str(p.pid))
    except OSError:
        pass
    print("full suite started in the background on %s (fixed worktree %s)" % (sha[:9], wt))
    print("  log:     %s.log" % base)
    print("  verdict: %s.done (appears when it ends; first line PASS or FAIL)" % base)
    print("  later:   tools/agent/merge-batch --last")


if __name__ == "__main__":
    main()
