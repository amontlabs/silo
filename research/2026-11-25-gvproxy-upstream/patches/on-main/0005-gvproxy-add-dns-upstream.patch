@@ -8,8 +8,10 @@ import (
 	"net"
 	"net/http"
 	"regexp"
+	"slices"
 	"strings"
 	"sync"
+	"sync/atomic"
 
 	"github.com/containers/gvisor-tap-vsock/pkg/apilog"
 	"github.com/containers/gvisor-tap-vsock/pkg/types"
@@ -38,6 +40,9 @@ type dnsHandler struct {
 	// forwarded query so that changes to the host's DNS servers are followed.
 	nameservers func() []string
 	client      *dns.Client
+	// refuseUpstream answers REFUSED for every name no zone holds, and asks
+	// no upstream server.
+	refuseUpstream bool
 }
 
 func (h *dnsHandler) handle(w dns.ResponseWriter, r *dns.Msg, responseMessageSize int) {
@@ -151,6 +156,11 @@ func (h *dnsHandler) addAnswers(m *dns.Msg) {
 		if done := h.addLocalAnswers(m, q); done {
 			return
 		}
+		if h.refuseUpstream {
+			m.Rcode = dns.RcodeRefused
+			m.RecursionAvailable = false
+			return
+		}
 
 		resolver := h.upstream
 		switch q.Qtype {
@@ -345,6 +355,53 @@ func NewWithUpstreamResolver(udpConn net.PacketConn, tcpLn net.Listener, zones [
 	return &Server{udpConn: udpConn, tcpLn: tcpLn, handler: handler}, nil
 }
 
+// UpstreamNone, as the only entry of the servers given to
+// NewWithUpstreamServers, refuses every name no zone holds.
+const UpstreamNone = "none"
+
+// NewWithUpstreamServers is New with the names that no zone holds sent to
+// servers, each an "ip:port", instead of to the host's resolver. Every record
+// type goes to them, through the same code paths as with the host's resolver.
+// With servers set to []string{UpstreamNone}, those names are answered
+// REFUSED and nothing is asked. With no servers, it is New.
+func NewWithUpstreamServers(udpConn net.PacketConn, tcpLn net.Listener, zones []types.Zone, servers []string) (*Server, error) {
+	if len(servers) == 0 {
+		return New(udpConn, tcpLn, zones)
+	}
+	if len(servers) == 1 && servers[0] == UpstreamNone {
+		s, err := NewWithUpstreamResolver(udpConn, tcpLn, zones, &net.Resolver{})
+		if err != nil {
+			return nil, err
+		}
+		s.handler.refuseUpstream = true
+		s.handler.nameservers = func() []string { return nil }
+		return s, nil
+	}
+	for _, server := range servers {
+		host, _, err := net.SplitHostPort(server)
+		if err != nil || net.ParseIP(host) == nil {
+			return nil, fmt.Errorf("dns upstream %q: not an ip:port", server)
+		}
+	}
+	list := slices.Clone(servers)
+	var next atomic.Uint32
+	resolver := &net.Resolver{
+		PreferGo: true,
+		// The Go resolver dials each server of the host's resolv.conf in
+		// turn; send every attempt to the configured servers instead.
+		Dial: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			var d net.Dialer
+			return d.DialContext(ctx, network, list[int(next.Add(1)-1)%len(list)])
+		},
+	}
+	s, err := NewWithUpstreamResolver(udpConn, tcpLn, zones, resolver)
+	if err != nil {
+		return nil, err
+	}
+	s.handler.nameservers = func() []string { return list }
+	return s, nil
+}
+
 func (s *Server) Serve() error {
 	mux := dns.NewServeMux()
 	mux.HandleFunc(".", s.handler.handleUDP)
diff --git a/pkg/services/dns/dns_test.go b/pkg/services/dns/dns_test.go
index edc29f42..458579d0 100644
--- a/pkg/services/dns/dns_test.go
+++ b/pkg/services/dns/dns_test.go
@@ -841,3 +841,67 @@ func startDNSServer(upstream upstreamResolver) (string, func(), error) {
 		tcpLn.Close()
 	}, nil
 }
+
+var _ = ginkgo.Describe("upstream servers", func() {
+	query := func(server *Server, name string, qtype uint16) *dns.Msg {
+		m := new(dns.Msg)
+		m.SetQuestion(name, qtype)
+		server.handler.addAnswers(m)
+		return m
+	}
+	zones := []types.Zone{{
+		Name:    "containers.internal.",
+		Records: []types.Record{{Name: "gateway", IP: net.ParseIP("192.168.127.1")}},
+	}}
+
+	ginkgo.It("none refuses every name outside the zones and asks nobody", func() {
+		server, err := NewWithUpstreamServers(nil, nil, zones, []string{UpstreamNone})
+		gomega.Expect(err).ToNot(gomega.HaveOccurred())
+		server.handler.upstream = &failingResolver{err: errors.New("the upstream resolver must not be asked")}
+		server.handler.nameservers = func() []string { panic("no nameserver may be asked") }
+		for _, qtype := range []uint16{dns.TypeA, dns.TypeAAAA, dns.TypeTXT, dns.TypePTR, dns.TypeSOA} {
+			m := query(server, "x1234.exfil.example.", qtype)
+			gomega.Expect(m.Rcode).To(gomega.Equal(dns.RcodeRefused), dns.TypeToString[qtype])
+			gomega.Expect(m.Answer).To(gomega.BeEmpty())
+		}
+		m := query(server, "gateway.containers.internal.", dns.TypeA)
+		gomega.Expect(m.Rcode).To(gomega.Equal(dns.RcodeSuccess))
+		gomega.Expect(m.Answer[0].(*dns.A).A.String()).To(gomega.Equal("192.168.127.1"))
+	})
+
+	ginkgo.It("sends every record type outside the zones to the servers given", func() {
+		mockSrv, err := mockdns.NewServer(map[string]mockdns.Zone{
+			"allowed.example.":           {A: []string{"203.0.113.10"}, TXT: []string{"from the configured server"}},
+			"10.113.0.203.in-addr.arpa.": {PTR: []string{"allowed.example."}},
+		}, false)
+		gomega.Expect(err).ToNot(gomega.HaveOccurred())
+		defer mockSrv.Close()
+		server, err := NewWithUpstreamServers(nil, nil, zones, []string{mockSrv.LocalAddr().String()})
+		gomega.Expect(err).ToNot(gomega.HaveOccurred())
+
+		m := query(server, "allowed.example.", dns.TypeA)
+		gomega.Expect(m.Rcode).To(gomega.Equal(dns.RcodeSuccess))
+		gomega.Expect(m.Answer).To(gomega.HaveLen(1))
+		gomega.Expect(m.Answer[0].(*dns.A).A.String()).To(gomega.Equal("203.0.113.10"))
+
+		m = query(server, "allowed.example.", dns.TypeTXT)
+		gomega.Expect(m.Answer[0].(*dns.TXT).Txt).To(gomega.Equal([]string{"from the configured server"}))
+
+		m = query(server, "10.113.0.203.in-addr.arpa.", dns.TypePTR)
+		gomega.Expect(m.Answer).To(gomega.HaveLen(1))
+		gomega.Expect(m.Answer[0].(*dns.PTR).Ptr).To(gomega.Equal("allowed.example."))
+
+		m = query(server, "unknown.example.", dns.TypeA)
+		gomega.Expect(m.Rcode).To(gomega.Equal(dns.RcodeNameError))
+
+		m = query(server, "gateway.containers.internal.", dns.TypeA)
+		gomega.Expect(m.Answer[0].(*dns.A).A.String()).To(gomega.Equal("192.168.127.1"))
+	})
+
+	ginkgo.It("refuses a server it cannot read", func() {
+		for _, bad := range []string{"127.0.0.1", "resolver.example:53", "none:53"} {
+			_, err := NewWithUpstreamServers(nil, nil, nil, []string{bad})
+			gomega.Expect(err).To(gomega.HaveOccurred(), bad)
+		}
+	})
+})
