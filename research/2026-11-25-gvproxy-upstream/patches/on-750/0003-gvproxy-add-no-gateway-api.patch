 }
 
 type GvproxyConfig struct {
@@ -70,6 +71,7 @@ type GvproxyConfig struct {
 	Ec2MetadataAccess  bool                   `yaml:"ec2-metadata-access,omitempty"`
 	NotificationSocket string                 `yaml:"notification,omitempty"`
 	APITokenFile       string                 `yaml:"api-token-file,omitempty"`
+	NoGatewayAPI       bool                   `yaml:"no-gateway-api,omitempty"`
 }
 
 type GvproxyConfigForward struct {
@@ -144,6 +146,7 @@ func GvproxyArgParse(flagSet *flag.FlagSet, args *GvproxyArgs, argv []string) (*
 	flagSet.BoolVar(&args.ec2MetadataAccess, "ec2-metadata-access", false, "Permits access to EC2 Metadata Service and Amazon Time Sync Service")
 	flagSet.StringVar(&args.notificationSocket, "notification", "", "Socket to be used to send network-ready notifications")
 	flagSet.StringVar(&args.apiTokenFile, "api-token-file", "", "Path to file where API token will be read from (needs 0600 permissions on macOS and Linux)")
+	flagSet.BoolVar(&args.noGatewayAPI, "no-gateway-api", false, "Do not serve the HTTP API on the gateway's port 80 inside the virtual network; -listen and -services are not affected")
 	if err := flagSet.Parse(argv); err != nil {
 		return nil, err
 	}
@@ -318,6 +321,9 @@ func GvproxyConfigure(config *GvproxyConfig, args *GvproxyArgs, version string)
 	if args.apiTokenFile != "" {
 		config.APITokenFile = args.apiTokenFile
 	}
+	if args.noGatewayAPI {
+		config.NoGatewayAPI = true
+	}
 	if args.bootFileName != "" {
 		config.Stack.BootFileName = args.bootFileName
 	}
diff --git a/cmd/gvproxy/config_test.go b/cmd/gvproxy/config_test.go
index 9076539d..7ace7645 100644
--- a/cmd/gvproxy/config_test.go
+++ b/cmd/gvproxy/config_test.go
@@ -769,3 +769,26 @@ func TestEc2MetadataAccessReachesTheStack(t *testing.T) {
 		assert.Equal(t, v.want, cnf.Stack.Ec2MetadataAccess, v.name)
 	}
 }
+
+func TestNoGatewayAPI(t *testing.T) {
+	t.Parallel()
+	for _, v := range []struct {
+		name   string
+		argv   []string
+		config string
+		want   bool
+	}{
+		{"default", nil, "", false},
+		{"flag", []string{"-no-gateway-api"}, "", true},
+		{"config file", nil, "no-gateway-api: true\n", true},
+	} {
+		var cnf GvproxyConfig
+		var args GvproxyArgs
+		_, err := GvproxyArgParse(flag.NewFlagSet(os.Args[0], flag.ContinueOnError), &args, v.argv)
+		require.NoError(t, err, v.name)
+		require.NoError(t, yaml.Unmarshal([]byte(v.config), &cnf), v.name)
+		_, err = GvproxyConfigure(&cnf, &args, "testing")
+		require.NoError(t, err, v.name)
+		assert.Equal(t, v.want, cnf.NoGatewayAPI, v.name)
+	}
+}
