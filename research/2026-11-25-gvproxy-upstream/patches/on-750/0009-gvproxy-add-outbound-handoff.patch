+func TestOutboundHandoff(t *testing.T) {
+	t.Parallel()
+	for _, v := range []struct {
+		name, config string
+		argv         []string
+		want         string
+	}{
+		{"default", "", nil, ""},
+		{"flag", "", []string{"-outbound-handoff", "/run/boundary.sock"}, "/run/boundary.sock"},
+		{"config file", "stack:\n  outboundHandoff: /run/b.sock\n", nil, "/run/b.sock"},
+	} {
+		var cnf GvproxyConfig
+		var args GvproxyArgs
+		_, err := GvproxyArgParse(flag.NewFlagSet(os.Args[0], flag.ContinueOnError), &args, v.argv)
+		require.NoError(t, err, v.name)
+		require.NoError(t, yaml.Unmarshal([]byte(v.config), &cnf), v.name)
+		_, err = GvproxyConfigure(&cnf, &args, "testing")
+		require.NoError(t, err, v.name)
+		assert.Equal(t, v.want, cnf.Stack.OutboundHandoff, v.name)
+	}
+}
diff --git a/pkg/outbound/handoff.go b/pkg/outbound/handoff.go
new file mode 100644
index 00000000..c12d54d3
--- /dev/null
+++ b/pkg/outbound/handoff.go
@@ -0,0 +1,74 @@
+package outbound
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+)
+
+// proxyV2Signature opens every PROXY protocol version 2 header.
+var proxyV2Signature = []byte("\r\n\r\n\x00\r\nQUIT\n")
+
+// ProxyHeaderV2 is the PROXY protocol version 2 header of a TCP connection
+// from src to dst, as HAProxy specifies it
+// (https://www.haproxy.org/download/3.0/doc/proxy-protocol.txt).
+func ProxyHeaderV2(src, dst netip.AddrPort) []byte {
+	h := append([]byte{}, proxyV2Signature...)
+	s, d := src.Addr().Unmap(), dst.Addr().Unmap()
+	var addrs []byte
+	if s.Is4() && d.Is4() {
+		h = append(h, 0x21, 0x11, 0x00, 12) // version 2, PROXY; TCP over IPv4; 12 bytes follow
+		a, b := s.As4(), d.As4()
+		addrs = append(append(addrs, a[:]...), b[:]...)
+	} else {
+		h = append(h, 0x21, 0x21, 0x00, 36) // version 2, PROXY; TCP over IPv6; 36 bytes follow
+		a, b := src.Addr().As16(), dst.Addr().As16()
+		addrs = append(append(addrs, a[:]...), b[:]...)
+	}
+	addrs = binary.BigEndian.AppendUint16(addrs, src.Port())
+	addrs = binary.BigEndian.AppendUint16(addrs, dst.Port())
+	return append(h, addrs...)
+}
+
+// Handoff returns a dialer, for types.Configuration.DialTCP, that opens no
+// connection to the destination. It connects to the unix socket at path and
+// writes a PROXY protocol v2 header with the guest's address and the
+// destination dialled after NAT translation. Whatever listens on the socket
+// (a proxy, a firewall, a recorder) then decides and opens the connection.
+func Handoff(path string) func(context.Context, netip.AddrPort, types.DialRequest) (net.Conn, error) {
+	return func(ctx context.Context, source netip.AddrPort, req types.DialRequest) (net.Conn, error) {
+		var d net.Dialer
+		conn, err := d.DialContext(ctx, "unix", path)
+		if err != nil {
+			return nil, err
+		}
+		if deadline, ok := ctx.Deadline(); ok {
+			_ = conn.SetWriteDeadline(deadline)
+		}
+		if _, err := conn.Write(ProxyHeaderV2(source, req.DialAddress)); err != nil {
+			conn.Close()
+			return nil, fmt.Errorf("handoff to %s: %w", path, err)
+		}
+		_ = conn.SetWriteDeadline(time.Time{})
+		return conn, nil
+	}
+}
+
+// ErrHandoffTCPOnly refuses UDP and ICMP when connections are handed off:
+// only TCP can be handed to a stream socket, and nothing else may leave.
+var ErrHandoffTCPOnly = errors.New("only TCP is handed off")
+
+// HandoffFilter is the dial filter that goes with Handoff: it refuses
+// everything but TCP.
+func HandoffFilter(req types.DialRequest) error {
+	if req.Network != "tcp" {
+		return ErrHandoffTCPOnly
+	}
+	return nil
+}
diff --git a/pkg/outbound/handoff_test.go b/pkg/outbound/handoff_test.go
new file mode 100644
index 00000000..3abe59cc
--- /dev/null
+++ b/pkg/outbound/handoff_test.go
@@ -0,0 +1,102 @@
+package outbound
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/netip"
+	"path/filepath"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+)
+
+var _ = ginkgo.Describe("PROXY protocol v2 header", func() {
+	ginkgo.It("encodes TCP over IPv4 as the specification lays it out", func() {
+		h := ProxyHeaderV2(netip.MustParseAddrPort("192.168.127.2:40000"), netip.MustParseAddrPort("203.0.113.10:443"))
+		gomega.Expect(h).To(gomega.Equal([]byte{
+			0x0d, 0x0a, 0x0d, 0x0a, 0x00, 0x0d, 0x0a, 0x51, 0x55, 0x49, 0x54, 0x0a, // signature
+			0x21,       // version 2, PROXY
+			0x11,       // AF_INET, STREAM
+			0x00, 0x0c, // 12 bytes follow
+			192, 168, 127, 2, 203, 0, 113, 10,
+			0x9c, 0x40, 0x01, 0xbb,
+		}))
+	})
+
+	ginkgo.It("encodes TCP over IPv6 as the specification lays it out", func() {
+		h := ProxyHeaderV2(netip.MustParseAddrPort("[fd00::2]:40000"), netip.MustParseAddrPort("[2001:db8::10]:443"))
+		gomega.Expect(h[12:16]).To(gomega.Equal([]byte{0x21, 0x21, 0x00, 0x24}))
+		gomega.Expect(h).To(gomega.HaveLen(16 + 36))
+		gomega.Expect(h[16:32]).To(gomega.Equal(netip.MustParseAddr("fd00::2").AsSlice()))
+		gomega.Expect(h[32:48]).To(gomega.Equal(netip.MustParseAddr("2001:db8::10").AsSlice()))
+		gomega.Expect(h[48:]).To(gomega.Equal([]byte{0x9c, 0x40, 0x01, 0xbb}))
+	})
+
+	ginkgo.It("encodes IPv4-mapped IPv6 addresses as IPv4", func() {
+		h := ProxyHeaderV2(netip.MustParseAddrPort("[::ffff:192.168.127.2]:1"), netip.MustParseAddrPort("[::ffff:203.0.113.10]:2"))
+		gomega.Expect(h[13]).To(gomega.Equal(byte(0x11)))
+	})
+})
+
+var _ = ginkgo.Describe("Handoff", func() {
+	req := types.DialRequest{
+		Network:     "tcp",
+		Destination: netip.MustParseAddrPort("192.168.127.254:8080"),
+		DialAddress: netip.MustParseAddrPort("127.0.0.1:8080"),
+	}
+	source := netip.MustParseAddrPort("192.168.127.2:40000")
+
+	ginkgo.It("writes the header, then carries the connection both ways", func() {
+		path := filepath.Join(ginkgo.GinkgoT().TempDir(), "handoff.sock")
+		ln, err := net.Listen("unix", path)
+		gomega.Expect(err).ToNot(gomega.HaveOccurred())
+		defer ln.Close()
+		got := make(chan []byte, 1)
+		go func() {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			defer c.Close()
+			buf := make([]byte, 28+5)
+			if _, err := io.ReadFull(c, buf); err != nil {
+				return
+			}
+			got <- buf
+			_, _ = c.Write([]byte("world"))
+		}()
+
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		conn, err := Handoff(path)(ctx, source, req)
+		gomega.Expect(err).ToNot(gomega.HaveOccurred())
+		defer conn.Close()
+		_, err = conn.Write([]byte("hello"))
+		gomega.Expect(err).ToNot(gomega.HaveOccurred())
+		var buf []byte
+		gomega.Eventually(got, 5*time.Second).Should(gomega.Receive(&buf))
+		gomega.Expect(buf[:28]).To(gomega.Equal(ProxyHeaderV2(source, req.DialAddress)))
+		gomega.Expect(string(buf[28:])).To(gomega.Equal("hello"))
+		reply := make([]byte, 5)
+		_, err = io.ReadFull(conn, reply)
+		gomega.Expect(err).ToNot(gomega.HaveOccurred())
+		gomega.Expect(string(reply)).To(gomega.Equal("world"))
+	})
+
+	ginkgo.It("fails when nothing listens, so the guest's connection is reset", func() {
+		_, err := Handoff(filepath.Join(ginkgo.GinkgoT().TempDir(), "none.sock"))(context.Background(), source, req)
+		gomega.Expect(err).To(gomega.HaveOccurred())
+	})
+
+	ginkgo.It("goes with a filter that lets only TCP through", func() {
+		gomega.Expect(HandoffFilter(req)).To(gomega.Succeed())
+		for _, network := range []string{"udp", "icmp"} {
+			r := req
+			r.Network = network
+			gomega.Expect(HandoffFilter(r)).To(gomega.MatchError(ErrHandoffTCPOnly))
+		}
+	})
+})
