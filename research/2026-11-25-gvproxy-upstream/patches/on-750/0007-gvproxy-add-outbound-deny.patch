diff --git a/pkg/types/configuration.go b/pkg/types/configuration.go
index 1e3d7ba8..dfc3361d 100644
--- a/pkg/types/configuration.go
+++ b/pkg/types/configuration.go
@@ -75,6 +75,13 @@ type Configuration struct {
 	// "ip:port". The single entry "none" refuses those names and asks nobody.
 	DNSUpstream []string `yaml:"dnsUpstream,omitempty"`
 
+	// OutboundDeny lists destinations that no connection of the guest may
+	// reach, checked on the address dialled after NAT translation, for TCP,
+	// UDP and ICMP. Each entry is an address, a CIDR, "private", "host",
+	// "host-networks" or "all"; see outbound.ParseDenyList. It applies
+	// before DialFilter.
+	OutboundDeny []string `yaml:"outboundDeny,omitempty"`
+
 	// DialFilter, when set, is consulted before every connection the
 	// forwarders open for the guest. A non-nil error refuses it: TCP answers
 	// the guest with a reset, UDP and ICMP are dropped.
