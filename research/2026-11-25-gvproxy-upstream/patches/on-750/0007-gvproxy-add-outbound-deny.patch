+package outbound
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+)
+
+// fakeHost returns interface addresses as an office host would have them:
+// a loopback, an address on a local network with public addresses, and a
+// global IPv6 address.
+func fakeHost() ([]net.Addr, error) {
+	var addrs []net.Addr
+	for _, c := range []string{"127.0.0.1/8", "198.51.100.1/24", "2001:db8:5::10/64"} {
+		ip, n, err := net.ParseCIDR(c)
+		if err != nil {
+			return nil, err
+		}
+		n.IP = ip
+		addrs = append(addrs, n)
+	}
+	return addrs, nil
+}
+
+func parse(entries ...string) *DenyList {
+	d, err := ParseDenyList(entries)
+	gomega.Expect(err).ToNot(gomega.HaveOccurred())
+	d.interfaceAddrs = fakeHost
+	return d
+}
+
+var _ = ginkgo.Describe("outbound deny list", func() {
+	ginkgo.DescribeTable("private",
+		func(ip string, denied bool) {
+			gomega.Expect(parse("private").Contains(netip.MustParseAddr(ip))).To(gomega.Equal(denied))
+		},
+		ginkgo.Entry("loopback", "127.0.0.1", true),
+		ginkgo.Entry("loopback, another address", "127.8.9.10", true),
+		ginkgo.Entry("RFC 1918 10/8", "10.77.0.2", true),
+		ginkgo.Entry("RFC 1918 172.16/12", "172.31.255.1", true),
+		ginkgo.Entry("RFC 1918 192.168/16", "192.168.1.1", true),
+		ginkgo.Entry("carrier-grade NAT", "100.100.100.100", true),
+		ginkgo.Entry("link-local, cloud metadata", "169.254.169.254", true),
+		ginkgo.Entry("this network", "0.0.0.1", true),
+		ginkgo.Entry("multicast", "224.0.0.251", true),
+		ginkgo.Entry("broadcast", "255.255.255.255", true),
+		ginkgo.Entry("IPv4-mapped IPv6 of a private address", "::ffff:192.168.1.1", true),
+		ginkgo.Entry("IPv6 loopback", "::1", true),
+		ginkgo.Entry("IPv6 unique local", "fd00::1", true),
+		ginkgo.Entry("IPv6 link-local", "fe80::1", true),
+		ginkgo.Entry("the internet", "203.0.113.10", false),
+		ginkgo.Entry("the internet over IPv6", "2001:db8::1", false),
+		ginkgo.Entry("IPv4-mapped IPv6 of the internet", "::ffff:203.0.113.10", false),
+	)
+
+	ginkgo.It("host denies the host's own addresses and nothing else", func() {
+		d := parse("host")
+		for _, ip := range []string{"127.0.0.1", "198.51.100.1", "2001:db8:5::10", "::ffff:198.51.100.1"} {
+			gomega.Expect(d.Contains(netip.MustParseAddr(ip))).To(gomega.BeTrue(), ip)
+		}
+		for _, ip := range []string{"198.51.100.2", "2001:db8:5::11", "203.0.113.10"} {
+			gomega.Expect(d.Contains(netip.MustParseAddr(ip))).To(gomega.BeFalse(), ip)
+		}
+	})
+
+	ginkgo.It("host-networks denies every network the host is attached to", func() {
+		d := parse("host-networks")
+		for _, ip := range []string{"198.51.100.2", "198.51.100.254", "2001:db8:5::11", "127.0.0.53"} {
+			gomega.Expect(d.Contains(netip.MustParseAddr(ip))).To(gomega.BeTrue(), ip)
+		}
+		for _, ip := range []string{"198.51.101.1", "2001:db8:6::1", "203.0.113.10"} {
+			gomega.Expect(d.Contains(netip.MustParseAddr(ip))).To(gomega.BeFalse(), ip)
+		}
+	})
+
+	ginkgo.It("follows the host's addresses as they change", func() {
+		d := parse("host")
+		gomega.Expect(d.Contains(netip.MustParseAddr("198.51.100.1"))).To(gomega.BeTrue())
+		d.interfaceAddrs = func() ([]net.Addr, error) {
+			_, n, _ := net.ParseCIDR("192.0.2.1/24")
+			n.IP = net.ParseIP("192.0.2.1")
+			return []net.Addr{n}, nil
+		}
+		d.readAt = d.readAt.Add(-2 * hostAddrTTL)
+		gomega.Expect(d.Contains(netip.MustParseAddr("192.0.2.1"))).To(gomega.BeTrue())
+		gomega.Expect(d.Contains(netip.MustParseAddr("198.51.100.1"))).To(gomega.BeFalse())
+	})
+
+	ginkgo.It("keeps the last addresses when they cannot be read", func() {
+		d := parse("host")
+		gomega.Expect(d.Contains(netip.MustParseAddr("198.51.100.1"))).To(gomega.BeTrue())
+		d.interfaceAddrs = func() ([]net.Addr, error) { return nil, errors.New("no interfaces") }
+		d.readAt = d.readAt.Add(-2 * hostAddrTTL)
+		gomega.Expect(d.Contains(netip.MustParseAddr("198.51.100.1"))).To(gomega.BeTrue())
+	})
+
+	ginkgo.It("all denies everything", func() {
+		d := parse("all")
+		for _, ip := range []string{"8.8.8.8", "203.0.113.10", "2001:db8::1", "10.0.0.1"} {
+			gomega.Expect(d.Contains(netip.MustParseAddr(ip))).To(gomega.BeTrue(), ip)
+		}
+	})
+
+	ginkgo.It("takes addresses, CIDRs and lists separated by commas", func() {
+		d := parse("198.51.100.7, 203.0.113.0/28", "2001:db8::/32", "::ffff:192.0.2.9")
+		for ip, denied := range map[string]bool{
+			"198.51.100.7": true, "198.51.100.8": false,
+			"203.0.113.15": true, "203.0.113.16": false,
+			"2001:db8:1::5": true, "192.0.2.9": true,
+		} {
+			gomega.Expect(d.Contains(netip.MustParseAddr(ip))).To(gomega.Equal(denied), ip)
+		}
+	})
+
+	ginkgo.It("refuses an entry it cannot read", func() {
+		for _, bad := range []string{"privat", "10.0.0.0/33", "example.com", "300.1.1.1"} {
+			_, err := ParseDenyList([]string{bad})
+			gomega.Expect(err).To(gomega.HaveOccurred(), bad)
+		}
+	})
+
+	ginkgo.It("filters on the address dialled after NAT", func() {
+		d := parse("private")
+		req := types.DialRequest{
+			Network:     "tcp",
+			Destination: netip.MustParseAddrPort("192.168.127.254:22"),
+			DialAddress: netip.MustParseAddrPort("127.0.0.1:22"),
+		}
+		gomega.Expect(d.Filter(req)).To(gomega.HaveOccurred())
+		req.DialAddress = netip.MustParseAddrPort("203.0.113.10:22")
+		gomega.Expect(d.Filter(req)).ToNot(gomega.HaveOccurred())
+	})
+})
+
+var _ = ginkgo.Describe("Chain", func() {
+	refuse := func(types.DialRequest) error { return errors.New("no") }
+	allow := func(types.DialRequest) error { return nil }
+
+	ginkgo.It("is nil without filters", func() {
+		gomega.Expect(Chain(nil, nil)).To(gomega.BeNil())
+	})
+
+	ginkgo.It("refuses when any filter refuses", func() {
+		gomega.Expect(Chain(allow, nil, refuse)(types.DialRequest{})).To(gomega.HaveOccurred())
+		gomega.Expect(Chain(allow, allow)(types.DialRequest{})).ToNot(gomega.HaveOccurred())
+	})
+})
