diff --git a/pkg/outbound/deny.go b/pkg/outbound/deny.go
new file mode 100644
index 00000000..b25da2bd
--- /dev/null
+++ b/pkg/outbound/deny.go
@@ -0,0 +1,196 @@
+// Package outbound holds policies for the connections that the forwarders
+// open on the host for the guest.
+package outbound
+
+import (
+	"fmt"
+	"net"
+	"net/netip"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	log "github.com/sirupsen/logrus"
+)
+
+// privatePrefixes are the networks that the keyword "private" stands for:
+// loopback, RFC 1918, shared address space (carrier-grade NAT), link-local,
+// "this network", multicast, reserved and broadcast, and their IPv6
+// counterparts.
+var privatePrefixes = []netip.Prefix{
+	netip.MustParsePrefix("0.0.0.0/8"),
+	netip.MustParsePrefix("10.0.0.0/8"),
+	netip.MustParsePrefix("100.64.0.0/10"),
+	netip.MustParsePrefix("127.0.0.0/8"),
+	netip.MustParsePrefix("169.254.0.0/16"),
+	netip.MustParsePrefix("172.16.0.0/12"),
+	netip.MustParsePrefix("192.168.0.0/16"),
+	netip.MustParsePrefix("224.0.0.0/4"),
+	netip.MustParsePrefix("240.0.0.0/4"),
+	netip.MustParsePrefix("::/128"),
+	netip.MustParsePrefix("::1/128"),
+	netip.MustParsePrefix("fc00::/7"),
+	netip.MustParsePrefix("fe80::/10"),
+	netip.MustParsePrefix("ff00::/8"),
+}
+
+// hostAddrTTL bounds how stale the host's own addresses may be. They change
+// when the host joins a network; reading them costs a system call.
+const hostAddrTTL = time.Second
+
+// DenyList is a set of destinations that no connection of the guest may
+// reach.
+type DenyList struct {
+	prefixes     []netip.Prefix
+	host         bool
+	hostNetworks bool
+
+	// interfaceAddrs is net.InterfaceAddrs, replaced in tests.
+	interfaceAddrs func() ([]net.Addr, error)
+
+	mu        sync.Mutex
+	hostAddrs []netip.Prefix
+	readAt    time.Time
+}
+
+// ParseDenyList reads entries that are each, or list separated by commas:
+//   - an address or a CIDR;
+//   - "private": loopback, RFC 1918, carrier-grade NAT, link-local,
+//     multicast and reserved networks, IPv4 and IPv6;
+//   - "host": every address of the host's own interfaces;
+//   - "host-networks": every network the host's interfaces are attached to,
+//     such as a local network on public addresses or a global IPv6 network;
+//   - "all": every address.
+//
+// "host" and "host-networks" follow the host's interfaces as they change.
+func ParseDenyList(entries []string) (*DenyList, error) {
+	d := &DenyList{interfaceAddrs: net.InterfaceAddrs}
+	for _, entry := range entries {
+		for _, e := range strings.Split(entry, ",") {
+			e = strings.TrimSpace(e)
+			switch e {
+			case "":
+			case "host":
+				d.host = true
+			case "host-networks":
+				d.hostNetworks = true
+			case "private":
+				d.prefixes = append(d.prefixes, privatePrefixes...)
+			case "all":
+				d.prefixes = append(d.prefixes, netip.MustParsePrefix("0.0.0.0/0"), netip.MustParsePrefix("::/0"))
+			default:
+				p, err := parsePrefix(e)
+				if err != nil {
+					return nil, fmt.Errorf("outbound deny: %q is not an address, a CIDR or one of private, host, host-networks, all", e)
+				}
+				d.prefixes = append(d.prefixes, p)
+			}
+		}
+	}
+	return d, nil
+}
+
+func parsePrefix(s string) (netip.Prefix, error) {
+	if strings.Contains(s, "/") {
+		p, err := netip.ParsePrefix(s)
+		if err != nil {
+			return netip.Prefix{}, err
+		}
+		return netip.PrefixFrom(p.Addr().Unmap(), p.Bits()).Masked(), nil
+	}
+	a, err := netip.ParseAddr(s)
+	if err != nil {
+		return netip.Prefix{}, err
+	}
+	a = a.Unmap()
+	return netip.PrefixFrom(a, a.BitLen()), nil
+}
+
+// Contains reports whether a may not be reached.
+func (d *DenyList) Contains(a netip.Addr) bool {
+	a = a.Unmap()
+	for _, p := range d.prefixes {
+		if p.Contains(a) {
+			return true
+		}
+	}
+	if d.host || d.hostNetworks {
+		for _, p := range d.readHostAddrs() {
+			if d.host && p.Addr() == a {
+				return true
+			}
+			if d.hostNetworks && p.Contains(a) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// Filter refuses a request whose dial address, after NAT translation, is
+// denied. It has the signature of types.Configuration.DialFilter.
+func (d *DenyList) Filter(req types.DialRequest) error {
+	if d.Contains(req.DialAddress.Addr()) {
+		return fmt.Errorf("%s is on the outbound deny list", req.DialAddress.Addr())
+	}
+	return nil
+}
+
+func (d *DenyList) readHostAddrs() []netip.Prefix {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.hostAddrs != nil && time.Since(d.readAt) < hostAddrTTL {
+		return d.hostAddrs
+	}
+	addrs, err := d.interfaceAddrs()
+	if err != nil {
+		// Keep the last addresses read rather than allow everything.
+		log.Warnf("outbound deny: cannot read the host's addresses: %v", err)
+		return d.hostAddrs
+	}
+	list := []netip.Prefix{}
+	for _, a := range addrs {
+		n, ok := a.(*net.IPNet)
+		if !ok {
+			continue
+		}
+		ip, ok := netip.AddrFromSlice(n.IP)
+		if !ok {
+			continue
+		}
+		ones, _ := n.Mask.Size()
+		ip = ip.Unmap()
+		if ip.Is4() && ones > 32 {
+			ones -= 96
+		}
+		list = append(list, netip.PrefixFrom(ip, ones))
+	}
+	d.hostAddrs, d.readAt = list, time.Now()
+	return list
+}
+
+// Chain returns a dial filter that asks each non-nil filter in turn and
+// refuses a request as soon as one refuses it.
+func Chain(filters ...func(types.DialRequest) error) func(types.DialRequest) error {
+	var set []func(types.DialRequest) error
+	for _, f := range filters {
+		if f != nil {
+			set = append(set, f)
+		}
+	}
+	switch len(set) {
+	case 0:
+		return nil
+	case 1:
+		return set[0]
+	}
+	return func(req types.DialRequest) error {
+		for _, f := range set {
+			if err := f(req); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+}
