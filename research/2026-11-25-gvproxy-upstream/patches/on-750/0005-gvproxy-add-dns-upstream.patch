+func TestDNSUpstream(t *testing.T) {
+	t.Parallel()
+	for _, v := range []struct {
+		name   string
+		argv   []string
+		config string
+		want   []string
+		err    string
+	}{
+		{"default", nil, "", nil, ""},
+		{"flag, twice", []string{"-dns-upstream", "127.0.0.1:5353", "-dns-upstream", "[::1]:53"}, "", []string{"127.0.0.1:5353", "[::1]:53"}, ""},
+		{"none", []string{"-dns-upstream", "none"}, "", []string{"none"}, ""},
+		{"config file", nil, "stack:\n  dnsUpstream: [\"192.0.2.53:53\"]\n", []string{"192.0.2.53:53"}, ""},
+		{"none with a server", []string{"-dns-upstream", "none", "-dns-upstream", "127.0.0.1:53"}, "", nil, "cannot be combined"},
+	} {
+		var cnf GvproxyConfig
+		var args GvproxyArgs
+		_, err := GvproxyArgParse(flag.NewFlagSet(os.Args[0], flag.ContinueOnError), &args, v.argv)
+		require.NoError(t, err, v.name)
+		require.NoError(t, yaml.Unmarshal([]byte(v.config), &cnf), v.name)
+		_, err = GvproxyConfigure(&cnf, &args, "testing")
+		if v.err != "" {
+			require.ErrorContains(t, err, v.err, v.name)
+			continue
+		}
+		require.NoError(t, err, v.name)
+		assert.Equal(t, v.want, cnf.Stack.DNSUpstream, v.name)
+	}
+}
