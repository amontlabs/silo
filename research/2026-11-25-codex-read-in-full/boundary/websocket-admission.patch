+/// Settles the call on the socket once its reply has ended.
+fn wsSettle(ctx: *RespCtx, how: []const u8, force: bool) void {
+    const cl = ctx.call orelse return;
+    if (!force and !cl.meter.final) return;
+    endCall(state.?, cl, how);
+    if (!cl.kept) {
+        cl.deinit();
+        gpa.destroy(cl);
+    }
+    ctx.call = null;
+}
