+/// Silo's refusal of one call on a WebSocket: an `error` event with status 400, which Codex shows
+/// once and does not retry (`how-a-hold-ends`, "A refusal on Codex's WebSocket").
+fn wsRefusal(client: Side, msg: []const u8) !void {
+    const body = try std.fmt.allocPrint(gpa, "{{\"type\":\"error\",\"status\":400,\"error\":{{\"type\":\"invalid_request_error\",\"code\":\"silo_budget_reached\",\"message\":{f}}}}}", .{std.json.fmt(msg, .{})});
+    defer gpa.free(body);
+    var h: [10]u8 = undefined;
+    h[0] = 0x81;
+    var n: usize = 2;
+    if (body.len < 126) {
+        h[1] = @intCast(body.len);
+    } else if (body.len < 65536) {
+        h[1] = 126;
+        std.mem.writeInt(u16, h[2..4], @intCast(body.len), .big);
+        n = 4;
+    } else {
+        h[1] = 127;
+        std.mem.writeInt(u64, h[2..10], body.len, .big);
+        n = 10;
+    }
+    try client.writeAll(h[0..n]);
+    try client.writeAll(body);
+}
