+    const t1 = "eyJhbGciOiJub25lIn0.eyJodHRwczovL2FwaS5vcGVuYWkuY29tL2F1dGgiOnsiY2hhdGdwdF9hY2NvdW50X2lkIjoiYWNjdC0xIn0sImV4cCI6Mn0.sig";
+    // the same account, another token
+    const t2 = "eyJhbGciOiJub25lIn0.eyJodHRwczovL2FwaS5vcGVuYWkuY29tL2F1dGgiOnsiY2hhdGdwdF9hY2NvdW50X2lkIjoiYWNjdC0xIn0sImV4cCI6M30.sig";
+    // another account
+    const t3 = "eyJhbGciOiJub25lIn0.eyJodHRwczovL2FwaS5vcGVuYWkuY29tL2F1dGgiOnsiY2hhdGdwdF9hY2NvdW50X2lkIjoiYWNjdC0yIn0sImV4cCI6Mn0.sig";
+    const by_value: Credential = .{ .value = t1, .kind = "plan" };
+    const by_account: Credential = .{ .value = t1, .kind = "plan", .account = "acct-1" };
+    try std.testing.expect(credentialMatches(gpa, by_value, t1));
+    try std.testing.expect(!credentialMatches(gpa, by_value, t2));
+    try std.testing.expect(credentialMatches(gpa, by_account, t2));
+    try std.testing.expect(!credentialMatches(gpa, by_account, t3));
+    try std.testing.expect(!credentialMatches(gpa, by_account, "sk-proj-x"));
+    try std.testing.expect(!credentialMatches(gpa, by_account, "a.!!!.b"));
