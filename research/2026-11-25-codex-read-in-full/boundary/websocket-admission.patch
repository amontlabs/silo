+/// Whether a credential a request carries is this one: the same value, or for a ChatGPT sign-in,
+/// an access token naming the same account. The token's signature is not checked here: a token
+/// made up inside the computer is refused by OpenAI, and a real one of another account names
+/// another account.
+pub fn credentialMatches(gpa: Allocator, cr: Credential, value: []const u8) bool {
+    if (std.mem.eql(u8, cr.value, value)) return true;
+    const want = cr.account orelse return false;
+    const got = chatgptAccount(gpa, value) orelse return false;
+    defer gpa.free(got);
+    return std.mem.eql(u8, want, got);
+}
+
+/// The ChatGPT account id in an access token (a JWT), or null.
+pub fn chatgptAccount(gpa: Allocator, token: []const u8) ?[]u8 {
+    var it = std.mem.splitScalar(u8, token, '.');
+    _ = it.next() orelse return null;
+    const payload = it.next() orelse return null;
+    _ = it.next() orelse return null;
+    if (payload.len > 16 << 10) return null;
+    const dec = std.base64.url_safe_no_pad.Decoder;
+    const n = dec.calcSizeForSlice(payload) catch return null;
+    const buf = gpa.alloc(u8, n) catch return null;
+    defer gpa.free(buf);
+    dec.decode(buf, payload) catch return null;
+    var parsed = std.json.parseFromSlice(std.json.Value, gpa, buf, .{}) catch return null;
+    defer parsed.deinit();
+    if (parsed.value != .object) return null;
+    const auth = parsed.value.object.get("https://api.openai.com/auth") orelse return null;
+    if (auth != .object) return null;
+    const id = auth.object.get("chatgpt_account_id") orelse return null;
+    if (id != .string) return null;
+    return gpa.dupe(u8, id.string) catch null;
+}
