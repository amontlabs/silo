+/// The program's bytes on a socket that have not left yet, and where in the stream they start.
+const Pending = struct { bytes: std.ArrayList(u8) = .empty, base: u64 = 0 };
+
+/// Bytes from the program on a socket. Without admission they leave as they come. With it, they
+/// leave once each message in them is whole and admitted; a refused message does not leave, and
+/// the program gets Silo's refusal in its place. Returns true when the socket must end: a refused
+/// message compressed with a shared context would leave the host unable to read the next ones.
+fn fromProgram(client: Side, up: Side, cr: *ws.Reader, csink: *ClientWs, pend: *Pending, in: []const u8, head: *const Head, id: u32) !bool {
+    if (csink.admit == null) {
+        try cr.feed(in, csink);
+        try up.writeAll(in);
+        return false;
+    }
+    try pend.bytes.appendSlice(gpa, in);
+    // Each message's end is known only inside `feed`; the reader says where it is as it goes.
+    var sink = struct {
+        inner: *ClientWs,
+        reader: *ws.Reader,
+        pub fn onMessage(self: *@This(), m: ws.Message) !void {
+            self.inner.end_at = self.reader.at;
+            try self.inner.onMessage(m);
+        }
+    }{ .inner = csink, .reader = cr };
+    try cr.feed(in, &sink);
+    var refused = false;
+    for (csink.verdicts.items) |v| {
+        const upto: usize = @intCast(v.end - pend.base);
+        if (v.refusal) |msg| {
+            defer gpa.free(msg);
+            record("\"conn\":{d},\"kind\":\"ws-refused\",\"message\":{f}", .{ id, j(msg) });
+            try wsRefusal(client, msg);
+            refused = true;
+        } else try up.writeAll(pend.bytes.items[0..upto]);
+        std.mem.copyForwards(u8, pend.bytes.items[0 .. pend.bytes.items.len - upto], pend.bytes.items[upto..]);
+        pend.bytes.shrinkRetainingCapacity(pend.bytes.items.len - upto);
+        pend.base = v.end;
+    }
+    csink.verdicts.clearRetainingCapacity();
+    // Control frames and anything else whole since the last message leave too.
+    if (cr.safe_at > pend.base) {
+        const upto: usize = @intCast(cr.safe_at - pend.base);
+        try up.writeAll(pend.bytes.items[0..upto]);
+        std.mem.copyForwards(u8, pend.bytes.items[0 .. pend.bytes.items.len - upto], pend.bytes.items[upto..]);
+        pend.bytes.shrinkRetainingCapacity(pend.bytes.items.len - upto);
+        pend.base = cr.safe_at;
+    }
+    if (refused and head.ws_deflate and !head.ws_client_nctx) {
+        record("\"conn\":{d},\"kind\":\"ws-ended\",\"why\":\"refused message shared a compression context\"", .{id});
+        client.writeAll("\x88\x02\x03\xe8") catch {};
+        return true;
+    }
+    return false;
+}
