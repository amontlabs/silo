+func TestEc2MetadataAccessFlagReachesTheStack(t *testing.T) {
+	t.Parallel()
+	var cnf GvproxyConfig
+	var args GvproxyArgs
+	_, err := GvproxyArgParse(flag.NewFlagSet("gvproxy", flag.ContinueOnError), &args, []string{"-ec2-metadata-access"})
+	require.NoError(t, err)
+	_, err = GvproxyConfigure(&cnf, &args, "testing")
+	require.NoError(t, err)
+	// The forwarders read the stack's configuration (pkg/virtualnetwork/services.go), not the
+	// top-level field: without this, the flag permits nothing.
+	assert.True(t, cnf.Stack.Ec2MetadataAccess, "-ec2-metadata-access must reach the stack's configuration")
+}
