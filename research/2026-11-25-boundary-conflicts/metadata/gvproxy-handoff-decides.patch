diff --git a/pkg/services/forwarder/handoff_test.go b/pkg/services/forwarder/handoff_test.go
new file mode 100644
index 00000000..d133c9f8
--- /dev/null
+++ b/pkg/services/forwarder/handoff_test.go
@@ -0,0 +1,101 @@
+package forwarder
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/loopback"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+)
+
+// In hand-off mode the boundary decides every connection. A connection the guest opens to the
+// cloud metadata address, or to any address the deny list names, must reach the boundary, which
+// answers the metadata server itself and refuses the rest. gvproxy dials nothing in this mode, so
+// its own checks protect nothing and only hide connections from the boundary.
+func TestHandoffReceivesEveryTCPConnection(t *testing.T) {
+	guest := tcpip.AddrFrom4([4]byte{192, 168, 127, 2})
+	s := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol},
+	})
+	defer s.Destroy()
+	if err := s.CreateNIC(1, loopback.New()); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: ipv4.ProtocolNumber, AddressWithPrefix: guest.WithPrefix()}, stack.AddressProperties{}); err != nil {
+		t.Fatal(err)
+	}
+	s.SetSpoofing(1, true)
+	s.SetPromiscuousMode(1, true)
+	s.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+
+	sock := filepath.Join(t.TempDir(), "boundary.sock")
+	ln, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	var mu sync.Mutex
+	got := map[string]bool{}
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func(c net.Conn) {
+				defer c.Close()
+				h := make([]byte, 28)
+				if _, err := io.ReadFull(c, h); err != nil || !bytes.HasPrefix(h, []byte("\r\n\r\n\x00\r\nQUIT\n")) {
+					return
+				}
+				dst := net.JoinHostPort(net.IP(h[20:24]).String(), "80")
+				mu.Lock()
+				got[dst] = true
+				mu.Unlock()
+				_, _ = c.Write([]byte("ok"))
+			}(c)
+		}
+	}()
+
+	deny, err := ParseDenyList([]string{"private", "host"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var natLock sync.Mutex
+	fw := TCPWithOutbound(s, map[tcpip.Address]tcpip.Address{}, &natLock, false, 0, 0, &Outbound{Deny: deny, Handoff: sock})
+	s.SetTransportProtocolHandler(tcp.ProtocolNumber, fw.HandlePacket)
+
+	for _, dst := range []string{"169.254.169.254", "10.0.0.7", "203.0.113.10"} {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		c, err := gonet.DialTCPWithBind(ctx, s,
+			tcpip.FullAddress{NIC: 1, Addr: guest},
+			tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFromSlice(net.ParseIP(dst).To4()), Port: 80}, ipv4.ProtocolNumber)
+		cancel()
+		if err != nil {
+			t.Errorf("%s: the guest's connection did not open: %v", dst, err)
+			continue
+		}
+		_ = c.SetReadDeadline(time.Now().Add(3 * time.Second))
+		b := make([]byte, 2)
+		_, err = io.ReadFull(c, b)
+		c.Close()
+		mu.Lock()
+		handed := got[dst+":80"]
+		mu.Unlock()
+		if err != nil || !handed {
+			t.Errorf("%s: not handed to the boundary (read: %v)", dst, err)
+		}
+	}
+}
