+/// A connection Silo cannot tie to a computer: every request is refused, since the key and budget
+/// checks are a computer's. With budgets set, Silo never lets an unknown computer's call out.
+fn refuseUnknown(client: Side, id: u32, sni: []const u8) !void {
+    var extra: std.ArrayList(u8) = .empty;
+    defer extra.deinit(gpa);
+    while (true) {
+        var req = (try readHead(client, &extra)) orelse return;
+        defer gpa.free(req.raw);
+        var rc: ReqCtx = .{};
+        defer rc.body.deinit(gpa);
+        defer rc.raw.deinit(gpa);
+        if (req.content_length != null or req.chunked) _ = try pumpBody(client, &req, &extra, &rc);
+        record("\"conn\":{d},\"kind\":\"refused\",\"why\":\"unknown-computer\",\"sni\":{f}", .{ id, j(sni) });
+        try writeRefusal(client, defaultFormat(spend.providerOf(sni)), "Silo: this connection comes from no computer Silo knows, so nothing it sends can leave.");
+    }
+}
