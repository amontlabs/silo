+test "gemini watcher takes a whole function call from one event, by id or by name" {
+    const gpa = std.testing.allocator;
+    var w = Watcher.init(gpa, .gemini);
+    defer w.deinit();
+    var s: Sse = .{};
+    defer s.deinit(gpa);
+    try s.feed(gpa, "data: {\"candidates\":[{\"content\":{\"role\":\"model\",\"parts\":[{\"functionCall\":{\"name\":\"run_shell_command\",\"args\":{\"command\":\"ls\"}}}]}}],\"modelVersion\":\"g\"}\r\n\r\n", &w);
+    try std.testing.expectEqual(@as(u32, 0), w.open);
+    try std.testing.expectEqualStrings("run_shell_command", w.done.items[0].id);
+    try std.testing.expectEqualStrings("{\"command\":\"ls\"}", w.done.items[0].input);
+    var ids = try toolResultIds(gpa, .gemini, "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"functionResponse\":{\"id\":\"x1\",\"name\":\"run_shell_command\",\"response\":{}}}]}]}");
+    defer {
+        for (ids.items) |x| gpa.free(x);
+        ids.deinit(gpa);
+    }
+    try std.testing.expectEqualStrings("x1", ids.items[0]);
+    try std.testing.expectEqualStrings("run_shell_command", ids.items[1]);
+    var c = try toolResultIds(gpa, .chat, "{\"messages\":[{\"role\":\"assistant\"},{\"role\":\"tool\",\"tool_call_id\":\"call_1\"},{\"role\":\"tool\",\"tool_call_id\":\"call_2\"}]}");
+    defer {
+        for (c.items) |x| gpa.free(x);
+        c.deinit(gpa);
+    }
+    try std.testing.expectEqual(@as(usize, 2), c.items.len);
