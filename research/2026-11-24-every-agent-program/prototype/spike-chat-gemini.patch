-pub const Provider = enum { anthropic, openai };
+pub const Provider = enum {
+    anthropic,
+    openai,
+    /// OpenAI's Chat Completions, which most other providers and local servers also speak.
+    chat,
+    /// Google's generateContent, as the Gemini API and Code Assist serve it.
+    gemini,
+
+    /// The format of one request, from its path: one host can serve several formats.
+    pub fn ofPath(default: Provider, path: []const u8) Provider {
+        if (std.mem.indexOf(u8, path, "/chat/completions") != null) return .chat;
+        if (std.mem.indexOf(u8, path, "enerateContent") != null) return .gemini;
+        if (std.mem.indexOf(u8, path, "/messages") != null) return .anthropic;
+        if (std.mem.indexOf(u8, path, "/responses") != null) return .openai;
+        return default;
+    }
+};
 
