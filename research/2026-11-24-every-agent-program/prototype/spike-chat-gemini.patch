+    /// A tool call starts with the first delta that names its index, and every call of the reply
+    /// is whole when a choice says why it finished.
+    fn chat(self: *Watcher, o: std.json.ObjectMap) !void {
+        if (str(o.get("model"))) |m| self.setModel(m);
+        if (obj(o.get("usage"))) |u| {
+            if (int(u.get("prompt_tokens"))) |v| self.input_tokens = v;
+            if (int(u.get("completion_tokens"))) |v| self.output_tokens = v;
+        }
+        const choices = o.get("choices") orelse return;
+        if (choices != .array or choices.array.items.len == 0) return;
+        const ch = choices.array.items[0];
+        if (ch != .object) return;
+        if (obj(ch.object.get("delta"))) |d| if (d.get("tool_calls")) |tcs| if (tcs == .array) for (tcs.array.items) |tc| {
+            if (tc != .object) continue;
+            const k: usize = @intCast(int(tc.object.get("index")) orelse 0);
+            while (self.chat_calls.items.len <= k) {
+                try self.chat_calls.append(self.gpa, .{});
+                self.open += 1;
+            }
+            const cc = &self.chat_calls.items[k];
+            if (str(tc.object.get("id"))) |v| try cc.id.appendSlice(self.gpa, v);
+            if (obj(tc.object.get("function"))) |f| {
+                if (str(f.get("name"))) |v| try cc.name.appendSlice(self.gpa, v);
+                if (str(f.get("arguments"))) |v| try cc.args.appendSlice(self.gpa, v);
+            }
+        };
+        const fr = ch.object.get("finish_reason") orelse return;
+        if (fr != .string) return;
+        for (self.chat_calls.items) |*cc| {
+            try self.finish(cc.id.items, cc.name.items, cc.args.items);
+            cc.id.deinit(self.gpa);
+            cc.name.deinit(self.gpa);
+            cc.args.deinit(self.gpa);
+        }
+        self.chat_calls.clearRetainingCapacity();
+    }
+
+    /// A function call comes whole, in one event. A call with no id is known by its name.
+    fn gemini(self: *Watcher, o0: std.json.ObjectMap) !void {
+        // Code Assist wraps the same object in "response".
+        const o = obj(o0.get("response")) orelse o0;
+        if (str(o.get("modelVersion"))) |m| self.setModel(m);
+        if (obj(o.get("usageMetadata"))) |u| {
+            if (int(u.get("promptTokenCount"))) |v| self.input_tokens = v;
+            if (int(u.get("candidatesTokenCount"))) |v| self.output_tokens = v;
+        }
+        const cands = o.get("candidates") orelse return;
+        if (cands != .array or cands.array.items.len == 0) return;
+        const content = obj(if (cands.array.items[0] == .object) cands.array.items[0].object.get("content") else null) orelse return;
+        const parts = content.get("parts") orelse return;
+        if (parts != .array) return;
+        for (parts.array.items) |p| {
+            if (p != .object) continue;
+            const fc = obj(p.object.get("functionCall")) orelse continue;
+            const name = str(fc.get("name")) orelse "";
+            var args: std.Io.Writer.Allocating = .init(self.gpa);
+            defer args.deinit();
+            if (fc.get("args")) |a| try std.json.Stringify.value(a, .{}, &args.writer);
+            self.open += 1;
+            try self.finish(str(fc.get("id")) orelse name, name, args.written());
+        }
+    }
