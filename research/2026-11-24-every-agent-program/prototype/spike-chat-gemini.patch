+test "chat completions watcher holds from the first tool call delta to finish_reason" {
+    const gpa = std.testing.allocator;
+    var w = Watcher.init(gpa, .chat);
+    defer w.deinit();
+    var s: Sse = .{};
+    defer s.deinit(gpa);
+    try s.feed(gpa, "data: {\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"tool_calls\":[{\"index\":0,\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"\"}}]},\"finish_reason\":null}]}\n\n", &w);
+    try std.testing.expectEqual(@as(u32, 1), w.open);
+    try s.feed(gpa, "data: {\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"{\\\"cmd\\\":\\\"ls\\\"}\"}}]},\"finish_reason\":null}]}\n\n", &w);
+    try s.feed(gpa, "data: {\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":1,\"id\":\"call_2\",\"function\":{\"name\":\"read\",\"arguments\":\"{}\"}}]},\"finish_reason\":null}]}\n\n", &w);
+    try std.testing.expectEqual(@as(u32, 2), w.open);
+    try s.feed(gpa, "data: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":5,\"completion_tokens\":7}}\n\ndata: [DONE]\n\n", &w);
+    try std.testing.expectEqual(@as(u32, 0), w.open);
+    try std.testing.expectEqualStrings("{\"cmd\":\"ls\"}", w.done.items[0].input);
+    try std.testing.expectEqualStrings("call_2", w.done.items[1].id);
+    try std.testing.expectEqual(@as(?i64, 7), w.output_tokens);
+}
