+// refuseHostAndPrivate is what --sealed asks of every outbound connection: never the host itself
+// (any of its addresses, loopback included), never a private or link-local network, never multicast.
+func refuseHostAndPrivate() func(net.IP) bool {
+	cgnat := &net.IPNet{IP: net.IPv4(100, 64, 0, 0), Mask: net.CIDRMask(10, 32)}
+	return func(ip net.IP) bool {
+		if ip.IsLoopback() || ip.IsPrivate() || ip.IsLinkLocalUnicast() || ip.IsUnspecified() || ip.IsMulticast() || cgnat.Contains(ip) {
+			return true
+		}
+		addrs, _ := net.InterfaceAddrs() // read each time: the host's addresses change with its networks
+		for _, a := range addrs {
+			if n, ok := a.(*net.IPNet); ok && n.IP.Equal(ip) {
+				return true
+			}
+		}
+		return false
+	}
+}
