 	defaultTCPConnectTimeout = 30 * time.Second
 )
 
+// Refuse, when set, is asked about every destination after translation. A destination it refuses
+// is never dialled: the guest's connection is reset (TCP) or dropped (UDP).
+var Refuse func(ip net.IP) bool
+
+func refused(a tcpip.Address, port uint16, proto string) bool {
+	if Refuse == nil {
+		return false
+	}
+	ip := net.IP(a.AsSlice())
+	if Refuse(ip) {
+		log.Warnf("refused %s to %s:%d: the host or a private network", proto, ip, port)
+		return true
+	}
+	return false
+}
