+#[cfg(all(test, feature = "blk"))]
+mod block_write_hook_tests {
+    use super::*;
+    use std::ffi::c_void;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    unsafe extern "C" fn refuse_odd_offsets(user: *const c_void, offset: u64, len: u64) -> i32 {
+        let calls = unsafe { &*(user as *const AtomicU64) };
+        calls.fetch_add(len, Ordering::Relaxed);
+        if offset.is_multiple_of(2) { 0 } else { 5 }
+    }
+
+    #[test]
+    fn c_hook_is_called_with_its_user_pointer_and_its_return_is_kept() {
+        let calls = AtomicU64::new(0);
+        let mut device = BlockDevice::new("d", "/nonexistent", DiskFormat::Raw).unwrap();
+        unsafe {
+            device
+                .set_write_hook(
+                    refuse_odd_offsets as *const c_void,
+                    &calls as *const AtomicU64 as *const c_void,
+                )
+                .unwrap();
+        }
+        let hook = device.write_hook.unwrap();
+        assert!(hook.before_write(512, 4096).is_ok());
+        let err = hook.before_write(513, 8).unwrap_err();
+        assert!(err.to_string().contains('5'));
+        assert_eq!(calls.load(Ordering::Relaxed), 4104);
+    }
+
+    #[test]
+    fn null_hook_is_refused() {
+        let mut device = BlockDevice::new("d", "/nonexistent", DiskFormat::Raw).unwrap();
+        let result = unsafe { device.set_write_hook(std::ptr::null(), std::ptr::null()) };
+        assert!(result.is_err());
+        assert!(device.write_hook.is_none());
+    }
+}
