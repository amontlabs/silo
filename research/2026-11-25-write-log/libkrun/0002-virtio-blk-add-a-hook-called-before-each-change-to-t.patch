 /// Helper object for setting up all `Block` fields derived from its backing file.
+/// Told of every range of the disk the guest is about to change.
+///
+/// Called on the block worker's thread before each write, write-zeroes and discard, with a
+/// byte range that lies inside the disk. Returning an error fails the request with
+/// `VIRTIO_BLK_S_IOERR` and leaves the disk untouched. While it runs, no other request of this
+/// device changes the disk, so the range still holds the bytes it held before the request.
+pub trait BlockWriteHook: Send + Sync {
+    fn before_write(&self, offset: u64, len: u64) -> io::Result<()>;
+}
