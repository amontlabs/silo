+
+#[cfg(test)]
+mod write_hook_tests {
+    use super::*;
+    use crate::legacy::DummyIrqChip;
+    use crate::virtio::block::device::BlockWriteHook;
+    use crate::virtio::descriptor_utils::{DescriptorType, create_descriptor_chain};
+    use crate::virtio::queue::tests::VirtQueue;
+    use imago::{DynStorage, FormatAccess, Storage, StorageOpenOptions, file::File, raw::Raw};
+    use std::os::unix::fs::FileExt;
+    use std::sync::{Arc, RwLock};
+    use utils::tempfile::TempFile;
+    use vm_memory::Bytes;
+
+    const DISK_SECTORS: u64 = 64;
+
+    enum Body {
+        Data(Vec<u8>),
+        Range {
+            sector: u64,
+            num_sectors: u32,
+            flags: u32,
+        },
+    }
+
+    /// Records each range it is told of, with the bytes the range held at that moment, as a
+    /// copy-before-write checkpoint would.
+    struct Recorder {
+        image: std::fs::File,
+        refuse: bool,
+        seen: Mutex<Vec<(u64, Vec<u8>)>>,
+    }
+
+    impl BlockWriteHook for Recorder {
+        fn before_write(&self, offset: u64, len: u64) -> io::Result<()> {
+            assert!(offset.checked_add(len).unwrap() <= DISK_SECTORS * 512);
+            let mut old = vec![0; len as usize];
+            self.image.read_exact_at(&mut old, offset)?;
+            self.seen.lock().unwrap().push((offset, old));
+            if self.refuse {
+                return Err(io::Error::other("refused"));
+            }
+            Ok(())
+        }
+    }
+
+    struct Fixture {
+        backing: TempFile,
+        hook: Arc<Recorder>,
+        disk: DiskProperties,
+    }
+
+    impl Fixture {
+        fn new(refuse: bool) -> Self {
+            let backing = TempFile::new().unwrap();
+            let content: Vec<u8> = (0..DISK_SECTORS * 512).map(|i| (i / 512) as u8).collect();
+            backing.as_file().write_all_at(&content, 0).unwrap();
+            let file = File::open(
+                StorageOpenOptions::new()
+                    .write(true)
+                    .filename(backing.as_path().to_str().unwrap()),
+            )
+            .unwrap();
+            let raw = Raw::<Box<dyn DynStorage>>::open_image(Box::new(file), true).unwrap();
+            let hook = Arc::new(Recorder {
+                image: backing.as_file().try_clone().unwrap(),
+                refuse,
+                seen: Mutex::new(Vec::new()),
+            });
+            let disk = DiskProperties::new(
+                Arc::new(RwLock::new(FormatAccess::new(raw))),
+                Vec::new(),
+                CacheType::Unsafe,
+            )
+            .unwrap()
+            .with_write_hook(Some(hook.clone()));
+            Self {
+                backing,
+                hook,
+                disk,
+            }
+        }
+
+        fn image(&self) -> Vec<u8> {
+            let mut buf = vec![0; (DISK_SECTORS * 512) as usize];
+            self.backing.as_file().read_exact_at(&mut buf, 0).unwrap();
+            buf
+        }
+
+        fn seen(&self) -> Vec<(u64, u64)> {
+            let seen = self.hook.seen.lock().unwrap();
+            seen.iter().map(|(o, old)| (*o, old.len() as u64)).collect()
+        }
+
+        /// Sends one request through the worker and returns its status byte.
+        fn request(&self, request_type: u32, sector: u64, body: Body) -> u8 {
+            let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+            let queue = VirtQueue::new(GuestAddress(0), &mem, 16);
+            let body_bytes = match body {
+                Body::Data(data) => data,
+                Body::Range {
+                    sector,
+                    num_sectors,
+                    flags,
+                } => DiscardWriteData {
+                    sector,
+                    num_sectors,
+                    flags,
+                }
+                .as_slice()
+                .to_vec(),
+            };
+            let mut descriptors = vec![(DescriptorType::Readable, 16)];
+            if !body_bytes.is_empty() {
+                descriptors.push((DescriptorType::Readable, body_bytes.len() as u32));
+            }
+            descriptors.push((DescriptorType::Writable, 1));
+            let head = create_descriptor_chain(
+                &mem,
+                GuestAddress(0),
+                GuestAddress(0x1000),
+                descriptors,
+                0,
+            )
+            .unwrap();
+            mem.write_obj(
+                RequestHeader {
+                    request_type,
+                    sector,
+                    ..Default::default()
+                },
+                GuestAddress(0x1000),
+            )
+            .unwrap();
+            mem.write_slice(&body_bytes, GuestAddress(0x1010)).unwrap();
+            let status_addr = GuestAddress(0x1010 + body_bytes.len() as u64);
+            mem.write_obj(0xff_u8, status_addr).unwrap();
+            let disk = DiskProperties::new(self.disk.file.clone(), Vec::new(), CacheType::Unsafe)
+                .unwrap()
+                .with_write_hook(Some(self.hook.clone()));
+            let mut worker = BlockWorker::new(
+                DeviceQueue::new(
+                    queue.create_queue(),
+                    Arc::new(EventFd::new(EFD_NONBLOCK).unwrap()),
+                ),
+                InterruptTransport::new(DummyIrqChip::new().into(), "block test".into()).unwrap(),
+                mem.clone(),
+                disk,
+                EventFd::new(EFD_NONBLOCK).unwrap(),
+                false,
+                None,
+            );
+            worker.dispatch_request(&mem, None, head);
+            mem.read_obj::<u8>(status_addr).unwrap()
+        }
+    }
+
+    const OK: u8 = VIRTIO_BLK_S_OK as u8;
+    const IOERR: u8 = VIRTIO_BLK_S_IOERR as u8;
+
+    fn range(sector: u64, num_sectors: u32) -> Body {
+        Body::Range {
+            sector,
+            num_sectors,
+            flags: 0,
+        }
+    }
+
+    #[test]
+    fn hook_sees_each_change_before_it_lands() {
+        let f = Fixture::new(false);
+        assert_eq!(
+            f.request(VIRTIO_BLK_T_OUT, 3, Body::Data(vec![0xaa; 1024])),
+            OK
+        );
+        assert_eq!(f.request(VIRTIO_BLK_T_WRITE_ZEROES, 0, range(10, 2)), OK);
+        assert_eq!(
+            f.request(
+                VIRTIO_BLK_T_WRITE_ZEROES,
+                0,
+                Body::Range {
+                    sector: 20,
+                    num_sectors: 1,
+                    flags: VIRTIO_BLK_WRITE_ZEROES_FLAG_UNMAP
+                }
+            ),
+            OK
+        );
+        assert_eq!(f.request(VIRTIO_BLK_T_DISCARD, 0, range(30, 4)), OK);
+        assert_eq!(
+            f.seen(),
+            [
+                (3 * 512, 1024),
+                (10 * 512, 1024),
+                (20 * 512, 512),
+                (30 * 512, 2048)
+            ]
+        );
+        let seen = f.hook.seen.lock().unwrap();
+        assert!(seen[0].1[..512].iter().all(|b| *b == 3));
+        assert!(seen[0].1[512..].iter().all(|b| *b == 4));
+        assert!(seen[1].1.iter().all(|b| *b == 10 || *b == 11));
+        assert!(f.image()[3 * 512..5 * 512].iter().all(|b| *b == 0xaa));
+        assert!(f.image()[10 * 512..12 * 512].iter().all(|b| *b == 0));
+    }
+
+    #[test]
+    fn reads_flushes_and_ids_do_not_call_the_hook() {
+        let f = Fixture::new(false);
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x4000)]).unwrap();
+        let mut reader = Reader::new(
+            &mem,
+            create_descriptor_chain(
+                &mem,
+                GuestAddress(0),
+                GuestAddress(0x1000),
+                vec![(DescriptorType::Readable, 16)],
+                0,
+            )
+            .unwrap(),
+        )
+        .unwrap();
+        for request_type in [VIRTIO_BLK_T_IN, VIRTIO_BLK_T_FLUSH, VIRTIO_BLK_T_GET_ID] {
+            let chain = create_descriptor_chain(
+                &mem,
+                GuestAddress(0x2000),
+                GuestAddress(0x3000),
+                vec![(DescriptorType::Writable, 512)],
+                0,
+            )
+            .unwrap();
+            let mut writer = Writer::new(&mem, chain).unwrap();
+            let header = RequestHeader {
+                request_type,
+                sector: 0,
+                ..Default::default()
+            };
+            BlockWorker::process_request(header, &mut reader, &mut writer, &f.disk).unwrap();
+        }
+        assert!(f.seen().is_empty());
+    }
+
+    #[test]
+    fn a_refused_change_fails_and_leaves_the_disk() {
+        let f = Fixture::new(true);
+        let before = f.image();
+        assert_eq!(
+            f.request(VIRTIO_BLK_T_OUT, 0, Body::Data(vec![0xaa; 512])),
+            IOERR
+        );
+        assert_eq!(f.request(VIRTIO_BLK_T_WRITE_ZEROES, 0, range(1, 1)), IOERR);
+        assert_eq!(f.request(VIRTIO_BLK_T_DISCARD, 0, range(2, 1)), IOERR);
+        assert_eq!(f.seen().len(), 3);
+        assert_eq!(f.image(), before);
+    }
+
+    #[test]
+    fn changes_outside_the_disk_are_refused_before_the_hook() {
+        let f = Fixture::new(false);
+        let before = f.image();
+        let wrap = u64::MAX / 512 + 1;
+        for (request_type, sector, body) in [
+            (VIRTIO_BLK_T_OUT, DISK_SECTORS, Body::Data(vec![0xaa; 512])),
+            (
+                VIRTIO_BLK_T_OUT,
+                DISK_SECTORS - 1,
+                Body::Data(vec![0xaa; 1024]),
+            ),
+            (VIRTIO_BLK_T_OUT, wrap, Body::Data(vec![0xaa; 512])),
+            (VIRTIO_BLK_T_OUT, u64::MAX, Body::Data(vec![0xaa; 512])),
+            (VIRTIO_BLK_T_WRITE_ZEROES, 0, range(wrap, 1)),
+            (VIRTIO_BLK_T_WRITE_ZEROES, 0, range(u64::MAX, u32::MAX)),
+            (VIRTIO_BLK_T_WRITE_ZEROES, 0, range(DISK_SECTORS - 1, 2)),
+            (VIRTIO_BLK_T_DISCARD, 0, range(wrap, 1)),
+            (VIRTIO_BLK_T_DISCARD, 0, range(0, u32::MAX)),
+        ] {
+            assert_eq!(f.request(request_type, sector, body), IOERR);
+        }
+        assert!(f.seen().is_empty());
+        assert_eq!(f.image(), before);
+    }
+
+    #[test]
+    fn empty_changes_inside_the_disk_reach_the_hook() {
+        let f = Fixture::new(false);
+        assert_eq!(
+            f.request(VIRTIO_BLK_T_DISCARD, 0, range(DISK_SECTORS, 0)),
+            OK
+        );
+        assert_eq!(f.seen(), [(DISK_SECTORS * 512, 0)]);
+    }
+
+    /// Random requests against a model of the disk: every byte that changes lies in a range the
+    /// hook was told of, before the change, and no range leaves the disk.
+    #[test]
+    fn random_requests_change_only_what_the_hook_was_told() {
+        let mut state: u64 = 0x9e3779b97f4a7c15;
+        let mut next = move || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            state
+        };
+        let f = Fixture::new(false);
+        let mut statuses = [0; 2];
+        for _ in 0..2000 {
+            let before = f.image();
+            let seen_before = f.seen().len();
+            let near = |n: u64| match n % 4 {
+                0 => n,
+                1 => n % (DISK_SECTORS + 2),
+                2 => u64::MAX - n % 4,
+                _ => DISK_SECTORS - 1 + n % 3,
+            };
+            let sector = near(next());
+            let num_sectors = (near(next()) % 6) as u32;
+            let status = match next() % 3 {
+                0 => {
+                    let len = 512 * (1 + next() % 4) as usize;
+                    f.request(
+                        VIRTIO_BLK_T_OUT,
+                        sector,
+                        Body::Data(vec![next() as u8; len]),
+                    )
+                }
+                1 => f.request(VIRTIO_BLK_T_WRITE_ZEROES, 0, range(sector, num_sectors)),
+                _ => f.request(VIRTIO_BLK_T_DISCARD, 0, range(sector, num_sectors)),
+            };
+            statuses[usize::from(status != OK)] += 1;
+            let after = f.image();
+            let seen = f.seen();
+            let told = &seen[seen_before..];
+            assert!(told.len() <= 1);
+            if status != OK {
+                assert_eq!(after, before);
+            }
+            for (i, (a, b)) in before.iter().zip(&after).enumerate() {
+                if a != b {
+                    let i = i as u64;
+                    assert!(told.iter().any(|(o, l)| *o <= i && i < o + l));
+                }
+            }
+        }
+        assert!(statuses[0] > 200 && statuses[1] > 200, "{statuses:?}");
+    }
+}
