+
+    /// Call `hook(user, offset, len)` before each change the guest makes to the disk.
+    ///
+    /// The hook runs on the device's worker thread before every write, write-zeroes and
+    /// discard, with a byte range already checked to lie inside the disk. No other change to
+    /// the disk happens while it runs, so the range still holds its old bytes: a hook can copy
+    /// them, for example to keep a checkpoint. A return other than 0 fails the request with
+    /// an I/O error and leaves the disk unchanged. Reads and flushes do not call it.
+    ///
+    /// # Safety
+    ///
+    /// `hook` must be a function of the type
+    /// `int32_t (*)(const void *user, uint64_t offset, uint64_t len)`, and `user` must stay
+    /// valid and usable from another thread for as long as the VM runs.
+    pub unsafe fn set_write_hook(
+        &mut self,
+        hook: *const std::ffi::c_void,
+        user: *const std::ffi::c_void,
+    ) -> Result<(), VmmError> {
+        if hook.is_null() {
+            return Err(VmmError::InvalidParam());
+        }
+        let hook = unsafe {
+            std::mem::transmute::<
+                *const std::ffi::c_void,
+                unsafe extern "C" fn(*const std::ffi::c_void, u64, u64) -> i32,
+            >(hook)
+        };
+        self.write_hook = Some(Arc::new(CBlockWriteHook { hook, user }));
+        Ok(())
+    }
 }
 
