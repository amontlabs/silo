+
+/// The C form of a write hook: `hook(user, offset, len)` returns 0 to let the change go on.
+#[cfg(feature = "blk")]
+struct CBlockWriteHook {
+    hook: unsafe extern "C" fn(*const std::ffi::c_void, u64, u64) -> i32,
+    user: *const std::ffi::c_void,
+}
+
+// The caller of `BlockDevice::set_write_hook` promises that `user` may be used from the block
+// worker's thread.
+#[cfg(feature = "blk")]
+unsafe impl Send for CBlockWriteHook {}
+#[cfg(feature = "blk")]
+unsafe impl Sync for CBlockWriteHook {}
+
+#[cfg(feature = "blk")]
+impl devices::virtio::BlockWriteHook for CBlockWriteHook {
+    fn before_write(&self, offset: u64, len: u64) -> std::io::Result<()> {
+        match unsafe { (self.hook)(self.user, offset, len) } {
+            0 => Ok(()),
+            code => Err(std::io::Error::other(format!("write hook returned {code}"))),
+        }
+    }
 }
 
