+// otherOf is the line a kind is counted in once the count is full: its first two words, so
+// "tcp connect 10.0.4.2" becomes "tcp connect, other destinations".
+func otherOf(k string) string {
+	w := strings.Fields(k)
+	if len(w) > 2 {
+		w = w[:2]
+	}
+	return strings.Join(w, " ") + ", other destinations"
+}
