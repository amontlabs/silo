#!/bin/sh
# Stand-in for Codex in the Linux run of test 02: logged in when auth.json exists.
a="$HOME/.codex/auth.json"
case "$1" in
  --version) echo "codex-cli 0.0.0-fake" ;;
  login) if [ -f "$a" ]; then echo "Logged in using ChatGPT"; else echo "Not logged in"; exit 1; fi ;;
  exec) if [ -f "$a" ]; then echo "ok"; else echo "401 Unauthorized"; exit 1; fi ;;
  *) exit 2 ;;
esac
