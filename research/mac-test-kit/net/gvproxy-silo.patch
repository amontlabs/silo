+func (h *dnsHandler) forwardQuestion(m *dns.Msg, q dns.Question) {
+	if h.forward == "none" {
+		m.Rcode = dns.RcodeRefused
+		m.RecursionAvailable = false
+		return
+	}
+	req := new(dns.Msg)
+	req.SetQuestion(q.Name, q.Qtype)
+	req.RecursionDesired = true
+	resp, _, err := h.client.Exchange(req, h.forward)
+	if err != nil || resp == nil {
+		log.Debugf("dns upstream %s: %v", h.forward, err)
+		m.Rcode = dns.RcodeServerFailure
+		return
+	}
+	m.Answer = append(m.Answer, resp.Answer...)
+	m.Ns = append(m.Ns, resp.Ns...)
+	m.Rcode = resp.Rcode
+}
