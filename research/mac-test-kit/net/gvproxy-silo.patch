+// NewWithUpstream is New with the names no zone holds sent to upstream instead of the host's
+// resolver: "" keeps the host's resolver, "none" answers REFUSED, "ip:port" asks that server.
+func NewWithUpstream(udpConn net.PacketConn, tcpLn net.Listener, zones []types.Zone, upstream string) (*Server, error) {
+	s, err := New(udpConn, tcpLn, zones)
+	if err != nil {
+		return nil, err
+	}
+	if upstream != "" && upstream != "none" {
+		if _, _, err := net.SplitHostPort(upstream); err != nil {
+			return nil, fmt.Errorf("dns upstream %q: %w", upstream, err)
+		}
+	}
+	s.handler.forward = upstream
+	return s, nil
+}
