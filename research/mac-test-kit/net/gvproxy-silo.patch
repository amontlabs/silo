diff --git a/cmd/gvproxy/config_test.go b/cmd/gvproxy/config_test.go
index 2fcbf3ac..c03f8aef 100644
--- a/cmd/gvproxy/config_test.go
+++ b/cmd/gvproxy/config_test.go
@@ -743,3 +743,40 @@ stack:
 		},
 	}
 }
+
+func configureArgs(t *testing.T, argv ...string) *GvproxyConfig {
+	t.Helper()
+	var cnf GvproxyConfig
+	var args GvproxyArgs
+	_, err := GvproxyArgParse(flag.NewFlagSet("gvproxy", flag.ContinueOnError), &args, argv)
+	require.NoError(t, err)
+	_, err = GvproxyConfigure(&cnf, &args, "testing")
+	require.NoError(t, err)
+	return &cnf
+}
+
+func TestSealedAndClosed(t *testing.T) {
+	t.Parallel()
+	stock := configureArgs(t)
+	assert.False(t, stock.NoGatewayAPI)
+	assert.Equal(t, map[string]string{"192.168.127.254": "127.0.0.1"}, stock.Stack.NAT)
+	assert.Empty(t, stock.Stack.OutboundDeny)
+
+	sealed := configureArgs(t, "-sealed")
+	assert.True(t, sealed.NoGatewayAPI)
+	assert.Empty(t, sealed.Stack.NAT, "no address may lead to the host's loopback")
+	assert.Empty(t, sealed.Stack.GatewayVirtualIPs)
+	assert.Equal(t, []string{"private", "host"}, sealed.Stack.OutboundDeny)
+	assert.Empty(t, sealed.Stack.DNSUpstream, "a sealed computer still resolves names through the host")
+
+	closed := configureArgs(t, "-closed")
+	assert.True(t, closed.NoGatewayAPI)
+	assert.Empty(t, closed.Stack.NAT)
+	assert.Contains(t, closed.Stack.OutboundDeny, "all")
+	assert.Equal(t, "none", closed.Stack.DNSUpstream)
+
+	handoff := configureArgs(t, "-no-gateway-api", "-outbound-handoff", "/run/silo/boundary.sock", "-dns-upstream", "127.0.0.1:5353")
+	assert.Equal(t, "/run/silo/boundary.sock", handoff.Stack.OutboundHandoff)
+	assert.Equal(t, "127.0.0.1:5353", handoff.Stack.DNSUpstream)
+	assert.Equal(t, map[string]string{"192.168.127.254": "127.0.0.1"}, handoff.Stack.NAT, "-no-host-loopback is its own choice")
+}
