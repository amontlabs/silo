+/// Red-team patch: why a request head is refused, or null when it is one the boundary and any
+/// conforming host read the same way.
+fn strictProblem(h: *const Head, sni: []const u8) ?[]const u8 {
+    if (h.bad_line) return "header name with whitespace, or a line without a colon";
+    if (h.cl_count > 1) return "two Content-Length headers";
+    if (h.te_count > 1 or !h.te_exact) return "Transfer-Encoding other than one plain chunked";
+    if (h.cl_count > 0 and h.te_count > 0) return "both Content-Length and Transfer-Encoding";
+    if (h.host_count != 1) return "not exactly one Host header";
+    var host = h.host;
+    if (std.mem.endsWith(u8, host, ":443")) host = host[0 .. host.len - 4];
+    if (!std.ascii.eqlIgnoreCase(host, sni)) return "Host differs from the name in the handshake";
+    if (h.encoding == .other) return "a body encoding the boundary cannot read";
+    return null;
+}
