{
  "name": "silo-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "build:vercel": "npm run build && node scripts/prepare-vercel.mjs",
    "workshop:dev": "node scripts/workshop-dev.mjs",
    "load-check": "node scripts/load-check.mjs",
    "motion-sheet": "node scripts/motion-sheet.mjs",
    "film-check": "node scripts/film-check.mjs",
    "film-seams": "node scripts/film-seams.mjs",
    "reload-check": "node scripts/reload-check.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
