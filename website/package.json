    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
